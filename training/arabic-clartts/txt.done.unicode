( clartts_0000 "لِأَنَّهُ لَا يَرَى أَنَّهُ عَلَى السَّفَهِ ثُمَّ مِنْ بَعْدِ ذَلِكَ حَدِيثٌ مُنْتَشِرٌ" )
( clartts_0001 "الْعُمْرُ يَنْقُصُ وَالذُّنُوبُ تَزِيدُ" )
( clartts_0002 "قَلِيلَةً بَيْنَ الْمُكْثِرِينَ فَإِنَّ النَّاسَ" )
( clartts_0003 "إلَّا تَفَضُّلَا وَمِنْهَا الْعَقْلُ الَّذِي يَسْتَقْبِحُ بِهِ مِنْ نَتَائِجِ الْحَسَدِ" )
( clartts_0004 "إلَّا مَثَلٌ مَرْذُولٌ وَتَشْبِيهٌ مَعْلُولٌ" )
( clartts_0005 "مَا أَعْظَمُ الْمَصَائِبِ عِنْدَكُمْ فَقَالَ" )
( clartts_0006 "وَكَوَاهِبٍ مَنْ أَقْرَضَا رِقًّ الدَّيْنُ أَسْهَلُ مِنْ رِقِّ الْإِفْضَالِ" )
( clartts_0007 "فَدَارِهِ وَامْزَحْ لَهُ إنَّ الْمِزَاحَ" )
( clartts_0008 "يَا رَسُولَ اللَّهِ إنَّا نَزَلْنَا دَارًا فَكَثُرَ فِيهَا عَدَدُنَا" )
( clartts_0009 "وَإِنْ حَضَرَ الْمَصِيفُ فَأَنْتَ ظِلُّ" )
( clartts_0010 "خَطَبَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى نَاقَتِهِ الْجَدْعَاءِ فَقَالَ" )
( clartts_0011 "وَالسَّابِعُ اخْتِيَارُ خُلَفَائِهِ فِي الْأُمُورِ" )
( clartts_0012 "فَقَدْ قَالَ الْمَرْزُبَانُ لِعُمَرَ حِينَ رَآهُ وَقَدْ نَامَ" )
( clartts_0013 "الْمُصَاهَرَةُ وَأَمَّا الْمُصَاهَرَةُ وَهِيَ الثَّالِثُ مِنْ أَسْبَابِ الْأُلْفَةِ" )
( clartts_0014 "يُعَافَ وَكَمْ قَلِيلٍ مُسْتَطَابِ فَمَا اللُّجَجُ الْمِلَاحُ" )
( clartts_0015 "فَقَابَلَ عَلَى الْجَفْوَةِ وَعَاقَبَ عَلَى الْهَفْوَةِ وَاطَّرَحَ سَالِفَ الْحُقُوقِ وَقَابَلَ الْعُقُوقَ بِالْعُقُوقِ" )
( clartts_0016 "وَأَمَّا صِحَّةُ الْمَعَانِي فَتَكُونُ مِنْ ثَلَاثَةِ أَوْجُهٍ" )
( clartts_0017 "وَقَالَ بَعْضُ السَّلَفِ الْحَسَدُ أَوَّلُ ذَنْبٍ عُصِيَ اللَّهُ بِهِ فِي السَّمَاءِ" )
( clartts_0018 "فَهُوَ مَا كَانَ مَحْمُولًا عَلَى حَالٍ لَا يَجُوزُ فِي الْعَقْلِ أَنْ يَكُونَ بِخِلَافِهَا" )
( clartts_0019 "لِلْخِلْقَةِ وَيَجْتَنِبُونَ نِكَاحَ الْأَهْلِ وَالْأَقَارِبِ" )
( clartts_0020 "يَكُونُ الْمَنْعُ أَرْضَى مِنْهُ خُسْرَانُ مُبِينٌ الْبَذْلُ وَالْعَطَاءُ عَنْ سُؤَالٍ وَطَلَب" )
( clartts_0021 "يَنْبَغِي لِعَقْدِهَا أَحَدُ خَمْسَةِ أَوْجُهٍ" )
( clartts_0022 "رَضِيَ اللَّهُ عَنْهُ إنَّ اللَّهَ تَعَالَى إذَا أَحَبَّ عِبَادًا" )
( clartts_0023 "فَلِمُسْتَحْكَمِ سُئِلَ الْأَحْنَفُ بْنُ قَيْسٍ عَنْ الْمُرُوءَةِ فَقَالَ صِدْقُ اللِّسَانِ" )
( clartts_0024 "نَالَ الشَّرَفَ وَمَنْ بَرِئَ مِنْ الْكِبْرِ نَالَ الْكَرَامَةَ" )
( clartts_0025 "لَأَنْ يَضَعَنِي الصِّدْقُ وَقَلَّمَا يَضَعُ أَحَبُّ إلَيَّ مِنْ أَنْ يَرْفَعَنِي الْكَذِبُ" )
( clartts_0026 "قَالَذُكِرَ عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلٌ" )
( clartts_0027 "تُرْبَتُهَا عَنْ الْمَاءِ الْمُخْرِجِ ثَمَرَتُهَا وَقَالَ بَعْضُ الْحُكَمَاء" )
( clartts_0028 "وَأَنْفَقَ مِنْ مَالِ كَسْبِهِ مِنْ غَيْرِ مَعْصِيَةٍ" )
( clartts_0029 "وَقَالَ بَعْضُ الْبُلَغَاءِ السُّلْطَان السُّوء يُخِيف الْبَرِيء" )
( clartts_0030 "وَكَأَنَّ الْحَقَّ فِيهَا عَلَى غَيْرِنَا وَجَبَ وَكَأَنَّ الَّذِينَ" )
( clartts_0031 "الْإِمَامُ الْجَائِرُ خَيْرٌ مِنْ الْفِتْنَةِ وَكُلٌّ" )
( clartts_0032 "وَلَا تَمُوتُوا جُهَّالًا وَرَوَى سُلَيْمَانُ بْنُ يَسَارٍ عَنْ أَبِي هُرَيْرَةَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ" )
( clartts_0033 "الْبِزَّةِ وَقَالَ بَعْضُ الشُّعَرَاءِ يُدَنِّسُ عِرْضَهُ" )
( clartts_0034 "فَالْعَدْوَى مَا يَظُنُّهُ النَّاسُ مِنْ تَعَدِّي الْعِلَلِ وَالْأَمْرَاضِ" )
( clartts_0035 "الْمُهَذَّبَ فِي الدُّنْيَا وَلَسْتَ الْمُهَذَّبَا وَقَالَ بَعْضُ الشُّعَرَاءِ" )
( clartts_0036 "صَلَاحِ الدُّنْيَا بِشَيْئَيْن وَاعْلَمْ أَنَّ صَلَاحَ الدُّنْيَا مُعْتَبَرٌ مِنْ وَجْهَيْنِ" )
( clartts_0037 "وَأَبْلَغَ دَوَاعِي نَشْرِهِ لِمَا جُبِلَتْ عَلَيْهِ النُّفُوسُ" )
( clartts_0038 "فَلَا يَرْضَى لِنَفْسِهِ إلَّا بِتَعْجِيلِ الْحَقِّ وَإِسْلَافِ الشُّكْرِ" )
( clartts_0039 "مِنْ الرَّزَايَا وَكُفِيَ مِنْ الْحَوَادِثِ مَا هُوَ أَعْظَمُ مِنْ رَزِيَّتِهِ وَأَشَدُّ" )
( clartts_0040 "مِنْهُ قَبْلَهَا وَهَذَا صَحِيحٌ لِأَنَّ النَّدَمَ عَلَى الذُّنُوبِ" )
( clartts_0041 "إيَّاكَ وَعِزَّةُ الْغَضَبِ فَإِنَّهَا تُفْضِي إلَى ذُلِّ الْعُذْرِ" )
( clartts_0042 "وَقَالَ الْحَسَنُ الْبَصْرِيُّ رَحِمَهُ اللَّهُ تَعَالَى لَا تَحْمِلَنَّ عَلَى يَوْمِك هَمَّ غَدِك" )
( clartts_0043 "أَيُّ مَاءٍ لِحُرِّ وَجْهِك يَبْقَىبَيْنَ ذُلِّ الْهَوَى" )
( clartts_0044 "فَيَهْتِكَ اللَّهُ سِتْرًا مِنْ مَسَاوِيكَا وَاذْكُرْ مَحَاسِنَ مَا فِيهِمْ إذَا ذُكِرُوا" )
( clartts_0045 "ثِيَابَ الْقُطْنِ وَالْكَتَّانِ وَالصُّوفِ وَبِقَوْلِهِ" )
( clartts_0046 "وَأَحَقُّ مَنْ كَانَ لِلْكِبْرِ مُجَانِبًا وَلِلْإِعْجَابِ مُبَايِنًا" )
( clartts_0047 "عَنْ عَكَّافِ بْنِ رِفَاعَةَ الْهِلَالِيِّ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ" )
( clartts_0048 "وَمَعْنَى قَوْلِهِ يَنْزَغَنَّكَ أَيْ يُغْضِبَنَّكَ" )
( clartts_0049 "إنْ لَمْ يَغْفِرْ اللَّهُ لَهُ فَأَخَذَ هَذَا الْمَعْنَى مَحْمُودٌ الْوَرَّاقُ فَقَالَ" )
( clartts_0050 "وَلَوْ قَصُرْت الْآمَالُ مَا تَجَاوَزَ الْوَاحِدُ حَاجَةَ يَوْمِهِ" )
( clartts_0051 "سَتْرُ الْعَوْرَةِ وَجَبَ بِالْعَقْلِ و بِالشَّرْعِ وَأَمَّا سَتْرُ الْعَوْرَةِ فَقَدْ اخْتَلَفَ النَّاسُ فِيهِ هَلْ وَجَبَ بِالْعَقْلِ أَوْ بِالشَّرْعِ" )
( clartts_0052 "رَجُلًا تُنُقِّصَ وَاسْتُخِفَّ بِشَانِهِ" )
( clartts_0053 "وَوَاصَلَ تَأْدِيبَهَا وَحَفِظَ تَهْذِيبَهَا" )
( clartts_0054 "قَالَ تَرَكْتُ الْحَسَدَ فَبَقِيتُ إنِّي لَأَحْسُدُك عَلَى مَا أَرَى مِنْ صَبْرِك عَلَى الْخُصُومِ" )
( clartts_0055 "وَرَوَى سُفْيَانُ أَنَّ الْخَضِرَ قَالَ لِمُوسَى عَلَيْهِمَا السَّلَامُ" )
( clartts_0056 "يُظْهِرُهَا سُوءُ وَلِآخَرِينَ فَضَائِلَ مَحْمُودَةً" )
( clartts_0057 "وَاضِعُ الْعِلْمِ فِي غَيْرِ أَهْلِهِ وَقَالَ عِيسَى ابْنُ مَرْيَمَ" )
( clartts_0058 "لَا يُوَلِّيك نِعْمَةً تُوجِبُ الشُّكْرَ إذَا وَصَلَهَا قَبْلَ شُكْرِ مَا سَلَفَ" )
( clartts_0059 "فَهَذَا فَرْقٌ مَا بَيْنَ الْحُزْنِ وَالْغَضَبِ ذِكْرُ اللَّهِ" )
( clartts_0060 "السَّلُولِيِّ وَكَانَ هُوَ الَّذِي قَتَلَ أَخَاهُ زَيْدًا" )
( clartts_0061 "لَيْسَ لِي مِنْ فَضِيلَةِ الْعِلْمِ إلَّا عِلْمِي بِأَنِّي لَسْت" )
( clartts_0062 "شَمَخَ بِأَنْفِهِ وَظَنَّ أَنَّهُ نَالَهُ وَمَنْ نَالَ الشِّبْرَ الثَّانِيَ" )
( clartts_0063 "وَكُنْ لَنَا مِنْ الزَّمَانِ جُنَّهْ أُقْسِمُ بِاَللَّهِ" )
( clartts_0064 "وَلَا عِلْمٍ لَيْسَ فِيهِ تَفَهُّمٌ وَلَا قِرَاءَةٍ لَيْسَ فِيهَا تَدَبُّرٌ" )
( clartts_0065 "عِنْدَ الْمُنَازَعَةِ حَتَّى لَا تَطْمَحَ لَهُ عَيْنٌ لِرِيبَةٍ" )
( clartts_0066 "زِيَادَتُهُ أَوْ نَقْصُهُ فِي التَّكَلُّمِ لِسَانُ الْفَتَى نِصْفٌ وَنِصْفٌ" )
( clartts_0067 "وَلَا صَرَفَ عَنْهَا مَا تَكْرَهُ إذَا كَانَ رُشْدًا" )
( clartts_0068 "زَهْرَتُهُ كَمَا لَا تَسْتَغْنِي الْأَرْضُ وَإِنْ عَذُبَتْ" )
( clartts_0069 "وَثَمَرَتُهَا سُوءُ الْجَزَاءِ وَقَدْ يُفْضِي الرِّيَاءُ بِصَاحِبِهِ إلَى اسْتِهْزَاءِ النَّاسِ بِهِ كَمَا حُكِيَ أَنَّ طَاهِرَ" )
( clartts_0070 "فَمَنْ أَطَاعَ اللَّهَ عَزَّ وَجَلَّ زَالَ فَقْرُهُ" )
( clartts_0071 "رَجَعَ إلَى قَلْبِهِ فَإِنْ كَانَ لَهُ تَكَلَّمَ وَإِنْ كَانَ عَلَيْهِ أَمْسَكَ" )
( clartts_0072 "يَفْرَحُ بِالشَّيْءِ الْقَلِيلِ بَقَاؤُهُ وَيَجْزَعُ مِمَّا" )
( clartts_0073 "التَّقْصِيرُ عَنْ طَلَبِ الْكِفَايَة أَنْ يُقَصِّرَ عَنْ طَلَبِ كِفَايَتِهِ" )
( clartts_0074 "وَمِنْهَا أَنْ يَتَذَكَّرَ مَا يَئُولُ إلَيْهِ الْغَضَبُ مِنْ النَّدَمِ" )
( clartts_0075 "تَهْوِي بِهِ الرِّجْلُ وَهَذَا وَإِنْ دَخَلَ فِي أَقْسَامِ الْعَطَاءِ" )
( clartts_0076 "إنْ رَدَدْته وَلَيْسَ كُلُّ مَنْ صَارَ أَسِيرَ حَقِّك" )
( clartts_0077 "فَإِنْ كَانَ بِالْخَالِقِ كَانَ شَكًّا يَئُولُ إلَى" )
( clartts_0078 "بَلَّغَنِي قَتْلَ أَرْبَعَةٍ فَتَقَرَّبْتُ إلَيْهِ بِدِمَائِهِمْ" )
( clartts_0079 "طُعْمٌ وَالْإِنْجَازَ طَعَامٌ وَلَيْسَ مَنْ فَاجَأَهُ الطَّعَامُ" )
( clartts_0080 "وَفَسَادُ صَلَاحٍ شَامِلٍ وَقَالَ إبرويس" )
( clartts_0081 "وَقَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ كَرَّمَ اللَّهُ وَجْهَهُ لَا تَعْمَلْ شَيْئًا مِنْ الْخَيْرِ رِيَاءً" )
( clartts_0082 "عَنْ ابْنٍ الْحَمْدُ لِلَّهِ الَّذِي نَجَّاهُ مِمَّا هَهُنَا مِنْ الْكَدَرِ" )
( clartts_0083 "لِأَقَلِّهِ مِنْ الْمَعْرُوفِ مَا لَا" )
( clartts_0084 "وَقَالَ عَبْدُ اللَّهِ بْنُ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُمَا إذَا تَرَكَ الْعَالِمُ قَوْلَ لَا أَدْرِي" )
( clartts_0085 "وَبِنَفْلٍ مَنَعَ فَرْضًا وَإِمَّا أَنْ يَعْجَزَ عَنْ اسْتِدَامَةِ الزِّيَادَةِ" )
( clartts_0086 "وَادِعًا غَيْرَ مُنْكِرٍ وَلَا مُسْتَفَزٍّ" )
( clartts_0087 "وَقَالَ بَعْضُ الشُّعَرَاءِ أَصْفِ ضَمِيرًا لِمَنْ تُعَاشِرُهُ" )
( clartts_0088 "وَالصَّمْتُ فَمَنْ كَانَ مَنْطِقُهُ فِي غَيْرِ ذِكْرٍ" )
( clartts_0089 "أَنْ يَكُونَ السَّائِلُ مُسْتَوْجِبًا وَالْمَسْئُولُ غَيْرَ مُتَمَكِّنٍ" )
( clartts_0090 "آخِرَ الْأَمْرِ مِنْ وَرَاءِ الْمَغِيبِ لَوْذَعِيٌّ" )
( clartts_0091 "وَلْيَحْذَرْ أَنْ يَسْتَرْسِلَ فِي مُمَازَحَةِ عَدُوٍّ" )
( clartts_0092 "قَالَ اللَّهُ تَعَالَى يَرْفَعُ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَاَلَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ" )
( clartts_0093 "طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَى كُلِّ مُسْلِمٍ وَفِيهِ تَأْوِيلَانِ" )
( clartts_0094 "أَأَشْقَى بِهِ غَرْسًا وَأَجْنِيهِ ذِلَّةًإذًا فَاتِّبَاعُ الْجَهْلِ قَدْ كَانَ أَحْزَمَا" )
( clartts_0095 "وَقَدَّمَ التَّنَصُّلَ قَبْلَ إنَابَتِهِ فَالْعُذْرُ تَوْبَةٌ وَالتَّنَصُّلُ إنَابَةٌ" )
( clartts_0096 "في مَالِك أَنْ تَضَعَهُ فِي حَقِّهِ وَأَنْ تُؤْتِيَهُ لِمُسْتَحِقِّهِ" )
( clartts_0097 "وَصَدَّقَ بِالْحُسْنَى فَسَنُيَسِّرُهُ لِلْيُسْرَى" )
( clartts_0098 "وَاللَّئِيمُ كَفُورٌ أَوْ مَكْفُورْ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_0099 "أَفْضَلُ الزُّهْدِ إخْفَاءُ الزُّهْدِ نِهَايَةُ الْمَقْطَعِ" )
( clartts_0100 "ثُمَّ لَعَلَّهُ لَا يَفْطِنُ لِشَأْنِهِ" )
( clartts_0101 "أَنَّ مِمَّا تُعَجِّلُ عُقُوبَةً" )
( clartts_0102 "فَأَمَّا الْعِفَّةُ فَنَوْعَانِ أَحَدُهُمَا الْعِفَّةُ عَنْ الْمَحَارِمِ" )
( clartts_0103 "مُسْبِلٌ كَمَا قَالَ حِينَ شَكَا الضِّفْدَعُ كَلَامِي" )
( clartts_0104 "وَقَالَ بَعْضُ الْعُلَمَاءِ مِنْ أَعْوَذِ مَا يَتَكَلَّمُ بِهِ الْعَاقِلُ" )
( clartts_0105 "كُلِّ فَرِيضَةٍ نَفْلًا وَجَعَلَ لَهَمْ مِنْ الثَّوَابِ قِسْطًا" )
( clartts_0106 "وَقَدْ قَالَ الشَّاعِرُ وَمَنْ ذَا الَّذِي تُرْضَى سَجَايَاهُ كُلُّهَا" )
( clartts_0107 "أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ شَرُّ مَا أُعْطِيَ الْعَبْدُ" )
( clartts_0108 "الطَّلَبِ مِنْ مَنَّ هُوَ لِلسُّؤَال أَهْل وَالرَّابِعُ أَنْ يَعْتَمِدَ عَلَى سُؤَالِ مَنْ كَانَ لِلْمَسْأَلَةِ أَهْلًا" )
( clartts_0109 "أَفْدِ طَبْعَك الْمَكْدُودَ بِالْجِدِّ رَاحَةً يُجَمُّ" )
( clartts_0110 "وَقَالَ بَزَرْجَمْهَر الشَّغْلُ مَجْهَدَةٌ" )
( clartts_0111 "وَرَوَتْ أَسْمَاءُ بِنْتُ يَزِيدَ قَالَتْ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0112 "بَيْنَ عَيْنَيْك وَأَنْتَ وَاقِفٌ هَهُنَا فَقَالَ إنَّهُ ضُرِبَ عَلَى غَيْرِ السِّكَّةِ" )
( clartts_0113 "وَقَالَ بَعْضُ الْفُصَحَاءِ مَا لَمْ تُغَيِّبْهُ الْأَضَالِعُ" )
( clartts_0114 "وَلَا تَجْعَلْ الشُّورَى عَلَيْك غَضَاضَةً فَإِنَّ الْخَوَافِيَ" )
( clartts_0115 "لِأَنَّ الْمُكَافِئَ أَعَذْرُ وَإِنْ كَانَ الصَّفْحُ أَجْمَلَ" )
( clartts_0116 "فَأَمَّا أَنْ يَكُونَ الصَّغِيرُ أَضْبَطَ مِنْ الْكَبِيرِ" )
( clartts_0117 "وَقَالَ أَبُو عُثْمَانَ الْجَاحِظُ لِلْكَلَامِ غَايَةٌ وَلِنَشَاطِ السَّامِعِينَ نِهَايَةٌ" )
( clartts_0118 "وَقَالَ بَعْضُ الْحُكَمَاءِ مِنْ الْعِلْمِ أَنْ لَا تَتَكَلَّمَ فِيمَا لَا تَعْلَمُ" )
( clartts_0119 "فَأَمَّا السِّعَايَةُ فَهِيَ شَرُّ الثَّلَاثَةِ لِأَنَّهَا تَجْمَعُ إلَى مَذَمَّةِ الْغِيبَةِ" )
( clartts_0120 "مَا ذُكِرَ أَنَّهُ لِعَلِيٍّ رَضِيَ اللَّهُ عَنْهُ فَلَوْ كُنَّا إِذَا مُتَنَا تَرَكْنا" )
( clartts_0121 "مَا شَأْنُك فَقَالَتْ أَخْبَرَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّ فِي عَيْنَيْك بَيَاضًا" )
( clartts_0122 "طُوبَى لِمَنْ شَغَلَهُ عَيْبُهُ عَنْ عَيْبِ غَيْرِهِ" )
( clartts_0123 "قَالَ لَا تَغْضَبْ الْعَاقِلُ يَصُدُّ غَضَبَهُ بِحِلْمِهِ" )
( clartts_0124 "إجَابَةً مِنْهَا إلَى الْحَجِّ فَكَانَ فِي إيجَابِهَا" )
( clartts_0125 "وَسِنُّ أَبِيهِ مَا بَيْنَ الثَّلَاثِينَ وَالْخَمْسِينَ" )
( clartts_0126 "أَنْتَ حَبَسْت نَفْسَك حَيْثُ قُلْت رَبِّ السِّجْنُ أَحَبُّ إلَيَّ" )
( clartts_0127 "إصْغَاءٌ لِنُصْحٍ وَلَا قَبُولٌ لِتَأْدِيبٍ" )
( clartts_0128 "دَارًا فَذَاكَ وَإِنْ كَانَ حِمَارًا فَبَخٍ بَخٍ" )
( clartts_0129 "الرُّؤْيَةُ قَبْلَ الْعَمَلِ فَأَمَّا مَا يَرُومُهُ مِنْ أَعْمَالِهِ" )
( clartts_0130 "الْاِشْتِغَالُ بِالْإكْتِسَابِ لَا يَمْنَعٌ مِنْ طَلَبَ الْعِلْمِ" )
( clartts_0131 "وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0132 "اسْتِوَاءُ السَّرِيرَةِ وَالْعَلَانِيَةِ فِي الْعَمَلِ لِلَّهِ تَعَالَى" )
( clartts_0133 "وَأَصْلُ كُلِّ فَسَادٍ مِنْ أَسْبَابِ الْكَذِبِ أَنْ يَكُونَ حَدِيثُهُ مُسْتَعْذَبًا" )
( clartts_0134 "وَإِجْمَالُ غَيْرَ الْمُعِين وَأَمَّا مَنْ يَسْتَعِينُ وَلَا يُعِينُ" )
( clartts_0135 "إِذَا فَسَدَ يُعَظَّمُ فِي الدُّنْيَا بِفَضْلِ صَلَاحِهِ" )
( clartts_0136 "قَالَ دَفْعُ صَنِيعَةٍ بِأَيْسَرِ مُؤْنَةٍ وَاكْتِسَابُ إخْوَانٍ" )
( clartts_0137 "فَقَالَ لَقَدْ كَلَّفْتُمْ اللَّهَ شَطَطًا" )
( clartts_0138 "وَأُمُورُهَا عَلَى مَمَرِّ الدُّهُورِ مُنْتَظِمَةً" )
( clartts_0139 "فَإِنَّ ذَلِكَ عِمَادُ كُلِّ صَلَاحٍ وَبَابُ" )
( clartts_0140 "مَا أَنْعَمَ اللَّهُ عَلَى عَبْدٍ نِعْمَةً إلَّا وَعَلَيْهِ فِيهَا" )
( clartts_0141 "وَالْهَفَوَاتُ نَوْعَانِ صَغَائِرُ وَكَبَائِرُ فَالصَّغَائِرُ مَغْفُورَةٌ" )
( clartts_0142 "رَضِيَ اللَّهُ عَنْهُ الِاسْتِشَارَةُ عَيْنُ الْهِدَايَةِ" )
( clartts_0143 "السَّخَاءُ سَخَاءَانِ أَشْرَفُهُمَا سَخَاؤُك عَمَّا بِيَدِ غَيْرِك" )
( clartts_0144 "خِلَافًا وَلَا مِنْ عَامِلٍ غَيْرِ عَالِمٍ" )
( clartts_0145 "وَفَاقَةً يَتَمَكَّنُ مِنْ إزَالَتِهَا فَلَا يَدَعْهُ الْكَرَمُ وَالتَّدَيُّنُ" )
( clartts_0146 "وَدَعَتْ الْحَاجَةُ فِيمَا هُوَ أَوْلَى الْأَمْرَيْنِ أَنْ يَكُونَ" )
( clartts_0147 "أَنَّهُ كَانَ جَاهِلًا وَالْجَاهِلُ لَا يَعْرِفُ الْعَالِمَ" )
( clartts_0148 "لِسَانُ الْعَاقِلِ مِنْ وَرَاءِ قَلْبِهِ فَإِذَا أَرَادَ الْكَلَامَ" )
( clartts_0149 "وَقِيلَ فِي مَنْثُورِ الْحِكَمِ الْمَالُ مَلُولٌ وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_0150 "أَشَدُّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ مَنْ يَرَى أَنَّ فِيهِ خَيْرًا وَلَا خَيْرَ فِيهِ" )
( clartts_0151 "وَأَرْذَلُهَا صِنَاعَةُ الْعَمَلِ لِأَنَّ الْعَمَلَ نَتِيجَةُ الْفِكْرِ" )
( clartts_0152 "كَثِيرًا مَا يَتَمَثَّلُ بِهَذِهِ الْأَبْيَاتِ الْمَالُ" )
( clartts_0153 "بْنِ أَبِي طَالِبٍ رَضِيَ اللَّهُ عَنْهُ أَنَّهُ قَالَ مَنْ أَرَادَ الْبَقَاءَ" )
( clartts_0154 "هَمَمْت بِفِعْلِهَا فَلَمْ تَسْتَحِ مِنْهَا لِحُسْنِهَا وَجَمَالِهَا" )
( clartts_0155 "نَوْمُ خَرَقٍ وَهِيَ الصُّبْحَةُ وَنَوْمُ خَلَقٍ وَهِيَ الْقَائِلَةُ وَنَوْمُ حُمْقٍ وَهُوَ الْعَشِيُّ" )
( clartts_0156 "عَلَيْهِ مَنْ سِوَاهُ وَأَمَّا الْمُعْطِي فَإِنَّهُ وَجَدَ ذَلِكَ اتِّفَاقًا" )
( clartts_0157 "زورو الْمَوْقِع لربّري بُوكْس نُقْطَة" )
( clartts_0158 "فَقَالَ كَيْفَ يَرْضَى عَنِّي وَلَمْ أُرْضِهِ بَعْضُ النَّاسِ يَسْتَجِيبُ لِفِعْلِ الطَّاعَاتِ لَكِنَهُ يَرْتِكَبِ الْمَعَاصِي" )
( clartts_0159 "يُسْرِفُ مَعَ الْقَبُولِ وَيَكُفُّ مَعَ الْإِبَاءِ" )
( clartts_0160 "إلَّا مَنَنْتَ بِعَفْوٍ مَا لَهُ سَبَبُ وَإِنْ" )
( clartts_0161 "فَذَهَبَ بَعْضُ الْمُتَكَلِّمِينَ إلَى وُجُوبِ ذَلِكَ بِالْعَقْلِ" )
( clartts_0162 "فَمَنْ يَكُنْ عَنْ كِرَامِ النَّاسِ يَسْأَلُنِي فَأَكْرَمُ النَّاسِ" )
( clartts_0163 "وَمَعَ انْتِفَاءِ التَّشَاكُلِ يُعْدَمُ الِائْتِلَافُ فَثَبَتَ أَنَّ التَّجَانُسَ" )
( clartts_0164 "تَارِكٍ وَلَا مُتَجَاوِزٍ فَوُقُوفُ الْمَرَضِ أَحَدُ البرأين" )
( clartts_0165 "وَرُوِيَ فَاقْتُلُوا الْأَخِيرِ مِنْهُمَا وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0166 "رَوَى مَرْوَانُ بْنُ سَالِمٍ عَنْ إسْمَاعِيلَ" )
( clartts_0167 "لَسْت تَنْفَكُّ طَالِبًا لِوِصَالٍ مِنْ حَبِيبٍ أَوْ طَالِبًا لِنَوَالِ" )
( clartts_0168 "فَإِذَا عَجَزْت عَنْ الْخُطُوبِ فَمَنْ لَهَا إنَّ الَّذِي عَقَدَ الَّذِي انْعَقَدَتْ لَهُ" )
( clartts_0169 "الْمِزَاح الْمُسْتَحْسَن وَقَدْ كَانَ صُهَيْبُ بْنُ سِنَانٍ مَزَّاحًا فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0170 "وَالْمُنْكَرِ الْقَبَائِحَ وَالْبَغْيِ الْكِبْرَ" )
( clartts_0171 "مَنْ أَصْبَحَ وَلَمْ يَنْوِ ظُلْمَ أَحَدٍ غَفَرَ اللَّهُ لَهُ" )
( clartts_0172 "وَنَذِيرَ عِظَةٍ تَذَلَّلَ بِهَمَا قِيَادُ النَّفْسِ" )
( clartts_0173 "أَنَفَةً وَيَقْهَرُهَا حَمِيَّةً فَتُذْعِنُ لِرُشْدِهَا" )
( clartts_0174 "فَبِحَسَبِ مَا هُمْ عَلَيْهِ تَكُونُ أَمْثَالُهُمْ فَلِهَاتَيْنِ الْعِلَّتَيْنِ وَقَعَ الْفَرْقُ بَيْنَ أَمْثَالِ الْخَاصَّةِ" )
( clartts_0175 "حَتَّى لَقَدْ أَمَرَ اللَّهُ بِالِاسْتِعَاذَةِ مِنْ شَرِّهِ فَقَالَ تَعَالَى" )
( clartts_0176 "وَتَفَضُّلُهُ فِيمَا كَفَ كَفَّنَا عَنْهُ" )
( clartts_0177 "فَبَلَّغَهُمْ رِسَالَتَهُ وَأَلْزَمَهُمْ حُجَّتَهُ" )
( clartts_0178 "الْعِلْمُ وَالْمُلُوكُ وَرَوَى أَنَسُ بْنُ مَالِكٍ" )
( clartts_0179 "فَصَارَتْ أَسْبَابُ الْمَوَادِّ الْمَأْلُوفَةِ وَجِهَاتُ الْمَكَاسِبِ الْمَعْرُوفَةِ" )
( clartts_0180 "صَاحِبِ الدِّينِ الدِّينُ الْوَاقِفُ بِصَاحِبِهِ عَلَى الْخَيْرَاتِ" )
( clartts_0181 "وَلَيْسَ لَنَا رِزْقٌ وَلَا عِنْدَنَا فَضْلُ فَإِنْ تَعْتَذِرْ بِالشَّغْلِ عَنَّا فَإِنَّمَا" )
( clartts_0182 "شَرُّ مِزَاحِ الْمَرْءِ لَا يُقَالُ وَخَيْرُهُ يَا صَاحِ لَا يُنَالُ" )
( clartts_0183 "وَلَا زَلَلٌ إلَّا بَانَ وَذَهَبَ غَيْرُهُمْ مِنْ أَصْنَافِ الْأُمَمِ" )
( clartts_0184 "مَا التَّقْوَى فَقَالَ أَجَزْتَ فِي أَرْضٍ فِيهَا شَوْكٌ" )
( clartts_0185 "فَاعْفُوا يُعِزُّكُمْ اللَّهُ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_0186 "وَأَجْرُك عِنْدَ اللَّهِ مَذْخُورًا فَقَدْ رَوَى زِيَادُ بْنُ الْجَرَّاحِ" )
( clartts_0187 "الْقُرَظِيِّ عِظْنِي فَقَالَ لَا أَرْضَى نَفْسِي لَك وَاعِظًا" )
( clartts_0188 "اسْتَهَانُوا بِهِ وَقَدْ رَوَى عَبْدُ اللَّهِ بْنُ بُرَيْدَةَ عَنْ أَبِيهِ" )
( clartts_0189 "وَأَنْشَدْ عَنْ الرَّبِيعِ لِلشَّافِعِيِّ رَضِيَ اللَّهُ عَنْهُ لَمَّا عَفَوْتُ" )
( clartts_0190 "لِنَعْلَمَ أَسْبَابَ صَلَاحِهَا وَفَسَادِهَا وَمَوَادَّ عُمْرَانِهَا وَخَرَابِهَا" )
( clartts_0191 "لِبُرُوزِهِ وَالْحَادِثُ عَنْ الْحُزْنِ" )
( clartts_0192 "إلَّا سَيُبْلَى بِظَالِمِ الْأَسْرَار بِالْخِيَانَة" )
( clartts_0193 "وَهُوَ أَنَسُ بْنُ أُسَيْدٍ وَلَا تُفْشِ سِرَّك إلَّا إلَيْك" )
( clartts_0194 "إذَا أَرَادَ اللَّهُ بِقَوْمٍ شَرًّا أَعْطَاهُمْ الْجَدَلَ" )
( clartts_0195 "اللَّهُ يَعْلَمُ أَنِّي لَسْت ذَا بُخْلٍ وَلَسْتُ مُلْتَمِسًا فِي الْبُخْلِ لِي عِلَلَا" )
( clartts_0196 "ثُمَّ بِعَدْلِهِ فِي غَيْرِهِ فَأَمَّا عَدْلُهُ فِي نَفْسِهِ فَيَكُونُ بِحَمْلِهَا عَلَى الْمَصَالِحِ" )
( clartts_0197 "عِلْمُهُ حُجَّةً عَلَى مَنْ أَخَذَ عَنْهُ" )
( clartts_0198 "وَنُطْقِي ذِكْرًا وَنَظَرِي عِبْرَةً وَقَالَ لُقْمَانُ لِابْنِهِ يَا بُنَيَّ لَا تَتْرُكْ صَدِيقَك الْأَوَّلَ فَلَا يَطْمَئِنَّ إلَيْك الثَّانِي" )
( clartts_0199 "الْفَرْقُ بَيْنَ دَوَاعِي الصِّدْقِ وَدَوَاعِي الْكَذِبِ وَلِكُلِّ وَاحِدٍ مِنْهَا دَوَاعٍ" )
( clartts_0200 "وَهَذَا يَكُونُ مِنْ ضَعْفِ النَّفْسِ وَرُبَّمَا أَوْجَبَهُ الرَّأْيُ" )
( clartts_0201 "وَقَدْ قَالَتْ عَائِشَةُ رَضِيَ اللَّهُ عَنْهَا يَا رَسُولَ اللَّهِ" )
( clartts_0202 "وَانْقَطَعَ الرَّجَاءُ وَاشْتَدَّتْ الْحَاجَةُ وَقَعَتْ الْبَغْضَاءُ" )
( clartts_0203 "مِنْ عَلَامَةِ الْحَجَّ الْمَبْرُورَ أَنْ يَكُونَ صَاحِبُهَا بَعْدَهَا خَيْرًا" )
( clartts_0204 "أَبْغَضُكُمْ إلَيَّ الْمُتَفَيْهِقُ الْمِكْثَارُ" )
( clartts_0205 "وَانْتِقَامُ أَهْلِ الْغَوْغَاءِ وَهُوَ مُسْتَسْهَلُ الْكَلَفِ" )
( clartts_0206 "مِنْ أَقْوَالِ الْأُدَبَاء فِي السُّلْطَانِ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_0207 "لِأَنَّ النَّاسَ آلَاتٌ لِلصِّنَاعَاتِ وَأَشْرَفُهُمْ نَفْسًا" )
( clartts_0208 "وَتَأَلُّفَهَا بِالْمُقَارَبَةِ وَالْمُسَاهَلَةِ" )
( clartts_0209 "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0210 "وَدَعَا بِأَبِي الْعَتَاهِيَةِ فَاسْتَحَلَّهُ وَوَهَبَ لَهُ أَلْفَ دِينَارٍ وَأَطْلَقَهُ" )
( clartts_0211 "أَنَّ فِيك خَيْرًا وَقِيلَ لِرَابِعَةَ الْعَدَوِيَّةِ" )
( clartts_0212 "وَهَذَا مِنْ أَجْوِبَةِ الْخَلَاعَةِ الَّتِي يَدْفَعُ بِهَا" )
( clartts_0213 "كَمَا نَهَى عَنْ قَبْضِهَا بُخْلً فَدَلَّ عَلَى اسْتِوَاءِ الْأَمْرَيْنِ ذَمًّا" )
( clartts_0214 "ثُمَّ قَدْ تَقَدَّمَ مِنْ قَوْلِ الْحُكَمَاءِ مَنْ لَمْ يُقَدِّمْ الِامْتِحَانَ قَبْلَ الثِّقَةِ" )
( clartts_0215 "يَسِمَهُمْ بِالْإِدْبَارِ وَيَتَوَسَّمَهُمْ بِالْحِرْمَانِ" )
( clartts_0216 "وَلَا تَعْجَزْ عَنْ الطَّلَبِ لِوَصَبٍ وَلَا نَصَبٍ" )
( clartts_0217 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0218 "زُورُوا الْمَوْقِع ليبريبوكس نُقْطَة أَرِج الْبَاعِثُ عَلَى الطَّمَعِ" )
( clartts_0219 "إيَّاكَ وَالْحَنَّانَةَ وَالْمَنَّانَةَ وَالْأَنَّانَةَ فَالْحَنَّانَةُ الَّتِي تَحِنُّ لِزَوْجٍ كَانَ لَهَا" )
( clartts_0220 "تُرِيقُّونَ مِنِّي مَا اسْتَطَعْتُمْ وَأَعْتِقُ" )
( clartts_0221 "أَقِلْنَا فَكَتَبَ إلَى الْحَجَّاجِ فِيهِمْ فَكَتَبَ إلَيْهِ" )
( clartts_0222 "وَقِيلَ إنَّمَا سُمِّيَ الصَّدِيقُ صَدِيقًا لِصِدْقِهِ" )
( clartts_0223 "لِلْمَزِيدِ مِنَ الْمَعْلُومَاتِ أَوْ لِلْمُشَارَكَةِ زَورُوا المَوْقِعَ لِيَبْرِيفُوكْسَ" )
( clartts_0224 "صَغِيرًا وَيَرْفَعَ حَقِيرًا وَلَيْسَ بِفَاعِلٍ" )
( clartts_0225 "عَلَى ثَلَاثَةِ أَحْوَالٍ مَذْمُومَةٍ إحْدَاهَا" )
( clartts_0226 "غَيْرِهِ وَقَالَ بَعْضُ الْحُكَمَاءِ اصْطَفِ مِنَ الْإِخْوَانِ ذَا الدِّينِ وَالْحَسَبِ وَالرَّأْيِ وَالْأَدَبِ" )
( clartts_0227 "فَلَا تَنْقَطِعُ الرَّهْبَةُ مِنْهُ وَلَا الرَّغْبَةُ فِيهِ" )
( clartts_0228 "أَبُو الْقَاسِمِ الْآمِدِيُّ إذَا كُنْت لَا تَدْرِي وَلَمْ تَكُنْ بِاَلَّذِي يُسَائِلُ مَنْ يَدْرِي فَكَيْفَ إذًا تَدْرِي" )
( clartts_0229 "وَقَالَ عَبْدُ اللَّهِ بْنُ الْمُعْتَزِّ رَحِمَهُ اللَّهُ نَسِيرُ إلَى الْآجَالِ فِي كُلِّ سَاعَةٍ" )
( clartts_0230 "وَقَدْ ذَكَرَ ذَلِكَ أَبُو تَمَّامٍ فِي شَعْرِهِ فَقَالَ" )
( clartts_0231 "مُوَفَّقُ الْعَزِيمَةِ رَوَى عِكْرِمَةُ عَنْ ابْنِ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُ قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0232 "تُبَلِّغُكُمْ الْآخِرَةَ وَذَمَّ رَجُلٌ الدُّنْيَا عِنْدَ عَلِيِّ بْنِ أَبِي طَالِبٍ كَرَّمَ اللَّهُ وَجْهَهُ" )
( clartts_0233 "وَلَا لِلتَّبْذِيرِ مَوْقِعٌ وَقَدْ وَرَدَ الْكِتَابُ بِذَمِّهِمَا" )
( clartts_0234 "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لدُّنْيَا دُوَلٌ" )
( clartts_0235 "نِعْمَةَ اللَّهِ عَلَيْكُمْ الْمُنَى مِنْ بَضَائِعِ النَّوْكَى" )
( clartts_0236 "وَلِكُلِّ وَهْنٍ مِقْدَارٌ مِنْ الْجَهْلِ" )
( clartts_0237 "عَلَيْهِ السَّلَامُ بِالْفَقْرِ فَقَالَ مِنْ الْغِنَى دُهِيتُمْ" )
( clartts_0238 "وَمَنْسُوبٌ إلَيْهِ أَفَاعِيلُ مَنْ صَاحَبَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0239 "فِي قَوْله تَعَالَى وَلَا تَجْهَرْ بِصَلَاتِك وَلَا تُخَافِتْ بِهَا" )
( clartts_0240 "تَنَغَّصَ طِيبُهُ بِصِدْقِ يَقِينِي أَنْ سَيَذْهَبُ" )
( clartts_0241 "فَيَأْسَى وَفِي عُقْبَاهُ يَأْتِي سُرُورُهُ أَلَمْ تَرَ أَنَّ" )
( clartts_0242 "قَالَ الَّذِينَ يُحْيُونَ سُنَّتِي وَيُعَلِّمُونَهَا عِبَادَ اللَّه" )
( clartts_0243 "وَمُعَوِّلٍ عَلَى مُكْنَةٍ زَالَتْ فَأَوْرَثَتْ خَجَلًا" )
( clartts_0244 "وَأَيُّ بِخَيْلٍ لَمْ يَنَلْ سَاعَةَ الْوَفْرِ" )
( clartts_0245 "إيَّاكُمْ وَالِامْتِنَانَ بِالْمَعْرُوفِ فَإِنَّهُ يُبْطِلُ الشُّكْرَ" )
( clartts_0246 "فَصَارُوا سَبَبًا لِمَقْتِهِ وَطَرِيقًا إلَى ذَمِّهِ" )
( clartts_0247 "وَلَيْسَ وَإِنْ تَفَاضَلَتْ الْأَذْهَانُ وَتَفَاوَتَتْ الْفَطِنُ" )
( clartts_0248 "وَقْتِهِ وَقَدْ قَالَتْ الْعَرَبُ فِي أَمْثَالِهَا كَلْبٌ جَوَّالٌ" )
( clartts_0249 "إحْدَاهُمَا أَنَّ الْأَمْثَالَ مِنْ هَوَاجِسِ الْهِمَمِ" )
( clartts_0250 "الْجَهْلُ مَوْتٌ قَبْلَ وَقْتِهِ وَأُنْشِدْتُ لِبَعْضِ أَهْلِ هَذَا الْعَصْرِ" )
( clartts_0251 "لَكُنْتُ أَوَّلَ مَنْ يَنْسَى سَرَائِرَهُ إذَا" )
( clartts_0252 "سَتُنْضِجُهُ فَكُلُّ شَيْءٍ سِوَى التَّقْوَى بِهِ سَمْجٌ" )
( clartts_0253 "عَنْ عُمَرَ بْنِ مَيْمُونٍ أَنَّهُ قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0254 "وَأَمَّا مُعَاطَاةُ الْإِعْرَابِ وَتَجَنُّبُ اللَّحَنِ" )
( clartts_0255 "فِيهِ تَأْوِيلَانِ أَحَدُهُمَا عَلَى الْجِهَادِ" )
( clartts_0256 "فَلَا لَوْمَ مَا لَمْ يَلْجَأْ إلَيْهِ مُضْطَرٌّ لِأَنَّ الْقِيَامَ بِالْكُلِّ" )
( clartts_0257 "بَعْدَ أَنْ لَا تَرَاهَا بِعَيْنِ الرِّضَا وَلَا تَجْرِي فِيهَا عَلَى حُكْمِ الْهَوَى" )
( clartts_0258 "نَفَسٌ دَائِمٌ وَهَمٌّ لَازِمٌ وَقَلْبٌ هَائِمٌ" )
( clartts_0259 "فَلَزِمَتْ النِّعْمَتَانِ وَمَنْ لَزِمَتْهُ النِّعْمَتَانِ" )
( clartts_0260 "وَالْأُمَّةُ الْمُجْتَمِعَةُ حُجَّةٌ عَلَى مَنْ شَذَّ عَنْهَا" )
( clartts_0261 "أَجْرُ الْمُعَلِّمِ كَأَجْرِ الصَّائِمِ الْقَائِمِ وَحَسْبُ مَنْ هَذَا أَجْرُهُ أَنْ يَلْتَمِسَ عَلَيْهِ أَجْرًا" )
( clartts_0262 "وَسُئِلَ الْأَحْنَفُ بْنُ قَيْسٍ عَنْ الْمُرُوءَةِ فَقَالَ الْعِفَّةُ" )
( clartts_0263 "وَقَالَ بَعْضُ الْحُكَمَاءِ مَنْ ذَكَرَ قُدْرَهَ اللَّهِ" )
( clartts_0264 "عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ انَتْ صُحُفُ مُوسَى عَلَى نَبِيِّنَا وَعَلَيْهِ السَّلَامُ" )
( clartts_0265 "وَالصِّدْقُ وَالْكَذِبُ يَدْخُلَانِ الْأَخْبَارَ الْمَاضِيَةَ" )
( clartts_0266 "سَبَبُ الْإِذَاعَةِ وَطَرِيقٌ إلَى الْإِشَاعَةِ لِأَمْرَيْنِ" )
( clartts_0267 "وَالدَّفْعُ عَنْهُ لَازِمٌ عَلَى شُرُوطِهِ ي وُجُودِ أَعْوَانٍ يَصْلُحُونَ لَهُ" )
( clartts_0268 "فِي الِارْتِيَاءِ وَالِاجْتِهَادِ فَإِذَا تَصَفَّحَ أَقَاوِيلَ جَمِيعِهِمْ كَشَفَ عَنْ أُصُولِهَا وَأَسْبَابِهَا" )
( clartts_0269 "وَمِنْهَا الطَّوَارِقُ الْمُزْعِجَةُ وَالْهُمُومُ الْمُذْهِلَةُ" )
( clartts_0270 "كَذَاك عَيْشُ الْفَتَى ضُرُوبُ لَمْ يَمْضِ بُؤْسٌ وَلَا نَعِيمٌ إلَّا وَلِيَ فِيهِمَا نَصِيبُ" )
( clartts_0271 "مَنْ خَدَمَنِي فَاخْدِمِيهِ وَمَنْ خَدَمَك فَاسْتَخْدِمِيهِ" )
( clartts_0272 "وَقَدْ قِيلَ لِبَزَرْجَمْهَرَ مَا لَكُمْ لَا تُعَاتِبُونَ الْجُهَّالَ" )
( clartts_0273 "أَوَّلُهُمَا مَا يَنْتَظِمُ بِهِ أُمُورُ جُمْلَتهَا" )
( clartts_0274 "أَنَّ الْمَلَامَةَ نَفْعُهَا قَلِيلٌ إذَا مَا الشَّيْءُ" )
( clartts_0275 "خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى وَرَوَى زَيْدُ بْنُ عَلِيِّ بْنِ الْحُسَيْنِ عَنْ أَبِيهِ عَنْ جَدِّهِ" )
( clartts_0276 "وَالْبَعِيدُ بِمَوَدَّتِهِ قَرِيبٌ وَقَالَ الشَّاعِرُ" )
( clartts_0277 "أَحَدُهَا الْكَسْبُ قَدْرَ الْكِفَايَةِ وَالْحَاجَة" )
( clartts_0278 "قَالَ الْحَسَنُ مُخْتَلِفِينَ فِي الرِّزْقِ فَهَذَا غَنِيٌّ وَهَذَا فَقِيرٌ" )
( clartts_0279 "فَأَخَذَ هَذَا الْمَعْنَى أَبُو الْعَتَاهِيَةِ فَقَالَ ابْنُ ذِي الِابْنِ كُلَّمَا زَادَ مِنْهُ" )
( clartts_0280 "وَتُقَصِّرْ عَنْ الزِّيَادَةِ فِي السَّعْيِ وَالْعَمَلِ وَقِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_0281 "الْعَطَاءُ لِغَيرِ ماسببٍ أَسْمَى" )
( clartts_0282 "يَا عَبَّاسُ يَا عَمَّ النَّبِيِّ نَفْسٌ تُنْجِيهَا خَيْرٌ مِنْ إمَارَةٍ لَا تُحْصِيهَا" )
( clartts_0283 "فَهُوَ الَّذِي أَنْبَاكَ كَيْفَ نَعِيمُهَا فَالْأَوْلَى بِالْعَاقِلِ أَنْ يَتَذَكَّرَ عِنْدَ مَرَضِهِ وَخَوْفِهِ قَدْرَ النِّعْمَةِ فِيمَا سِوَى ذَلِكَ مِنْ عَافِيَتِهِ وَأَمْنِهِ" )
( clartts_0284 "وَمِنْ آدَابِ الْكَلَامِ عَدَمُ رَفْعِ الصَّوْتِ" )
( clartts_0285 "فَإِنَّ الْمَالَ يُرَادُ لِصِيَانَةِ الْأَعْرَاضِ لَا لِابْتِذَالِهَا" )
( clartts_0286 "الصِّدْقُ الْمَزْمُومُ وَاعْلَمْ أَنَّ مِنْ الصِّدْقِ مَا يَقُومُ مَقَامَ الْكَذِبِ" )
( clartts_0287 "أَمَّا الرَّغْبَةُ فَفِي ثَوَابِ اللَّهِ تَعَالَى لِطَالِبِي مَرْضَاتِهِ" )
( clartts_0288 "فَهَمُّهَا فِي الرَّجُلِ وَرَوَى عَطِيَّةُ بْنُ بِشْرٍ" )
( clartts_0289 "كَثْرَةُ التَّعَاهُدِ وَقَالَ كُشَاجِمُ أَقِلْ ذَا الْوُدِّ عَثَرْتَهُ وَقِفْهُ" )
( clartts_0290 "وَلَا لِاسْتِقَامَتِهَا أَثَرًا لِأَنَّ الْإِنْسَانَ" )
( clartts_0291 "وَبَلْوَى الْمُنَازَعَةِ وَقَدْ حُكِيَ أَنَّ رَجُلًا شَاوَرَ حَكِيمًا فِي التَّزَوُّجِ فَقَالَ لَهُ" )
( clartts_0292 "وَأَشْرَفُهُمَا عَطَاءً وَسُئِلَ عَلِيٌّ كَرَّمَ اللَّهُ وَجْهَهُ عَنْ السَّخَاءِ فَقَالَ" )
( clartts_0293 "لَمْ يَكَدْ يُصَدَّقُ فِي شَيْءٍ وَإِنْ كَانَ صَادِقَا" )
( clartts_0294 "لَحِقَهُ مِنْ الْوَهَنِ فِي نَفْسِهِ وَالِاخْتِلَالِ فِي دِينِهِ" )
( clartts_0295 "فَأَعْمَلَ قُوَّتَهُ فِي طَاعَةِ اللَّهِ تَعَالَى أَوْ كَانَ ضَعِيفًا" )
( clartts_0296 "طَابَتْ لَهُ مَرَقَةٍ كُلُّ وَقَدْ" )
( clartts_0297 "ظَلَمْت أَخًا كَلَّفْته فَوْقَ وُسْعِهِ وَهَلْ كَانَتْ الْأَخْلَاقُ" )
( clartts_0298 "فَهِيَ أَمْنٌ عَامٌّ تَطْمَئِنَّ إلَيْهِ النُّفُوسُ" )
( clartts_0299 "فَإِنَّ اللَّهَ مَا حَرَّمَ شَيْئًا إلَّا وَأَغْنَى عَنْهُ بِمُبَاحٍ مِنْ جِنْسِهِ" )
( clartts_0300 "قَالَ اللَّهُ تَعَالَى نَرْفَعُ دَرَجَاتٍ مَنْ نَشَاءُ" )
( clartts_0301 "فَقَالَ أَلْبَسُ ثَوْبًا أَقِي بِهِ نَفْسِي" )
( clartts_0302 "وَصُهَيْبٌ كَانَ أَطَوْعَ أَطَوْعَ لِلَّهِ سُبْحَانَهُ وَتَعَالَى مِنْ أَنْ يَكُونَ بِهَذِهِ الْمَنْزِلَةِ" )
( clartts_0303 "الْإِنْكَارُ عَلَى الْجَمَاعَةِ الْعَاصِيَةِ وَالْحَالُ الثَّانِيَةُ" )
( clartts_0304 "وَأَوَّلُ ذَنْبٍ عُصِيَ اللَّهُ بِهِ فِي الْأَرْضِ يَعْنِي حَسَدَ" )
( clartts_0305 "وَكَاَلَّذِي حُكِيَ عَنْ أَبِي يُوسُفَ الْفَقِيهِ أَنَّ رَجُلًا كَانَ يَجْلِسُ إلَيْهِ فَيُطِيلُ الصَّمْتَ" )
( clartts_0306 "فَلَمْ يَفِ مَا أَعْطَاهُ الْعِلْمُ بِمَا سَلَبَهُ التَّبَذُّلُ" )
( clartts_0307 "آيةِالسَّخَا وَالسَّبَبُ التَّاسِعُ وَلَيْسَ بِسَبَبٍ أَنْ يَفْعَلَ ذَلِكَ لِغَيْرِ مَا سَبَبٍ" )
( clartts_0308 "وَعَيْنُك تُبْدِي أَنَّ صَدْرَك لِي دَوِي" )
( clartts_0309 "وَيَسْتَقِلُّ عِنْدَ اسْتِقْلَالِهِ فَلَيْسَ لِمِثْلِهِ فِي الْإِخَاءِ حَظٌّ" )
( clartts_0310 "فَاشْكُرْ فَقَدْ نِلْتَ الْمُنَى وَالْوَجْهُ الثَّالِثُ" )
( clartts_0311 "عَلَى نَبِيِّنَا وَعَلَيْهِ السَّلَامُ فَالْعِلْمُ أَفْضَلُ مِنْ اللُّؤْلُؤِ" )
( clartts_0312 "وَلَا مِنْ مُحِبٍّ أَنْ يَمَلَّ فَيَبْعُدَا" )
( clartts_0313 "فَإِنَّ نَفْسَ الْبَخِيلِ لَا تَسْمَحُ بِفِرَاقِ مَحْبُوبِهَا" )
( clartts_0314 "بِمِقْدَارِ مَا تُعْطِي الطَّعَامَ مِنْ الْمِلْحِ وَقَدْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَمْزَحُ عَلَى هَذَا الْوَجْهِ" )
( clartts_0315 "وَأَنَّ لِلْجَهْلِ إقْبَالًا مُجْدِيًا وَلِلْعِلْمِ إدْبَارًا مُكْدِيًا" )
( clartts_0316 "وَتَهْذِيبِ سُبُلِهَا وَمَسَالِكِهَا وَالرَّابِعُ" )
( clartts_0317 "وَمَحْمُودٌ لَوْلَا أَنَّهُ مَفْقُودٌ وَغِنًى" )
( clartts_0318 "وَقَالَ بَعْضُ الْبُلَغَاءِ مَنْ أَصْلَحَ نَفْسَهُ أَرْغَمَ أَنْفَ أَعَادِيهِ" )
( clartts_0319 "وَهَذِهِ حَالُ مَنْ لَا يَرَى لِنَفْسِهِ قَدْرًا" )
( clartts_0320 "وَخَلَّصَهُ مِمَّا بَيْنَ يَدَيْهِ مِنْ الْخَطَرِ وَقَالَ بَعْضُ السَّلَفِ" )
( clartts_0321 "يَنْبَغِي لِمَنْ قَلَّ مِنْهَا حَظُّهُ أَنْ يَيْأَسَ مِنْ نَيْلِ الْقَلِيلِ وَإِدْرَاكِ الْيَسِيرِ" )
( clartts_0322 "وَلَمَّا بَلَغَ مَزْدَكُ مِنْ الدُّنْيَا أَفْضَلَ مَا" )
( clartts_0323 "مَا طَاوَعَنِي النَّاسُ عَلَى شَيْءٍ أَرَدْتُهُ مِنْ الْحَقِّ حَتَّى بَسَطْتُ لَهُمْ طَرَفًا مِنْ الدُّنْيَا" )
( clartts_0324 "وَلَوْ تَنَزَّهَ فِي مِثْلِ هَذِهِ الْحَالِ عَنْ اسْتِبْذَالِ الْحَرَائِرِ للْإِمَاءِ" )
( clartts_0325 "سَمَّيْته طِفْلَ وَمَا تَنْفَعُ الْأَيَّامُ حِينَ يَعُدُّهَا" )
( clartts_0326 "مَا نَالَ مَحْمَدَةَ الرِّجَالِ وَشُكْرَهُمْ إلَّا الْجَوَادُ بِمَالِهِ الْمِفْضَالُ" )
( clartts_0327 "وَيُبْغِضُ الطَّالِحِينَ وَهُوَ مِنْهُمْ وَقَالَ الْحَسَنُ الْبَصْرِيُّ" )
( clartts_0328 "لِيَكُونَ اسْتِئْنَاسَهُمْ بِكُلِّ وَاحِدٍ مِنْ النَّوْعَيْنِ" )
( clartts_0329 "وَخَصَّ الصَّبِيَّ لِأَنَّ مَا يَأْتِيهِ بِالطَّبْعِ" )
( clartts_0330 "وَبَلَادَةُ الْمَجْبُورِ وَلَا تَقْصُرُ عَنْ دَرَكٍ وَلَا تَعْصِي فِي نَهْضَةٍ وَلَا تَكِلُّ عَنْ اسْتِعَانَةٍ" )
( clartts_0331 "وَقِيلَ لِزَاهِدٍ مَا لَك تَمْشِي عَلَى الْعَصَا وَلَسْت بِكَبِيرٍ وَلَا مَرِيضٍ" )
( clartts_0332 "وَلَعَمْرِي إنَّ هَذَا صَحِيحٌ لِأَنَّ لِكُلِّ يَوْمٍ غَدًا" )
( clartts_0333 "إذَا قَطَعْنَا عِلْمًا بَدَا لَنَا" )
( clartts_0334 "بَلْ سَتْرُ الْعَوْرَةِ وَاجِبٌ بِالشَّرْعِ لِأَنَّهُ بَعْضُ الْجَسَدِ الَّذِي" )
( clartts_0335 "وَاعْلَمْ أَنَّ لِلْعُلُومِ أَوَائِلَ تُؤَدِّي إلَى أَوَاخِرِهَا" )
( clartts_0336 "فَأَمَّا مَا يَجِبُ أَنْ يَكُونَ عَلَيْهِ الْعُلَمَاءُ مِنَ الْأَخْلَاقِ" )
( clartts_0337 "فَنَفَرَتْ النِّعْمَتَانِ وَمَنْ نَفَرَتْ عَنْهُ النِّعْمَتَانِ" )
( clartts_0338 "تُقْبِلُ إقْبَالَ الطَّالِب وَتُدْبِرُ إدْبَارَ الْهَارِبِ" )
( clartts_0339 "أَقَلُّ مِنْ أَضْدَادِهِ مِنْ ذَوِي الْحُمْقِ وَالنَّقْصِ لِأَنَّ الْخِيَارَ فِي كُلِّ جَنْسٍ هُوَ الْأَقَلُّ" )
( clartts_0340 "لَوْ أَنَّ مَا أَنْتُمُو فِيهِ يَدُومُ لَكُمْ ظَنَنْتُ مَا أَنَا فِيهِ دَائِمًا أَبَدَا" )
( clartts_0341 "بِيَدٍ تُقِرُّ بِأَنَّهَا مَوْلَاتُهُ" )
( clartts_0342 "وَلِكُلِّ عَصْرٍ فِيهِ وِهَايَةُ كَمَا أَنَّ السُّلْطَانَ إنْ لَمْ يَكُنْ عَلَى دِينٍ" )
( clartts_0343 "وَالِابْتِدَاءُ بِالْفَضِيلَةِ فَضِيلَةٌ وَلَأَنْ يَكُونَ شَيْخًا مُتَعَلِّمًا" )
( clartts_0344 "وَقَالَ بَعْضُ الْحُكَمَاءِ إذَا سَكَتَّ عَنْ الْجَاهِلِ فَقَدْ أَوْسَعْتَهُ جَوَابًا" )
( clartts_0345 "وَالْمُجْتَرِئُ عَلَى اللَّهِ عَاصٍ وَقَالَ" )
( clartts_0346 "رَوَى ابْنُ قُتَيْبَةَ فِي الْمَعَارِفِ أَنَّ مَرْوَانَ" )
( clartts_0347 "فَإِنَّ لِمَن ظَفِرَ بِسِرٍّ مِنْ فَرْطِ الْإِدْلَالِ وَكَثْرَةِ الِاسْتِطَالَةِ" )
( clartts_0348 "فَفَجَعَاتٌ مُحْرِقَةٌ وَلَيْسَ لِوَصْلِهَا دَوَامٌ" )
( clartts_0349 "ثُمَّ إنَّ اللَّهَ تَعَالَى جَعَلَ أَسْبَابَ حَاجَاتِهِ وَحِيَلَ عَجْزِهِ" )
( clartts_0350 "أَوْ يَكُونَ قَصَّرَ فِيهَا فَنَقَصَتْ عَنْ حُدُودِهَا" )
( clartts_0351 "وَأَنْ أَجْفُوَهُ وَهُوَ بَعِيدُ التَّوَسُّطُ فِي زِيَارَةِ الْإِخْوَانِ" )
( clartts_0352 "وَبَغَّضْتُهَا فِيكَ آمَالَهَا وَمَا طَابَتِ النَّفْسُ" )
( clartts_0353 "وَيَصُدُّ عَنْهُ الشَّرْعُ وَلِذَلِكَ جَازَ أَنْ تَسْتَفِيضَ الْأَخْبَارُ الصَّادِقَةُ" )
( clartts_0354 "وَعَلَى الْخُلَطَاءِ تَنَكُّرًا إمَّا مِنْ لُؤْمِ طَبْعٍ" )
( clartts_0355 "وَبِبِدَايَةِ الْعُقُولِ إلَّا مَزْجُورًا وَقَدْ قَالَ اللَّهُ تَعَالَى" )
( clartts_0356 "وَلَا تَمْنُنْ تَسْتَكْثِر إنَّهُ لَا يُعْطِي عَطِيَّةً يَلْتَمِسُ بِهَا أَفْضَلَ مِنْهَا" )
( clartts_0357 "أَلَا إنَّ أَوْلِيَاءَ اللَّهِ الَّذِينَ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ" )
( clartts_0358 "الْعِلْمُ حَاكِمٌ وَالْمَالُ مَحْكُومٌ عَلَيْهِ" )
( clartts_0359 "قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا ازْدَادَ أَحَدٌ بِعَفْوٍ إلَّا عِزًّا" )
( clartts_0360 "وَقَالَتْ مَعَاذَ اللَّهِ مِنْ فِعْلِ مَا حَرُمْ" )
( clartts_0361 "لَا يُوجِبُ الْعَقْلُ سَتْرَ بَاقِيهِ وَإِنَّمَا اخْتَصَّتْ الْعَوْرَةُ بِحُكْمٍ شَرْعِيٍّ" )
( clartts_0362 "أَعْطَى كُلَّ شَيْءٍ مَا يَصْلُحُهُ ثُمَّ هَدَاهُ" )
( clartts_0363 "وَالسَّبَبُ الْخَامِسُ وَالْإِقْرَارَ بِتَعْظِيمِهِ" )
( clartts_0364 "فَيَنْبَغِي لِلْعَالِمِ أَنْ يَمْنَعَهُ عَنْ طُلْبَتِهِ" )
( clartts_0365 "فَقَالَ كُنْتُ أَتَوَقَّى قَالَ فَتَوَقَّ الْخَطَايَا" )
( clartts_0366 "وَقَدْ يَكُونُ تَارَةً ارْتِهَانًا لِلْمَأْمُولِ" )
( clartts_0367 "إذَا الْهَمُّ أَمْسَى وَهُوَ دَاءٌ فَأَمْضِهِ وَلَسْتَ بِمُمْضِيهِ وَأَنْتَ تُعَاذِلُهْ" )
( clartts_0368 "اَلَّذِي رُوِيَ عَنْ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ أَنَّهُ قَالَ لِأَبِي مَرْيَمَ" )
( clartts_0369 "وَقَالَ بَعْضُ الْأُدَبَاءِ مَنْ نَالَتْهُ إسَاءَتُك" )
( clartts_0370 "فَخَوْفِي أَنْ يُرَدَّ عَلَيَّ عَمَلِي وَقَالَ ابْنُ السَّمَّاكِ" )
( clartts_0371 "فَإِنَّ الصَّبْرَ عَنْهَا يُعْقِبُ السَّلْوَ مِنْهَا وَالْأَسَفُ بَعْدَ الْيَأْسِ خَرَقٌ" )
( clartts_0372 "وَعَلَى أَخِيكَ نَصِيحَةً لَا تَرْدُدْ" )
( clartts_0373 "بَعْدَ شِدَّةِ الْأَمَلِ فَحَدَثَتْ مِنْهُ عَدَاوَةُ الْخَائِبِ" )
( clartts_0374 "وَالثَّانِي فَهُمَا شَيْئَانِ لَا صَلَاحَ لِأَحَدِهِمَا إلَّا بِصَاحِبِهِ" )
( clartts_0375 "أَنْشَدَ يَقُولُ إذَا الرِّجَالُ وَلَدَتْ أَوْلَادُهَا" )
( clartts_0376 "يَتَوَجَّهُ عَلَيْهِ عَتْبٌ وَقَدْ قَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_0377 "وَرَوَى عَوْنُ بْنُ عَبْدِ اللَّهِ عَنْ ابْنِ مَسْعُودٍ رَضِيَ اللَّهُ عَنْهُ أَنَّهُ قَالَ" )
( clartts_0378 "وَمَطَامِعِ اللُّؤْمِ فَإِنَّ الْبَهَائِمَ الْوَحْشِيَّةَ تَأْبَى ذَلِكَ" )
( clartts_0379 "وَاعْلَمْ أَنَّ النَّصْرَ مَعَ الصَّبْرِ وَالْفَرَجَ مَعَ الْكَرْبِ" )
( clartts_0380 "وَجَبَ إخَاؤُهُ وَتَعَيَّنَ اصْطِفَاؤُهُ وَبِحَسَبِ وُفُورِهِ فِيهِ" )
( clartts_0381 "مِهْنَةٍ لَخَفَضَ جَنَاحَ نَفْسِهِ وَاسْتَبْدَلَ لِينًا" )
( clartts_0382 "وَقَالَ بَعْضُ الْحُكَمَاءِ مُخَالَطَةُ الْأَشْرَارِ عَلَى خَطَرٍ" )
( clartts_0383 "وَهَمِّي مِنْ الدُّنْيَا صَدِيقٌ مُسَاعِدُ نَكُونُ كَرُوحٍ بَيْنَ جِسْمَيْنِ قُسِّمَتْ" )
( clartts_0384 "ثُمَّ يُوصِيكُمْ بِأُمَّهَاتِكُمْ ثُمَّ يُوصِيكُمْ بِآبَائِكُمْ" )
( clartts_0385 "وَحُسْنِ الثِّقَةِ وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0386 "وَخِصْبٌ فِي الْمَوَادِّ فَأَمَّا خِصْبُ الْمَكَاسِبِ" )
( clartts_0387 "فَكَذَلِكَ تَعْجِزُ النَّفْسُ عَنْ أَثْقَالِ مَا كَانَتْ" )
( clartts_0388 "وَأَبْلَغُ مِنْ ذَلِكَ قَوْلُ عِيسَى ابْنِ مَرْيَمَ علَى نَبِيِّنَا وَعَلَيْهِ السَّلَامُ" )
( clartts_0389 "وَالثَّانِي اتِّبَاعُ الشَّهْوَةِ وَقَدْ رُوِيَ عَنْ النَّبِيِّ عَلَيْهِ السَّلَامُ أَنَّهُ قَالَ لِعَلِيِّ بْنِ أَبِي طَالِبٍ كَرَّمَ اللَّهُ وَجْهَهُ" )
( clartts_0390 "وَسَمْتُ امْرَأً بِالْبِرِّ ثُمَّ اطَّرَحْتُهُ" )
( clartts_0391 "وَحَشْوُك فِيمَا بَيْنَ ذَاكَ بَوْلٌ وَعَذِرَةٌ" )
( clartts_0392 "فَأَنَالُ مِنْك الْيَوْمَ مَا تَنَالُهُ مِنِّي غَدًا" )
( clartts_0393 "لَا يَحْمِلَنَّكَ جَمَالُ النِّسَاءِ عَنْ صَرَاحَةِ النَّسَبِ" )
( clartts_0394 "كُلُّ ساعَةٍ يَمُوتُ مِنْكَ جُزْءٌ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_0395 "وَالثَّنَاءَ فَقَدْ كَافَأَهُ وَقِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_0396 "وَلَا ذُلٌّ إلَّا ذَاقَهُ كَمَا قَالَ عَبْدُ الصَّمَدِ" )
( clartts_0397 "صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اكْسِبْ طَيِّبًا وَاعْمَلْ صَالِحًا" )
( clartts_0398 "مِنْهُ بِالْقَلِيلِ مِنْ الْعَمَلِ وَرُوِيَ عَنْ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ أَنَّهُ قَالَ" )
( clartts_0399 "وَسَهُلَتْ عَلَيْهِ زَوَاجِرُهُ وَقَالَ الْفُضَيْلُ بْنُ عِيَاضٍ" )
( clartts_0400 "فَبَلَغَ ذَلِكَ أَبَا حَازِمٍ فَقَالَ الْحَمْدُ لِلَّهِ الَّذِي جَعَلَهُمْ يَتَمَنَّوْنَ عِنْدَ الْمَوْتِ مَا نَحْنُ فِيهِ" )
( clartts_0401 "وَقَالَ بَعْضُ الشُّعَرَاءِ عَوِّدْ لِسَانَك قَوْلَ الصِّدْقِ تَحْظَ بِهِ" )
( clartts_0402 "فَهُوَ أَلْزَمُ مِمَّا هُوَ حَادِثٌ بِالْقَصْدِ وَنَحْنُ نَبْدَأُ بِالْوَجْهِ الْأَوَّلِ الْمُكْتَسَبِ بِالِاتِّفَاقِ" )
( clartts_0403 "وَوَعَدَهُمْ فَلَمْ يُخْلِفْهُمْ فَهُوَ مِمَّنْ كَمُلَتْ مُرُوءَتُهُ" )
( clartts_0404 "فَعِشْ وَاحِدًا أَوْ صِلْ أَخَاك فَإِنَّهُ مُقَارِفُ ذَنْبٍ مَرَّةً" )
( clartts_0405 "وَقَالَ ابْنُ الْمُقَفَّعِ الْبَلَاغَةُ قِلَّةُ الْحَصْرِ" )
( clartts_0406 "اُنْظُرْ خَلَاكَ فَإِنَّ النَّتْنً تَثْرِيبُ" )
( clartts_0407 "مَا اسْتَحَقَّ شُكْرًا وَقَالَ صَالِحُ بْنُ عَبْدِ الْقُدُّوسِ" )
( clartts_0408 "الْمُسْتَشِيرُ وَالْمُسْتَشَارُ مُؤْتَمَنٌ" )
( clartts_0409 "إذَا أَخْفَيْتَهُ ظَهَرَا وَمِنْ شُرُوطُ الْمَعْرُوفِ تَصْغِيرُهُ" )
( clartts_0410 "حَتَّى تَسْخُوَ نَفْسُهُ عَمَّا بِيَدِ غَيْرِهِ" )
( clartts_0411 "فَيَسْتَوْجِبُ مَعَ ذَمِّ الْمَنْعِ فَيَسْتَوْجِبُ مَعَ ذَمِّ الْمَنْعِ" )
( clartts_0412 "فَاظْفَرْ بِذَاتِ الدِّينِ تَرِبَتْ يَدَاك وَفِيهِ تَأْوِيلَانِ" )
( clartts_0413 "لَأَعْيَاهُ مَا طَلَبْ مُقَارَنَة مُصَابِه" )
( clartts_0414 "لِلْمَزِيدِ مٍنَ الْمًعْلُومًاتِ أًوْ لٍلْمُشَارَكَةِ زُوُرُوا الْمَوْقِعْ" )
( clartts_0415 "أَنْ لَا يَمْنَعُوا طَالِبًا وَلَا يُؤَيِّسُوا مُتَعَلِّمًا" )
( clartts_0416 "وَقَالَ آخَرُونَ هَذَا خَارِجٌ مِنْ السَّخَاءِ الْمَحْمُودِ" )
( clartts_0417 "فَأَمَّا إقَامَةُ إمَامَيْنِ أَوْ ثَلَاثَةٍ فِي عَصْرٍ وَاحِدٍ وَبَلَدٍ وَاحِدٍ فَلَا يَجُوزُ إجْمَاعًا" )
( clartts_0418 "وَلَا أَنْ تَخْتَلِفَ الْعُقَلَاءُ فِي صَلَاحِهَا وَفَسَادِهَا" )
( clartts_0419 "يَعْنِي مَنْ أَعْطَى فِيمَا أُمِرَ وَاتَّقَى فِيمَا" )
( clartts_0420 "وَقَالَ آخَرُ الْأَيَّامُ صَحَائِفُ أَعْمَالِكُمْ" )
( clartts_0421 "وَالْعَمَلُ تَبَعًا كَالْكِتَابَةِ وَالثَّانِي" )
( clartts_0422 "فَاصْرِفْ نَوَالَكَ عَنْ أَخِيكَ مُوَفِّرًا فَاللَّيْثُ لَيْسَ يُسِيغُ إلَّا" )
( clartts_0423 "حِرْزُ الْمُوسِرِ وَقَالَ بَعْضُ الْأُدَبَاءِ" )
( clartts_0424 "وَالثَّانِي عَذَابُ الْآخِرَةِ فِي النَّارِ الْإِسْتِدْرَاجُ فِي النِّعَمِ" )
( clartts_0425 "بِهِ وَلِعِلْمٍ أَنْتَ تُتْقِنُهُ سِلْمُ" )
( clartts_0426 "وَإِذَا كَانَ ذَا شَرِّ أَبْغَضَهُمْ وَأَبْغَضُوهُ مَنْزِلَةَ الْإِمَامِ عِنْدَ اللَّهِ وَالنَّاسِ" )
( clartts_0427 "أَنْ تَكُونَ صِنَاعَةُ الْعَمَلِ أَغْلَبُ وَالْفِكْرُ تَبَعًا" )
( clartts_0428 "وَأَن تُصِيبَ فَلَا تُخْطِئَ وَقَالَ الشَّاعِرُ" )
( clartts_0429 "وَكِلَاهُمَا مَذْمُومٌ وَذَمُّ التَّبْذِيرِ أَعْظَمُ" )
( clartts_0430 "رَجُلٌ يُجِلُّ الْعَمَلَ بِفَضْلِهِ وَمُرُوءَتِهِ" )
( clartts_0431 "يَجْعَلَ بَلَادَتَهُ ذَرِيعَةً لِحِرْمَانِهِ" )
( clartts_0432 "مَتَى يُفْطِرُ الصَّائِمُ قَالَ إذَا غَرَبَتْ الشَّمْسُ" )
( clartts_0433 "وَالْخَاطِئُ مَعْذُورًا فَقَدْ قِيلَ مَنْ صَنَّفَ كِتَابًا فَقَدْ اسْتَهْدَفَ" )
( clartts_0434 "وَقَبْلَ أَنْ تُولَدُوا قَالُوا وَكَيْفَ أَحْسَنْتَ إلَيْنَا قَبْلَ أَنْ نُولَدَ" )
( clartts_0435 "أَنْ تَقْدِرَ عَلَى الْمَعْرُوفِ وَلَا تَصْطَنِعُهُ حَتَّى يَفُوتَ" )
( clartts_0436 "وَقَالَ بَعْضُ الْبُلَغَاءِ مَنْ تَفَرَّدَ بِالْعِلْمِ لَمْ تُوحِشْهُ مُفَارَقَةُ الْإِخْوَانْ" )
( clartts_0437 "أَقْبَلَ عَلَيَّ وَقَالَ جَزَاك اللَّهُ خَيْرًا" )
( clartts_0438 "وَقَالَ بَعْضُ الْحُكَمَاءِ إذَا كَانَ مِنْ قَوَاعِدِ الْحِكْمَةِ" )
( clartts_0439 "وَإِنْ كَانَ اللَّهُ تَعَالَى قَدْ أَشْرَكَ بَيْنَهُمَا فِي الْبِرِّ" )
( clartts_0440 "وَمَنْ صَرَفَ عَنْهُ مِمَّا هُوَ أَشَدُّ مِنْ مَرَضِهِ وَخَوْفِهِ" )
( clartts_0441 "وَإِنَّمَا يَكُونُ الرَّأْيُ مَقْبُولًا إذَا كَانَ عَنْ رَغْبَةٍ وَطَلَبٍ" )
( clartts_0442 "وَاضْطَرَّ إلَى اسْتِيدَاعِ سِرِّهِ وَلَيْتَهُ كُفِيَ الِاضْطِرَارُ" )
( clartts_0443 "وَتَوْبِيخُ الْمُخَاطَبِينَ أَبْلَغَ فِيهَا" )
( clartts_0444 "وَالْمُمْتَنُّ عَلَى اللَّهِ جَاحِدٌ لِنِعَمِهِ" )
( clartts_0445 "كَثُرَ صَدِيقُهُ وَقَدْ تُحْدِثُ الْوِلَايَاتُ" )
( clartts_0446 "فَهُوَ يَظُنُّ أَنْ لَا خَوْفَ لَهُ إلَّا إيَّاهُ" )
( clartts_0447 "وَنَاهِيَك بِسَيِّئَةٍ تُحْبِطُ كُلَّ حَسَنَةٍ" )
( clartts_0448 "عِظَمًا إنَّهُ عِنْدَك مَيْسُورٌ حَقِيرُ" )
( clartts_0449 "يُقَبِّحُ الذِّكْرَ وَالِاسْمَ وَسُئِلَ بَعْضُ الْحُكَمَاءِ عَنْ الْفَرْقِ بَيْنَ الْعَقْلِ وَالْمُرُوءَةِ" )
( clartts_0450 "وَقِيلَ لِبَعْضِ الزُّهَّادِ مَا تَقُولُ فِي صَلَاةِ اللَّيْلِ" )
( clartts_0451 "فَلَا خَيْرَ فِي الْمَعْرُوفِ إذَا أُحْصِى وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_0452 "مَا تَرَكَتْ لِذِي غَيْظٍ شِفَاءً وَقَسَّمَ مُعَاوِيَةُ رَضِيَ اللَّهُ عَنْهُ قِطَافًا" )
( clartts_0453 "وَقَدْ قَالَ الشَّاعِرُوَحَسْبُك مِنْ حَادِثٍ بِامْرِئٍ" )
( clartts_0454 "وَقَامَ عِلْمُكَ بِي فَاحْتَجَّ عِنْدَكَ لِي" )
( clartts_0455 "فَإِذَا فَعَلَ مَنْ أَفْضَى إلَيْهِ سُلْطَانُ الْأُمَّةِ مَا ذَكَرْنَا مِنْ هَذِهِ الْأَشْيَاءِ السَّبْعَةِ" )
( clartts_0456 "مَنْ أَسْوَأُ النَّاسِ حَالًا قَالَ مَنْ بَعُدَتْ هِمَّتُهُ وَاتَّسَعَتْ أُمْنِيَّتُهُ وَقَصُرَتْ آلَتُهُ وَقَلَّتْ مَقْدِرَتُهُ" )
( clartts_0457 "الدَّيُّوثُ هُوَ الَّذِي يَجْمَعُ بَيْنَ الرِّجَالِ وَالنِّسَاءِ" )
( clartts_0458 "وَإِنْ كَانَ الْكَذِبُ مُسْتَقْبَحًا فِيهِ الدِّينُ" )
( clartts_0459 "مِنْ الْمُعَنِّفِ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَال" )
( clartts_0460 "لَكِنْ إنْ وَجَدَهُ قَرْضًا مَرْدُودًا لَمْ يَأْخُذْهُ صِلَةً ووَجُودًا" )
( clartts_0461 "ذُو نِعْمَةٍ فَافْعَلْ وَلَا تَكُنْ عَبْدَ غَيْرِك وَقَدْ جَعَلَك اللَّهُ حُرًّا" )
( clartts_0462 "وَقَدْ قِيلَ لِلْحَكِيمِ الْيُونَانِيِّ مَنْ أَضْيَقُ النَّاسِ طَرِيقًا وَأَقَلُّهُمْ صَدِيقًا" )
( clartts_0463 "مُشْتَبِهْ وَسَمْعَك صُنْ عَنْ قَبِيحِ الْكَلَامِ كَصَوْنِ اللِّسَانِ" )
( clartts_0464 "فَكَانَ هَذَا مُوَضِّحًا لِمَعْنَى مَا ذَكَرْنَا" )
( clartts_0465 "عَذَرْنَا النَّخْلَ فِي إبْدَاءِ شَوْكٍ َيُرَدُّ بِهِ الْأَنَامِلُ عَنْ جَنَاهُ" )
( clartts_0466 "قِسْمًا عَلَى أَبْدَانِهِمْ كَالصَّلَاةِ وَالصِّيَامِ" )
( clartts_0467 "الْحَيَاءُ وَالْعِيُّ شُعْبَتَانِ مِنْ الْإِيمَانِ" )
( clartts_0468 "سَهْلٌ عَلَى مَنْ عَلِمَهُ لِأَنَّ مَعَانِيَهُ الَّتِي يُتَوَصَّلُ إلَيْهَا مُسْتَوْدَعَةٌ فِي كَلَامٍ مُتَرْجَمٍ" )
( clartts_0469 "فَأَشَارُوا عَلَيَّ بِقَتْلِك إلَّا أَنِّي وَجَدْتُ قَدْرَك فَوْقَ ذَنْبِك" )
( clartts_0470 "إذْ لَيْسَ كُلُّ مَطْلُوبٍ إلَيْهِ طَالِبًا وَلَا كُلُّ مَرْغُوبٍ إلَيْهِ رَاغِبًا" )
( clartts_0471 "أَدَبُ الدِّينِ حِكْمَةُ التَّكْلِيفِ اعْلَمْ أَنَّ اللَّهَ سُبْحَانهُ وَتَعَالَى إنَّمَا كَلَّفَ الْخَلْقَ مُتَعَبَّدَاتِهِ" )
( clartts_0472 "لِقَوْمٍ أَخْلَاقًا مَذْمُومَةً وَقَدْ يَحْدُثُ" )
( clartts_0473 "فَلَا يَغْلِبُهُ حُسْنُ الظَّنِّ عَلَى تَصْدِيقِ مَدْحٍ" )
( clartts_0474 "وَبِقَدْرِ شَرَفِهِ يَكُونُ الْإِقْدَامُ وَإِنْ كَانَ الْإِيَاسُ" )
( clartts_0475 "وَدَخَلَتْ امْرَأَةٌ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0476 "تُؤْخَذُ أَيْنَ وُجِدَتْ وَلَا يَهُونُ لِمَهَانَةِ صَاحِبِهِ فَيُطْرَحُ" )
( clartts_0477 "وَعِلَاجُهُ أَنْ يُتْرَكَ عَلَى مَلَلِهِ فَيَمَلَّ الْجَفَاءَ" )
( clartts_0478 "تُؤْذِيهِ الْبَقَّةُ وَتُنْتِنُهُ الْعَرَقَةُ" )
( clartts_0479 "صَبْرًا أَبَا أَيُّوبَ صَبْرًا مُبَرِّحُ" )
( clartts_0480 "يَا بُنَيَّ لَا تَطْلُبْ الْحَوَائِجَ مِنْ غَيْرِ أَهْلِهَا" )
( clartts_0481 "وَأَنْشَدْت لِأَبِي الْفَتْحِ الْبُسْتِيِّ تَكَلَّمْ وَسَدِّدْ مَا اسْتَطَعْت فَإِنَّمَا" )
( clartts_0482 "فَإِنَّ السُّنَّةَ لَا يَجُوزُ أَنْ تَرِدَ بِإِبَاحَةِ الْكَذِبِ" )
( clartts_0483 "مَنْ دَعَاهُ التَّقْصِيرُ إلَى الْعُقُوقِ وَشَرَّ الْآبَاءِ" )
( clartts_0484 "وَإِذَا كَانَ مَعَ الرَّغْبَةِ وَقُورًا وَعِنْدَ الطَّلَبِ صَبُورًا" )
( clartts_0485 "الْمُتَقَدِّمِينَ اسْتِغْنَاؤُك عَنْ الشَّيْءِ خَيْرٌ مِنْ اسْتِغْنَائِك بِهِ" )
( clartts_0486 "يُسَامِحُ فِي وَقْتِ اسْتَرَاحَتِهِ وَحِينَ فَتْرَتِهِ لِيَرْجِعَ إلَى الْحُسْنَى وَيَئُوبَ إلَى الْإِخَاءِ" )
( clartts_0487 "لِصَدِيقِهِ فَيَمَلُّ مِنْ غَشَيَانِهِ" )
( clartts_0488 "فَقَدْ هَتَكَ سِتْرًا كَانَ بِصَوْنِهِ أَوْلَى" )
( clartts_0489 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَال" )
( clartts_0490 "تَصَدَّقُوا عَلَيْنَا بِمَا لَا يُتْعِبُ ضِرْسًا وَلَا يُسْقِمُ نَفْسًا" )
( clartts_0491 "الْتِمَاسًا لِثَوَابِهَا وَرَغْبَةً فِي الزُّلْفَةِ بِهَا" )
( clartts_0492 "وَالِاقْتِدَاءِ بِأَخْيَارِ الْأَفَاضِلِ وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0493 "جَوْرًا لَا يَنْفَكُّ إلَّا بِالسَّخَطِ عَلَيْهَا" )
( clartts_0494 "وَذَهَابُ أَمْوَالِي وَقَطْعُ لِسَانِي وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0495 "وَقَالَ بَعْضُ الْأُدَبَاءِ كَلَامُ الْمَرِيدِ وَافِدُ أَدَبِهِ" )
( clartts_0496 "وَعَظَتْك أَجْدَاثٌ صُمُتْ وَنَعَتَك أَزْمِنَةٌ خُفُتْ" )
( clartts_0497 "يُنْمِي عَلَى طَالِبِهِ قَالَ اللَّهُ تَعَالَى" )
( clartts_0498 "إنْ كُنْتَ مِنْ رُهْبَانِ النَّصَارَى فَالْحَقْ بِهِمْ" )
( clartts_0499 "بِمُوَاخَاتِهِ وَيَثِقُ بِنُصْرَتِهِ وَمُوَالَاتِهِ" )
( clartts_0500 "حِكْمَةً مِنْهُ تَعَالَى يَدُلُّ بِهَا عَلَى قُدْرَتِهِ وَإِجْرَاءِ الْأُمُورِ عَلَى مَشِيئَتِهِ" )
( clartts_0501 "وَيَحْدُثُ بِخُلُوصِ الْمُصَافَاةِ وَفَاءًا وَمُحَامَاةً" )
( clartts_0502 "فَإِنَّ الْعِلْمَ أَمْنَعُ لِجَانِبِهِ" )
( clartts_0503 "تَقْصِيرٌ يَكُونُ حَصْرًا وَتَكْثِيرٌ يَكُونُ هَذْرًا" )
( clartts_0504 "هَبْكَ الْخَلِيفَةَ كُنْتَ مُنْتَفِعًا بِغَضَارَةِ الدُّنْيَا" )
( clartts_0505 "وَلَا تَخْلُو مِنْ فِتْنَةٍ وَلَا تُخَلِّي مِحْنَةً فَأَعْرِضْ عَنْهَا قَبْلَ أَنْ تُعْرِضَ عَنْك" )
( clartts_0506 "وَقَدْ اخْتَلَفَ النَّاسُ فِي مِثْلِ هَذَا هَلْ يَكُونُ مَنْسُوبًا إلَى السَّخَاءِ فَيُحْمَدُ" )
( clartts_0507 "فَيَخْتَلُّوا حِكْمَةً مِنْهُ سُبْحَانَهُ وَتَعَالَى" )
( clartts_0508 "مَضْعُوفَيْنِ أَوْ بِدَوَاعِي الْهَوَى مَغْلُوبَيْنِ" )
( clartts_0509 "رَضِيَ اللَّهُ عَنْهُمْ أَجْمَعِينَ أَنَّهُ قَالَ" )
( clartts_0510 "اقْبَلْ نُصْحَ الْمَشِيبِ وَإِنْ عَجَّلَ وَقِيلَ" )
( clartts_0511 "وَظُهُورِ الْعَجْزِ نِعْمَةً عَلَيْهِ وَلُطْفًا بِهِ" )
( clartts_0512 "مِنْ سُوءِ عَوَاقِبِ الْفِتْنَةِ وَقَدْ قَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_0513 "إلَى جُمَلٍ يَتَنَبَّهُ الْفَاضِلُ عَلَيْهَا بِيَقِظَتِهِ" )
( clartts_0514 "أَمَا تَمْنَعُ هَؤُلَاءِ الْغِلْمَانِ فَقَالَ أَنُوشِرْوَانَ" )
( clartts_0515 "فَصَابَرَهَا حَتَّى مَضَتْ وَاضْمَحَلَّتْوَكَمْ غَمْرَةٍ هَاجَتْ بِأَمْوَاجِ" )
( clartts_0516 "وَقَالَ آخَرُ لِكُلِّ شَيْءٍ عَدِمْتهُ عِوَضًا" )
( clartts_0517 "لِانْحِرَافِ النَّاسِ عَنْهُ وَنُفُورِهِمْ مِنْهُ وَقَدْ قِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_0518 "فَكَانَ مِنْ لَطِيفِ مَا دَبَّرَهُ وَبَدِيعِ مَا قَدَّرَهُ أَنَّهُ خَلَقَهُمْ مُحْتَاجِينَ" )
( clartts_0519 "وَهَذَا وَاضِحُ الْمَعْنَى لِأَنَّ الْكَفَّ عَنْ الْمَعَاصِي تَرْكٌ" )
( clartts_0520 "امْتِنَانٌ وَضَيَّعَ حَسَبًا امْتِهَانٌ" )
( clartts_0521 "وَأَنْشَدَنِي بَعْضُ أَهْلِ الْعِلْمِ لِطَاهِرِ بْنِ الْحُسَيْنِ إذَا أَعْجَبَتْك خِصَالُ امْرِئٍ فَكُنْهُ" )
( clartts_0522 "كَانَ اجْتِمَاعُهُمْ عَلَيْهَا أَوْلَى فَالْمُرَادُ مِنْهُ الِاعْتِرَاضُ عَلَى فَسَادِهِ" )
( clartts_0523 "تَذَكَّرْتُ الْمَكَارِمَ مَرَّةً فِي مَجْلِسٍ أَنْتُمْ بِهِ" )
( clartts_0524 "وَقَالَ بَعْضُ الْبُلَغَاءِ الْزَمْ الصَّمْتَ فَإِنَّهُ يُكْسِبُك صَفْوَ الْمَحَبَّةِ" )
( clartts_0525 "فَقَالَ أَمَّا تَرَيْنَ بَيَاضَ عَيْنَيَّ أَكْثَرَ مِنْ سَوَادِهَا" )
( clartts_0526 "فَلَا بِالْفَضْلِ أَخَذَ وَلَا إلَى الْعَفْوِ أَخْلَدَ" )
( clartts_0527 "مُسْتَوْدَعًا فَأَمَّا الضَّرَرُ فَرُبَّمَا اسْتَوَيَا فِيهِ وَتَفَاضَلَا" )
( clartts_0528 "قَدْ يَنْفَعُ الْأَدَبُ الْأَحْدَاثَ فِي صِغَرٍ وَلَيْسَ يَنْفَعُ" )
( clartts_0529 "إذْ لَيْسَ يَرَى قَضَاءَ اللَّهِ عَدْلًا وَلَا لِنِعَمِهِ مِنْ النَّاسِ أَهْلًا" )
( clartts_0530 "بِخُلُقٍ مِنْهَا وَقَالَ أَزْدَشِيرُ بْنُ بَابَكَ" )
( clartts_0531 "مَا قُدِّمَ لِذَوِي الْفَضْلِ وَالْحِفَاظْ" )
( clartts_0532 "وَاعْلَمْ أَنَّ لِلْكَذَّابِ فَمِنْهَا أَنَّك إذَا لَقَّنْتَهُ الْحَدِيثَ تَلَقَّنَهُ وَلَمْ يَكُنْ بَيْنَ مَا لَقَّنْته وَبَيْنَ مَا أَوْرَدَهُ فَرْقٌ عِنْدَهُ" )
( clartts_0533 "فَدَعُوا مَا يَزُولُ وَقَالَ عِيسَى ابْنُ مَرْيَمَ" )
( clartts_0534 "إلَيْهِ فَيَمْنَعُ مِنْهَا وَلَا بِيَدِهِ فَيَدْفَعُ عَنْهَا" )
( clartts_0535 "وَانْصِرَافِهَا عَمَّا تَرَكَ وَلَوْ نَصَحَ نَفْسَهُ لَعَلِمَ أَنَّ مَا تَرَكَ" )
( clartts_0536 "أَضَرُّ لَهُ مِنْ شَتْمِهِ حِينَ يَشْتُمُ" )
( clartts_0537 "وَالثَّامِنُ مِنْ أَسْبَابِهِ الْخَوْفُ مِنْ الْعُقُوبَةِ عَنْ الْجَوَابِ" )
( clartts_0538 "رَوَى شَرِيكُ بْنُ أَبِيِ نَمِرٍ" )
( clartts_0539 "وَقَدْ قَالَ أَبُو الْأَسْوَدِ الدُّؤَلِيُّ لِابْنِهِ يَا بُنَيَّ" )
( clartts_0540 "وَبَعِيدٌ مِمَّنْ لَا يَعْرِفُ الْعِلْمَ أَنْ يَعْرِفَهُ" )
( clartts_0541 "فِي الرُّتَبِ وَتَرْكُ الْمُنَافَسَةِ فِي التَّقَدُّمِ فَإِنَّ مُشَاحَّةَ النُّفُوسِ فِيهَا أَعْظَمُ" )
( clartts_0542 "بِقَوْلِهِمْ أَنَّهُمْ وَرِثُوهَا عَنْ آبَائِهِمْ" )
( clartts_0543 "فَامْتَنَعَ عَنْهُ وَفِعْلُ قَلِيلِ الْخَيْرِ أَفْضَلُ مِنْ تَرْكِهِ" )
( clartts_0544 "وَقَالَ أَوْسُ بْنُ حَجَرٍ أَقِيمُ بِدَارِ الْحَزْمِ مَا دَامَ حَزْمُهَا" )
( clartts_0545 "شَهِدَتْ بِأَقْبَحِ فِعَالِهِ غَدَرَاتُهُ" )
( clartts_0546 "إنَّهُ اسْتِهْزَاءُ الْمُسْلِمِ بِمَنْ أَعْلَنَ بِفِسْقِهِ" )
( clartts_0547 "فَلَا لَوْمَ عَلَى مُضْطَرٍّ فَإِنْ أَغْنَتْهُ الِاسْتِعَانَةُ بِالْجَاهِ عَنْ الِاسْتِعَانَةِ بِالْمَالِ" )
( clartts_0548 "وَمِمَّنْ سَاعَدَنِي عَلَى سُرُورِ سَاعَتِي وَلَا يُفَكِّرُ فِي حَوَادِثِ غَدِ" )
( clartts_0549 "فَمِنْ أَجْلِ ذَلِكَ كَانَ أُمَنَاءُ الْأَسْرَارِ أَشَدَّ تَعَذُّرًا" )
( clartts_0550 "فَالْحِكْمَةُ وَاسِطَةٌ بَيْنَ الشَّرِّ وَالْجَهَالَةِ" )
( clartts_0551 "فَقَدْ لَغَا مَنْ كَانَ نَظَرُهُ فِي غَيْرِ اعْتِبَارٍ فَقَدْ سَهَا" )
( clartts_0552 "فَقَالَ لَهُ أَبُو يُوسُفَ أَلَا تَسْأَلُ قَالَ بَلَى" )
( clartts_0553 "مَنْ شَكَرَكَ عَلَى مَعْرُوفٍ لَمْ تُسْدِهِ إلَيْهِ" )
( clartts_0554 "مَا نَازَعَتْهُ النَّفْسُ مِنْ الْمُرَاءَاةِ فَكَانَ ذَلِكَ أَبْلَغَ فِي فَضْلِهِ" )
( clartts_0555 "لِأَنَّ الْكِبْرَ يَكُونُ بِالْمَنْزِلَةِ" )
( clartts_0556 "بْنَ قَيْسٍ سَمِعَ رَجُلًا يَقُولُ التَّعْلِيمُ فِي الصِّغَرِ كَالنَّقْشِ عَلَى الْحَجَرِ" )
( clartts_0557 "إلَى الْمُرَاءَاةِ فَبَعَثَهُ الْفَضْلُ عَلَى هَتْكِ" )
( clartts_0558 "لِسَمَاعِ مَا يُغْضِبُ كَانَ ذَلِكَ مِنْ ذُلِّ النَّفْسِ وَقِلَّةِ الْحَمِيَّةِ" )
( clartts_0559 "فِي كُلِّ يَوْمِ لَيْسَ يَوْمٌ إلَّا وَفِيهِ سُعُودٌ" )
( clartts_0560 "وَالشَّرْطُ الثَّانِي الْعَقْلُ الْبَاعِثُ عَلَى حُسْنِ التَّقْدِيرِ" )
( clartts_0561 "أَهْلُ الْخَلَاءِ وَأَمَّا مَا كَانَ حَادِثًا بِالِاكْتِسَابِ فَهِيَ الْمَحَبَّةُ" )
( clartts_0562 "وَقِسْمًا لِائْتِلَافِهِمْ وَإِصْلَاحِ ذَاتِ بَيْنِهِمْ كَنَهْيِهِ عَنْ الْغَضَبِ" )
( clartts_0563 "نَرَاهُ الْأَخُ الْمُعِينُ غَيْرُ الْمُسْتَعِينُ" )
( clartts_0564 "وَأَثْنَى عَلَى وَاصِلِهَا فَقَالَ تَعَالَى" )
( clartts_0565 "دَخَلَتْ مِنْ الْبَادِيَةِ فَسَمِعَتْ صُرَاخًا فِي دَارٍ فَقَالَتْ مَا هَذَا" )
( clartts_0566 "فَضْلُ الْعِلْمِ خَيْرٌ مِنْ فَضْلِ الْعِبَادَةِ وَإِنَّمَا كَانَ كَذَلِكَ لِأَنَّ الْعِلْمَ يَبْعَثُ عَلَى فَضْلِ الْعِبَادَةِ" )
( clartts_0567 "أَسْدَاهَا كَيْ لَا يُنْسَى مَا أَوْلَاهُ" )
( clartts_0568 "كَارِهًا لِلشَّرِّ نَاهِيًا عَنْهُ فَإِنَّ مَوَدَّةَ الشِّرِّيرِ" )
( clartts_0569 "وَنَفْسَهُ عِنْدَ النَّكْبَةِ وَيَحْفَظَك عِنْدَ الْمَغِيبِ" )
( clartts_0570 "وَإِنْ كَانَ قَلِيلأ نَذْرًا إذَا كَانَ الْكَثِيرُ" )
( clartts_0571 "كَمَا نَدِمَ الْمَغْبُونُ لَمَّا تَفَرَّقَا" )
( clartts_0572 "وَمَنْ قَنَعَ بِعَطَائِهِ لَمْ يَدْخُلْهُ حَسَدٌ" )
( clartts_0573 "وَقَالَ بَعْضُ صُلَحَاءِ السَّلَفِ قَدْ أَصْبَحَ بِنَا مِنْ نِعَمِ اللَّهِ تَعَالَى مَا لَا نُحْصِيهِ" )
( clartts_0574 "كَالمُطْفِئِ النَّارِ وَقَالَ بَعْضُ الْحُكَمَاءِ اشْتَرِ مَاءَ وَجْهِك" )
( clartts_0575 "وَيُبَلِّغُ حَاجَتَك وَإِيَّاكَ وَفُضُولَهُ" )
( clartts_0576 "مِنْ الْفَوْتِ وَاجْعَلْ صَوْمَك الدُّنْيَا وَفِطْرَك الْمَوْتَ" )
( clartts_0577 "تَرْكًا لِلْأَوَائِلِ وَالْأَوَاخِرِ فَإِذًا لَيْسَ يُعَرَّى" )
( clartts_0578 "وَجَعَلَ مَا كَلَّفَهُمْ ثَلَاثَةَ أَقْسَامٍ قِسْمًا أَمَرَهُمْ بِاعْتِقَادِهِ" )
( clartts_0579 "عَلَى نَبِيِّنَا وَعَلَيْهِ السَّلَامُ أَتَدْرِي لِمَ اتَّخَذْتُك خَلِيلًا" )
( clartts_0580 "عَلَى الْبَذَاءِ بِسَفَهِهِ فَإِنْ غَفَلَ عَنْ اسْتِكْفَافِ السُّفَهَاءِ وَأَعْرَضَ عَنْ اسْتِدْفَاعِ أَهْلِ الْبَذَاءِ" )
( clartts_0581 "يُبْدِي عُيُوبَ ذَوِي الْعُيُوبِ الْمَنْطِقُ" )
( clartts_0582 "وَإِنَّمَا جُعِلَتْ الدُّنْيَا لِلْعِابَدِ لِيَتَزَوَّدُوا" )
( clartts_0583 "لَا كَمَنْ هُوَ بِابْنِهِ وَبِشَعْرِهِ مَفْتُونُ" )
( clartts_0584 "وَيُثْبِتُهُ عَلَى أُصُولِهِ وَقَوَاعِدِهِ حَسْبَمَا يَقْتَضِيهِ الْجِنْسُ" )
( clartts_0585 "فِي إغْضَائِك رَاحَةُ أَعْضَائِكَ وَسَبَبُ الْغَضَبِ" )
( clartts_0586 "وَقَدْ قَالَ بَعْضُ الْبُلَغَاءِ أَذَلُّ مِنْ اللَّئِيمِ" )
( clartts_0587 "مِنْ حُسْنٍ إذَا الْحُسْنُ قَصَّرَا فَأَمَّا إذَا كَانَ الْجَمَالُ" )
( clartts_0588 "وَالْمَنَايَا تَسُوقُهَا وَالْأَمَانِي تَغُرُّهَا" )
( clartts_0589 "وَمَقْتَ الْقَادِرِ وَهُجْنَةَ الْكَذُوبِ ثُمَّ لَا سَبِيلَ لِمَطْلِهِ بَعْدَ الْوَعْدِ" )
( clartts_0590 "وَيَضْحَى كَئِيبَ الْبَالِ عِنْدِي حَزِينَهُ" )
( clartts_0591 "وَمُدَدًا مُنْقَضِيَةٌ إذْ لَيْسَ لِلدُّنْيَا حَالٌ تَدُومُ" )
( clartts_0592 "وَيَرْتَكِبُونَ الْمَعَاصِي وَمِنْهُمْ مَنْ يَمْتَنِعُ مِنْ فِعْلِ الطَّاعَاتِ" )
( clartts_0593 "لَهُ مُحَاسَبَةٌ وَقِيلَ لِعِيسَى ابْنِ مَرْيَمَ عَلَيْهِمَا السَّلَامُ" )
( clartts_0594 "أَلَا تُوصِي قَالَ بِمَاذَا أُوصِي وَاَللَّهِ مَا لَنَا شَيْءٌ وَلَا لَنَا عِنْدَ أَحَدٍ شَيْءٌ" )
( clartts_0595 "وَرَوَى أَبُو الزُّبَيْرِ عَنْ سَهْلِ بْنِ سَعْدٍ أَنَّ النَّبِيَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ" )
( clartts_0596 "وَاجْعَلْ زَمَانَ رَخَائِك عُدَّةً لِزَمَانِ بَلَائِك" )
( clartts_0597 "تَرْكُ الْقَبِيحِ بِهِ مِنْ أَكْثَرِ النَّاسِ إحْسَانٌ" )
( clartts_0598 "وَقِيلَ فِي مَنْثُورِ الْحِكَمِ مِنْ الدُّنْيَا عَلَى الدُّنْيَا دَلِيلٌ" )
( clartts_0599 "يَنْفُونَ عَنْهُ تَحْرِيفَ الْغَالِينَ وَانْتِحَالَ الْمُبْطِلِينَ" )
( clartts_0600 "إنَّ أَبْغَضَكُمْ إلَيَّ الثَّرْثَارُونَ الْمُتَفَيْهِقُونَ الْمُتَشَدِّقُونَ" )
( clartts_0601 "وَمَا شَرَفٌ أَنْ يَمْدَحَ الْمَرْءُ نَفْسَهُ وَلَكِنَّ أَعْمَالًا" )
( clartts_0602 "هَذَا الْتَسْحِيلُ مِنْ طَرَفِ لِيبْرِي بٌوكْسْ جَمِيعُ تَسْجِيلاَتِ لِيبْريِ بُوكْسْ فِي الْمَجَالِ الْعَامْ" )
( clartts_0603 "زَاجِرًا لِلضَّمَائِرِ رَقِيبًا عَلَى النُّفُوسِ فِي خَلَوَاتِهَا" )
( clartts_0604 "حَتَّى كَأَنَّهُ قَدْ غَفَرَ وَلَقَدْ أَمْهَلَ حَتَّى كَأَنَّهُ قَدْ أَهْمَلَ" )
( clartts_0605 "فَكُلُّ امْرِئٍ يَصْبُو إلَى مَنْ يُشَاكِلُ" )
( clartts_0606 "نَظَرَ قَلْبِك وَالثَّانِي لَا تُتْبِعْ الْأُولَى الَّتِي وَقَعَتْ سَهْوًا بِالنَّظْرَةِ الثَّانِيَةِ" )
( clartts_0607 "شُحٌّ هَالِعٌ وَجُبْنٌ خَالِعٌ وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_0608 "حُبُّ الثَّنَاءِ وَالِاشْتِهَارِ بِالصِّدْقِ حَتَّى لَا يُرَدَّ عَلَيْهِ قَوْلٌ" )
( clartts_0609 "وَفَضْلَ الْمَغِيبِ عَلَى الْمَشْهَدِ كَرْمْ وَاسْتِوَاؤُهُمَا حِفَاظْ" )
( clartts_0610 "الْمُسَامَحَةِ فِي الْحُقُوقِ وَأَمَّا الْحُقُوقُ فَتَتَنَوَّعُ الْمُسَامَحَةُ فِيهَا نَوْعَيْنِ" )
( clartts_0611 "وَلَا يُجِيبُ إلَّا عُنْفًا كَمَا قَدْ قَالَ الشَّاعِرُ" )
( clartts_0612 "مَنْ رَضِيَ أَنْ يُمْدَحَ بِمَا لَيْسَ فِيهِ فَقَدْ أَمْكَنَ السَّاخِرَ مِنْهُ" )
( clartts_0613 "خَيْرٌ مِنْ أَسَدٍ رَابِضٍ لَازِمٌ وَنَدْبٌ" )
( clartts_0614 "وَمَا تَنَاكَرَ مِنْهَا اخْتَلَفَ وَهَذَا وَاضِحٌ" )
( clartts_0615 "إذَا انْتَقَمُوا أَعْلَنُوا أَمْرَهُمْ وَإِنْ أَنْعَمُوا أَنْعَمُوا" )
( clartts_0616 "هَنَتْ وَأَوْدَعَتْ وَإِذَا اسْتَرَدَّتْ رَفَقَتْ" )
( clartts_0617 "لِمَا فِيهِ مِنْ التَّنْفِيرِ وَإِنَّمَا ذَلِكَ عَلَى طَرِيقِ التَّوْرِيَةِ وَالتَّعْرِيضِ" )
( clartts_0618 "فَكَيْفَ وَإِنْ أَنْصَفْتُهُمْ ظَلَمُونِي تَصَدَّوْا لِأَخْذِهِ" )
( clartts_0619 "رَأَوْا رَجُلًا عَنْ مَوْقِفِ الذُّلِّ أَحْجَمَا أَرَى النَّاسَ مَنْ دَانَهُمْ هَانَ عِنْدَهُمْ" )
( clartts_0620 "لِمَا قَدْ خُصَّ بِهِ الْعَالِمُ مِنْ فَضِيلَةِ الْعِلْمِ" )
( clartts_0621 "وَهُوَ مُجِدٌّ وَيُفْسِحَ لَهُ فِي التَّشَفِّي مَزْحًا وَهُوَ مُحِقٌّ" )
( clartts_0622 "فَلَمْ يَسْتَغْنُوا عَنْ دِينٍ يَتَأَلَّفُونَ بِهِ وَيَتَّفِقُونَ" )
( clartts_0623 "مِنْ عَرْضِك لِيَوْمِ فَاقَتِك وَقَالَ عَبْدُ اللَّهِ بْنُ الْعَبَّاسِ" )
( clartts_0624 "إنَّ الْقَنَاعَةَ وَالْعَفَافَ لَيُغْنِيَانِ عَنْ الْغِنَى" )
( clartts_0625 "وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ إِذْ كُنْتُمْ أَعْدَاءً فَأَلَّفَ بَيْنَ قُلُوبِكُمْ" )
( clartts_0626 "فَإِنَّ ذَلِكَ مَطِيَّةُ النَّوْكَى كَانَ" )
( clartts_0627 "هِيَ الْحَالِقَةُ حَالِقَةُ الدِّينِ لَا حَالِقَةُ الشَّعْرِ" )
( clartts_0628 "الْقُرْآنُ أَصْلُ عِلْمِ الشَّرِيعَةِ" )
( clartts_0629 "فَلَا تَبْغُوا وَإِذَا تَطَيَّرْتُمْ فَامْضُوا وَعَلَى اللَّهِ فَتَوَكَّلُوا" )
( clartts_0630 "وَأُوَسِّعُ لِلْغَنِيِّ وَلِأَنَّ طَاعَةَ اللَّهِ تَعَالَى فِي الْعَمَلِ" )
( clartts_0631 "كَمَنْ أَكْمَلَ عِبَادَةٍ وَأَخَلَّ بِغَيْرِهَا فَهَذَا أَسْوَأُ" )
( clartts_0632 "وَقَالَ بَعْضُ الْحُكَمَاءِ الْمَنُّ مَفْسَدَةُ الصَّنِيعَةِ" )
( clartts_0633 "فَكَيْفَ بِالْإِنْسَانِ الْفَاضِلِ الَّذِي هُوَ أَكْرَمُ الْحَيَوَانِ" )
( clartts_0634 "كَيْفَ يَفْرَحُ وَعَجِبْت لِمَنْ قِيلَ فِيهِ الشَّرُّ" )
( clartts_0635 "مَنْ تَعَلَّمَ عِلْمًا لِغَيْرِ اللَّهِ وَأَرَادَ بِهِ غَيْرَ اللَّه" )
( clartts_0636 "تَارِكِ الْحَزْمِ نَدَمْ الْخِصْب الَّذِي يَعُمُّ النَّاس" )
( clartts_0637 "عَنْ أَنْسَابِ بَعْضِ الْعَرَبِ فَقَالَ عَلَى الْخَبِيرِ سَقَطْتَ" )
( clartts_0638 "غَيْرُ لَائِمِهِمْ قَبْلِي مِنْ النَّاسِ أَهْلُ الْفَضْلِ قَدْ حُسِدُوا" )
( clartts_0639 "لَكِنَّ الرِّزْقَ بِالْحَظِّ وَالْجَدِّ لَا بِالْعِلْمِ وَالْعَقْلِ" )
( clartts_0640 "فْضَلُ النَّاسِ مَنْ لَمْ تُفْسِدْ الشَّهْوَةُ دِينَهُ" )
( clartts_0641 "الْقَوْلُ إغْرَاءً بِفِعْلِ الْمَعَاصِي عِنْدَ قِلَّةِ الْحَيَاءِ" )
( clartts_0642 "لِوَلَدِهِ فِي صِغَرِهِ وَالثَّانِي مَا لَزِمَ الْإِنْسَانَ فِي نَفْسِهِ" )
( clartts_0643 "وَمِنْ الدَّلِيلِ عَلَى الْقَضَاءِ وَكَوْنِهِ" )
( clartts_0644 "الْعُقُوقُ ثَكْلُ مَنْ لَمْ يُثْكَلِ وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_0645 "وَقَالَ شَرُّ مَا فِي الْكَرِيمِ أَنْ يَمْنَعَك خَيْرَهُ" )
( clartts_0646 "وَقَدْ قِيلَ لِبَخِيلٍ لِمَ حَبَسْتَ مَالَك قَالَ لِلنَّوَائِبِ" )
( clartts_0647 "حَصَادُ غَدِك وَبَعْضُ النَّاسِ يَمْتَنِعُونَ عَنْ فِعْلِ الطَّاعَاتِ" )
( clartts_0648 "عَمَّا غَيَّبَ الْمَرْءُ مُخْبِرَا لا سَبِيلَ لِلْإِحَاطَةِ بِالْعِلْمِ" )
( clartts_0649 "شَتَمُونِي وَإِنْ طَرَقَتْنِي نَكْبَةٌ فَكِهُوا بِهَا" )
( clartts_0650 "فَبَعْضُ الْأَمْرِ تُصْلِحُهُ بِبَعْضٍ فَإِنَّ الْغَثَّ يَحْمِلُهُ السَّمِينُ" )
( clartts_0651 "إلَّا فِي الْحَرْبِ وَالْحَلِيمُ إلَّا فِي الْغَضَبِ" )
( clartts_0652 "وَتَقُولُ أَمَّا بَعْدُ وَمِنْ آدَابِ الْكَلَامِ تَرْكُ هَجَرَ الْقَوْلِ" )
( clartts_0653 "وَأَكْثَرُ تَوَاضُعًا وَقَدْ قِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_0654 "الصَّدِيقُ إنْسَانٌ هُوَ أَنْتَ إلَّا أَنَّهُ غَيْرُك" )
( clartts_0655 "أَوْ خَارِجًا عَنْهُ فَيُذَمُّ وَقَالَ قَوْمٌ" )
( clartts_0656 "هَذَاالتَّسْجيلُ مِنْ طَرَفٍ لِيفِرِيبُوكِسْ جَميعُ تَسْجيلاتِ لِيفِرِيبُوكِسْ" )
( clartts_0657 "يَا بَنِي السَّائِبِ قَدْ ضُوِيتُمْ فَانْكِحُوا فِي الْغَرَائِبِ" )
( clartts_0658 "وَصِحَّةِ الْيَقِينِ وَلِذَلِكَ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0659 "يَنِيَ فِي إمْضَائِهِ فَإِنَّ الزَّمَانَ غَادِرٌ" )
( clartts_0660 "وَالْعِنَادَ عَلَيْهَا أَكْثَرُ كَانَ مَعَ أَخْذِهِ بِأَفْضَلِ الْأَخْلَاقِ وَاسْتِعْمَالِهِ لِأَحْسَنِ الْآدَابِ" )
( clartts_0661 "وَطَبَقَةٌ كَالدَّوَاءِ يُحْتَاجُ إلَيْهِ أَحْيَانًا" )
( clartts_0662 "وَنَقْلُهُ إلَى الْأَمْصَارِ فَهَذَا أَلْيَقُ بِأَهْلِ الْمُرُوءَةِ" )
( clartts_0663 "مَا نَحَلَ وَالِدٌ وَلَدَهُ نِحْلَةً أَفْضَلَ مِنْ أَدَبٍ حَسَنٍ" )
( clartts_0664 "اعْلَمْ أَنَّ مِنْ حُسْنِ التَّوْفِيقِ وَإِمَارَاتِ السَّعَادَةِ" )
( clartts_0665 "تَزْدَدْ حُبًّا وَقَالَ لَبِيدٌ تَوَقَّفْ عَنْ زِيَارَةِ كُلِّ" )
( clartts_0666 "لَا يُوصَلُ بِغَيْرِ الدِّينِ إلَيْهَا وَلَا يَصْلُحُ النَّاسُ إلَّا عَلَيْهَا" )
( clartts_0667 "الْمُؤْمِنُ يَغْبِطُ وَالْمُنَافِقُ يَحْسُدُ" )
( clartts_0668 "وَالتَّمَلُّقَ خَدِيعَةً وَمَلْعَبًا فَإِذَا وَجَدُوهُ مَقْبُولًا فِي الْعُقُولِ الضَّعِيفَةِ" )
( clartts_0669 "وَلِلنَّفْسِ آدَابٌ هِيَ تَمَامُ طَاعَتِهَا" )
( clartts_0670 "وَأَمَّلُوا بَعِيدًا وَجَمَعُوا كَثِيرًا فَأَصْبَحَ أَمَلُهُمْ غُرُورًا وَجَمْعُهُمْ ثُبُورًا وَمَسَاكِنُهُمْ قُبُورًا" )
( clartts_0671 "ذَمُّ الْكَذِبِ قَالَ اللَّهُ تَعَالَى وَهُوَ أَصْدَقُ الْقَائِلِينَ" )
( clartts_0672 "أَنْ يَكُونَ كُفْرًا وَقَالَ بَزَرْجَمْهَرُ" )
( clartts_0673 "لِيَبْلُغَ الْغَرَضَ وَلِسَانُهُ نَزِهٌ وَأَدَبُهُ مَصُونٌ" )
( clartts_0674 "وَأَوْلَى الْحَسَنَاتِ بِالْأَجْرِ وَالثَّوَابِ أَمْرُهُ وَنَهْيُهُ" )
( clartts_0675 "اجْعَلْ تَعْلِيمَك دِرَاسَةً لِعِلْمِك وَاجْعَلْ مُنَاظَرَةَ الْمُتَعَلِّمِ" )
( clartts_0676 "بِحَوَادِث دَهْرِهِ حَثَّهُ الْكَرْمُ وَشُكْرُ النِّعَمِ عَلَى الْإِسْعَافِ فِيهَا" )
( clartts_0677 "فَلَيْسَ بِعَقْلٍ تَامٍّ وَقَالَ بَعْضُ الشُّعَرَاءِ" )
( clartts_0678 "وَقَالَ ابْنُ الرُّومِيِّ أَلْمَعِيٌّ يَرَى بِأَوَّلِ رَأْيٍ" )
( clartts_0679 "فَإِذًا قَدْ لَزِمَ مِنْ هَذَيْنِ الْوَجْهَيْنِ سَبْرُ الْإِخْوَانِ قَبْلَ إخَائِهِمْ" )
( clartts_0680 "فَكَيْفَ شُكْرِي بِرَّهُ وَشُكْرُهُ" )
( clartts_0681 "أَحَبُّكُمْ إلَيَّ أَحْسَنكُمْ أَخْلَاقًا الْمُوَطَّئُونَ أَكْنَافًا" )
( clartts_0682 "وَقَالَ بَعْضُ الْحُكَمَاءِ مَنْ عَاشَرَ إخْوَانَهُ بِالْمُسَامَحَةِ" )
( clartts_0683 "وَإِذَا كَانَتْ النُّفُوسُ كِبَارًا تَعِبَتْ فِي مُرَادِهَا الْأَجْسَامُ" )
( clartts_0684 "فَصَارَ مِنْ الْأَخْسَرِينَ أَعْمَالً الَّذِينَ ضَلَّ سَعْيُهُمْ فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ" )
( clartts_0685 "مَنْ كَانَ كَالْغِذَاءِ لِأَنَّ الْحَاجَةَ إلَيْهِ أَعَمُ" )
( clartts_0686 "وَإِنْ كُنْت مِنَّا فَمِنْ سُنَّتِنَا النِّكَاحُ" )
( clartts_0687 "وَكَذَلِكَ مَا ضَاهَاهُ وَقَالَ مَنْصُورٌ النَّمَرِيُّ" )
( clartts_0688 "وَبِتَقَلُّبِ الْأَحْوَالِ وَتَنَاقُصِهَا أَرْذَالًا" )
( clartts_0689 "وَلِذَلِكَ خَلَقَهُمْ يَعْنِي لِلِاخْتِلَافِ بِالْغِنَى وَالْفَقْرِ" )
( clartts_0690 "اسْتَكَدَّهَا الْفِكْرُ وَاسْتَفْرَغَهَا الِاجْتِهَادُ" )
( clartts_0691 "كَمَشْكُورٍ وَمَأْثُومًا كَمَأْجُورٍ وَقَالَ أَبُو الْعَتَاهِيَةِ" )
( clartts_0692 "فَضْلَ الْعِلْمِ إنَّمَا يُعْرَفُ بِالْعِلْمِ" )
( clartts_0693 "لِأَنَّ الْغِذَاءَ أَقْوَمُ لِلنَّفْسِ وَحَيَاتِهَا" )
( clartts_0694 "وَمَنْ اسْتَقَلَّ عَمَلَهُ لَمْ يَقْصُرْ" )
( clartts_0695 "وَالْقَنَاعَةَ بِالْقَسْمِ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0696 "الزُّهْدُ فِيمَا زَادَ عَنِ الْحَاجَة وَسُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ الزُّهْدِ" )
( clartts_0697 "أَلْفُ حَازِمٍ وَكَانَ يُقَالُ إيَّاكَ وَمُشَاوَرَةَ" )
( clartts_0698 "وَثَمَرُهُ مُخْتَلِفٌ فَأَخَذَ هَذَا الْمَعْنَى مَنْصُورُ بْنُ إسْمَاعِيلَ فَقَالَ" )
( clartts_0699 "أَحَدُهُمَا أَنَّ اجْتِمَاعَ هَذِهِ الشُّرُوطِ فِي الْعَدَدِ الْكَثِيرِ" )
( clartts_0700 "يَحْدُثُ بِالتَّجَانُسِ الْمُوَاصَلَةُ بَيْنَ الْمُتَجَانِسَيْنِ" )
( clartts_0701 "لَا تُعْذَرُ إمَّا لِقُبْحِ أَثَرِهَاوَاغْتِرَارِ كَثِيرٍ مِنْ النَّاسِ بِهَا" )
( clartts_0702 "وَآخَر الطِّبّ الْكَيُّ وَمَنْ بَلَغَتْ بِهِ الْأَعْذَارُ إلَى غَايَتِهَا" )
( clartts_0703 "أَهْلُ فَضْلٍ لِقِلَّتِهِمْ وَكَثُرَ إخْوَانُ" )
( clartts_0704 "وَالثَّالِثُ عِمَارَةُ الْبُلْدَانِ بِاعْتِمَادِ مَصَالِحِهَا" )
( clartts_0705 "قَالُوا فَإِنْ كَسَبَهُ مِنْ حِلِّهِ قَالَ يَضَعُهُ فِي غَيْرِ حَقِّهِ" )
( clartts_0706 "وَرَغَّبَ فِي الْبَاقِيَاتِ الصَّالِحَاتِ وَقَالَ" )
( clartts_0707 "هُونَ عَلَيْك نُزُولُ ما لَا مُحِيصٌ عَنْهُ وَالثَّالِثَةُ" )
( clartts_0708 "فَالْحَمْدُ لِلَّهِ الَّذِي نِعَمُهُ لَا تُحْصَى" )
( clartts_0709 "فَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَضْلُ الْعَالِمِ عَلَى الْعَابِدِ" )
( clartts_0710 "مِنْ وُجُوهٍ لَا تَخْفَى عَلَى ذِي لُبٍّ مِنْهَا سُوءُ ظَنِّهِ بِخَالِقِهِ أَنَّهُ لَا يَرْزُقُهُمْ إلَّا مِنْ جِهَتِهِ" )
( clartts_0711 "وَقَالَ بَعْضُ الْعُلَمَاءِ لَا سَمِيرَ كَالْعِلْمِ وَلَا ظَهِيرَ كَالْحِلْمِ" )
( clartts_0712 "الْمَالُ يُعِينُ عَلَى الْمَكْرُومَاتِ" )
( clartts_0713 "وَالضَّالَّةَ لَا تُتْرَكُ لِذِلَّةِ" )
( clartts_0714 "وَقَدْ كَانَ الإَنِّكَارُ لَوْلَا ذَلِكَ مُتَوَجِّهًا عَلَيْهِ" )
( clartts_0715 "وَلِكُلِّ بَابٍ مِنْهُ تَعَلُّقٌ بِمَا قَبْلَهُ" )
( clartts_0716 "أَوْ عَاجِزٍ لَمْ يَخْلُ أَنْ يَكُونَ صَدِيقًا جَاهِلًا أَوْ عَدُوًّا عَاقِلًا" )
( clartts_0717 "ظُهُورُ الْمُكْنَةِ فَإِنَّ مَنْ سَأَلَ مَا لَا يُمْكِنُ فَقَدْ أَحَالَ" )
( clartts_0718 "وَمَنْعُ مَا يَنْبَغِ وَاحِدٌ وَقَالَ سُفْيَانُ الثَّوْرِيُّ" )
( clartts_0719 "وَلِذَلِكَ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0720 "وَإِذَا كَانَ ذَلِكَ كَذَلِكَ فَلَا يَخْلُو حَالُ السَّبَبِ" )
( clartts_0721 "سَقَطَ عَنْهُ كُلْفَةُ اسْتِخْرَاجِهَا وَبَقِيَ عَلَيْهِ مُعَانَاةُ حِفْظِهَا وَاسْتِقْرَارِهَا" )
( clartts_0722 "فَإِذَا لَمْ يَكُنْ لِلرَّدِّ فِي مِثْلِ هَذِهِ الْحَالِ" )
( clartts_0723 "قَالَ اللَّهُ تَعَالَى وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا لِتَسْكُنُوا إلَيْهَا" )
( clartts_0724 "وَعَادَاتِ وَقْتِه فَيُثْبِتَ مَا كَانَ مُوَافِقًا وَيَنْفِيَ مَا كَانَ مُخَالِفًا ثُمَّ يَسْتَمِدَّ خَاطِرَهُ فِي اسْتِنْبَاطِ زِيَادَةٍ وَاسْتِخْرَاجِ فَائِدَةٍ" )
( clartts_0725 "وَأَنْشَدَ بَعْضُ أَهْلِ الْعِلْمِ لَا تُكْثِرْ الشَّكْوَى إلَى الصَّدِيقِ وَارْجِعْ إلَى الْخَالِقِ لَا الْمَخْلُوقِ" )
( clartts_0726 "إنَّ ذَلِكَ مِنْ عَزْمِ الْأُمُورِ إنْ اسْتَطَعْت أَنْ تَعْمَلَ لِلَّهِ بِالرِّضَى فِي الْيَقِينِ فَافْعَلْ" )
( clartts_0727 "وَعُمُومُهُ أَنْ يَسْتَوْجِبَ جَمِيعَ الْأَحْوَالِ" )
( clartts_0728 "وَظَلَمَ فَاسْتَغْفَرَ فَأُولَئِكَ لَهُمْ الْأَمْنُ وَهُمْ مُهْتَدُونَ" )
( clartts_0729 "فَالْتَمَسَهَا النَّاسُ فَوَجَدُوهَا فَقَالُوا لَهُ" )
( clartts_0730 "وَمُضْمِرٌ حُزْنًا لِمَا لَمْ يَكُنْ الصَّبْرُ عَلَى مَا يُخْشَى حُدُوثُهُ" )
( clartts_0731 "وَإِجَالَةِ الْفِكْرِ مَا قَدَحَهُ خَاطِرُهُ" )
( clartts_0732 "وَلَا نَكَادُ نَرَى الْأَغْنِيَاءَ عَلَى أَبْوَابِ الْعُلَمَاءِ" )
( clartts_0733 "كَانَ الْفَسَادُ بِنَظَرِهِ أَكْثَرَ وَالِاخْتِلَافُ" )
( clartts_0734 "وَسَبَبٌ مُوجِبٌ قَالَ الشَّاعِرُ مَا هَوَى إلَّا لَهُ سَبَبُ" )
( clartts_0735 "الْمِسْحَاةَ وَقَالَ خُذْهَا فَإِنَّهَا مَفَاتِيحُ خَزَائِنِ الْأَرْضِ" )
( clartts_0736 "فِي هَؤُلَاءِ الثَّلَاثَةِ تَحَمُّلُ أَثْقَالِهِمْ" )
( clartts_0737 "وَحْيَ الْمَلَاحِظِ خِيفَةَ الرُّقَبَاءِ يَا بُنَيَّ" )
( clartts_0738 "يَمَسُّهُ هَرَمٌ الْخَاتِمَة فَكُنْ" )
( clartts_0739 "فَأَمَّا الْحِرْصُ فَهُوَ شِدَّةُ الْكَدْحِ وَالْإِسْرَافِ فِي الطَّلَبِ" )
( clartts_0740 "لَوْلَا أَنَّهُ مُنًى وَارْتِفَاعٌ لَوْلَا أَنَّهُ اتِّضَاعٌ" )
( clartts_0741 "قُلْت نَعَمْ يَا أَمِيرَ الْمُؤْمِنِينَ فَقَالَ أَمَّا" )
( clartts_0742 "وَاَللَّهِ مَا عَرَفْتُ مِنْ وَجْهِ رَجُلٍ" )
( clartts_0743 "وَقَدْ قَالَ الْحُكَمَاءُ ثَلَاثَةٌ لَا يُعْرَفُونَ إلَّا فِي ثَلَاثَةِ مَوَاطِنَ" )
( clartts_0744 "طَاعَةً لِلَّهِ عَزَّ وَجَلَّ وَلِرَسُولِهِ فَلَمْ يُعْطِفْهُ عَلَيْهِ رَحْمَةٌ وَلَا كَفَّهُ عَنْهُ شَفَقَةٌ" )
( clartts_0745 "وَيُعْلِنُ فِسْقًا وَيَسْتَشْهِدُ بِمَا رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0746 "تَثْقِيلٌ وَمَنْ ثَقَّلَ عَلَى النَّاسِ هَانَ" )
( clartts_0747 "فِي الطِّيَرَةِ رَيْبٌ أَوْ خَامَرَهُ فِيهَا وَهْمٌ مَا رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0748 "لَمْ يَرْضَ بِصُحْبَتِهِ مَنْ فِيهِ خَيْرُ التَّزَوُجِ مِنْ ذَاتِ الْعَقْلِ" )
( clartts_0749 "وَقَلْبٍ لَا يَخْشَعُّ وَعَيْنٍ لَا تَدْمَعُ" )
( clartts_0750 "اسْتِرْقَاقُ الْأَحْرَارِ تُحْدِثُ ذِلَّةً" )
( clartts_0751 "قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0752 "وَيَنْشَأَ عَلَيْهَا فَيَسْهُلَ عَلَيْهِ قَبُولُهَا عِنْدَ الْكِبْرِ لِاسْتِئْنَاسِهِ بِمَبَادِئِهَا فِي الصِّغَرِ" )
( clartts_0753 "رَأْيِهِ عَمِيَتْ عَلَيْهِ الْمَرَاشِدُ وَإِذَا ظَفِرَ بِرَأْيٍ مِنْ خَامِلٍ" )
( clartts_0754 "لِفَضِيلَةِ نَفْسِهِ وَكَرَمِ طَبْعِهِ فَلَا يَجْعَلُ ذَلِكَ ذَرِيعَةً" )
( clartts_0755 "يُسِرَّ غَيْرَ مَا يُظْهِرُ وَلَا يَجْعَلُ قَوْلَ الشَّاعِرِ هَذَا" )
( clartts_0756 "وَلَئِنْ كَانَ الدَّيْنُ رِقًّا فَهُوَ أَسْهَلُ مِنْ رِقِّ الْإِفْضَالِ" )
( clartts_0757 "فَوَصْمَةُ الْمَازِحِ أَنْ يُذْهِبَ عَنْهُ الْهَيْبَةَ وَالْبَهَاءَ" )
( clartts_0758 "ثُمَّ يُرَتِّبُ ذَلِكَ عَلَى أَوَائِلِهِ وَمُقَدِّمَاتِهِ" )
( clartts_0759 "فَضْلُ الْعِلْمِ عَلَى الْمَالِ فَأَمَّا الْمَالُ فَظِلٌّ زَائِلٌ" )
( clartts_0760 "مَنْ جَادَ لَك بِمَوَدَّتِهِ فَقَدْ جَعَلَك عَدِيلَ نَفْسِهِ" )
( clartts_0761 "إنْ زَالَتْ عَنْ الْحُرِّ نِعْمَةٌ وَلَكِنَّ عَارًا أَنْ يَزُولَ التَّجَمُّلُ" )
( clartts_0762 "وَجَهْلُ مَا يَبْتَدِئُ بِهِ الْمُتَعَلِّمُ أَقْبَحُ مِنْ جَهْلِ مَا يَنْتَهِي إلَيْهِ الْعَالِمُ" )
( clartts_0763 "وَلَمْ يَتَخَصَّصُوا انْصَرَفَتْ عَنْهُمْ النُّفُوسُ" )
( clartts_0764 "فَعَلَاتُهَُأأَقُولُ جَارَ عَلَيَّ لَا إنِّي إذًا" )
( clartts_0765 "وَهَذَا النَّوْعُ لَايَكُونُ عَامًّا وَإِنْ كَانَ أَضَرَّهَا" )
( clartts_0766 "وَإِنَّمَا ذَكَرْنَاهَا لِدُخُولِهَا تَحْتَ أَقْسَامِ الْعَطَاءِ" )
( clartts_0767 "وَالْمُتَكَلِّفُ لِلشَّيْءِ مُنَافٍ لَهُ إلَّا أَنْ يَدُومَ عَلَيْهِ مُسْتَحْسِنًا لَهُ فِي الْعَقْلِ" )
( clartts_0768 "بْنِ رِبْعِيٍّ عَنْ أَبِي مَنْصُورٍ الْبَدْرِيِّ" )
( clartts_0769 "أَنَّ فِي بَلَدِك سَاعِيًا وَلَسْتُ أُمْطِرُكَ وَهُوَ فِي أَرْضِك" )
( clartts_0770 "يَا أَبَا حَازِمٍ مَا الْمَخْرَجُ مِمَّا نَحْنُ فِيهِ قَالَ تَنْظُرْ مَا عِنْدَك" )
( clartts_0771 "أَحَدُ البرأين وَكَفُّهُ عَنْ الزِّيَادَةِ إحْدَى الْحُسْنَيَيْنِ" )
( clartts_0772 "أَنَّ شَابًّا كَانَ يُجَالِسُ الْأَحْنَفَ وَيُطِيلُ الصَّمْتَ" )
( clartts_0773 "وَلَوْ قُلْت الْعَافِيَةُ أَحَبُّ إلَيَّ لَعُوفِيت" )
( clartts_0774 "وَقَالَ عَبْ عَبْدُ اللَّهِ بْنُ الْمُبَارَكِ أَيَضْمَنُ لِي فَتًى تَرْكَ الْمَعَاصِي" )
( clartts_0775 "فِي الْمَجَالِ الْعَامْ لِلْمَزِيدِ مِنْ الْمَعْلُومَاتِ أَوْ لِلْمُشَارَكَةِ" )
( clartts_0776 "وَاصْبِرُوا عَنْ عَمَلٍ لَا صَبْرَ لَكُمْ عَلَى عِقَابِهِ" )
( clartts_0777 "عَمَلِهِ لَوْمًا بَلْ رَأَوْا ذَلِكَ أَبْلَغَ" )
( clartts_0778 "وَأَمَّا الشِّبْرُ الثَّالِثُ فَهَيْهَاتَ هَيْهَاتَ" )
( clartts_0779 "وَتَقْتُلُهُ الشَّرْقَةُ لَا يَمْلِكُ لِنَفْسِهِ ضَرًّا" )
( clartts_0780 "فَيَتَوَصَّلُونَ إلَى اجْتِذَابِهِ بِسَبِّهِ" )
( clartts_0781 "وَإِنْ كَانَ لَا يَرَاهَا وَإِنْ أَجْهَدَهَا إلَّا تَبَعًا لِلْمُفْضِلِينَ" )
( clartts_0782 "مَاتَ خَزَّانُ الْأَمْوَالِ وَبَقِيَ خَزَّانُ الْعِلْمِ" )
( clartts_0783 "وَقَوْلُهُ ذَلِكَ خَيْر فِيهِ تَأْوِيلَانِ حَدُهُمَا أَنَّ ذَلِكَ رَاجِعٌ إلَى جَمِيعِ مَا تَقَدَّمَ مِنْ قَوْلِ" )
( clartts_0784 "وَلِلسُّقَّاطِ أَمْثَالٌ فَمِنْهَا تَمَثُّلُهُمْ لِلشَّيْءِ الْمُرِيبِ" )
( clartts_0785 "طَلَبُ الزِّيَادَةِ لِصَرْفِهَا فِي وُجُوهِ الْخَيْرِ" )
( clartts_0786 "وَالْمُسْتَرْسِلُ فِي الْكَلَامِ كَثِيرُ الزَّلَلِ دَائِمُ الْعِثَارِ" )
( clartts_0787 "كَانَا يَأْكُلَانِ الطَّعَامَ عَنْ أَنْ يَكُونَا إلَهَيْنِ" )
( clartts_0788 "امْشِ وَرَاءَ الْأَسَدِ وَلَا تَمْشِ وَرَاءَ الْمَرْأَةِ وَسَمِعَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ امْرَأَةً تَقُولُ هَذَا الْبَيْتَ" )
( clartts_0789 "اسْتَعَانُوا بِالْكِبْرِ لِيُعَظِّمَ" )
( clartts_0790 "وَأَخُو الحَزْمِ حَزْمُهُ لَيْسَ مِمَّا يَزيدُهُ" )
( clartts_0791 "فَإِنْ رَأَى مَحْبَرَةً تَطَيَّرَ مِنْهَا" )
( clartts_0792 "وَهَذَا النَّوْعُ مِنْ الْبَذْلِ قَدْ يَكُونُ لِتِسْعَةِ أَسْبَابٍ" )
( clartts_0793 "وَلَا لِسَائِلٍ تَصَوُّنٌ أَرْبَعَةُ أُمُورٍ" )
( clartts_0794 "إذَا تَمَّ أَمْرٌ بَدَا نَقْصُهُ تَرَقَّبْ" )
( clartts_0795 "فَلَا تَجِدْ لِسَاقِطٍ إلَّا مَثَلًا سَاقِطًا وَتَشْبِيهًا مُسْتَقْبَحًا" )
( clartts_0796 "وَالْأُلْفَةُ عَدَاوَةً وَقَدْ قِيلَ مَنْ وَدَكَّ طَمَعًا فِيك" )
( clartts_0797 "مَا كُنْتَ تُجْرِي الْفَقْرُ يُغَيِرُ الْخَلْقَ" )
( clartts_0798 "وَمُنَازَعَةُ التَّنَافُسِ فَصَارَتْ الْمُنَاسَبَةُ عَدَاوَةً" )
( clartts_0799 "سَمَتْ إلَيْهِ نَفْسُهُ نَبَذَهَا وَقَالَ هَذَا سُرُورٌ" )
( clartts_0800 "فَإِنْ عَاقَبْت فَلَكَ نَظِيرٌ وَإِنْ عَفَوْتَ" )
( clartts_0801 "فَأَخَذَهُ مَحْمُودٌ الْوَرَّاقُ فَقَالَ يَا عَائِبَ الْفَقْرِ" )
( clartts_0802 "عَنْ أَسْبَابٍ تَعُودُ إلَيْهَا وَالْمُكْتَسَبَةُ بِالْقَصْدِ" )
( clartts_0803 "وَفِي غَدٍ بَعْدَ حُسْنِ صُورَتِهِ يَصِيرُ فِي اللَّحْدِ جِيفَةً قَذِرَهْ" )
( clartts_0804 "حَتَّى لَا يَتَنَاسَاهُ وَتَصَوُّرُهُ حَتَّى لَا يَعْزُبَ عَنْهُ" )
( clartts_0805 "لِيُنَاظِرَ عَلَى الْخِلَافِ وَهُوَ لَا يَعْرِفُ الْوِفَاقَ" )
( clartts_0806 "بْنِ مَيْسَرَةَ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0807 "مُرْتَوِي الْإِخْوَانُ كَالْغِذَاءِ وَالدَّوَاء فَإِذَا خَرَجَ مَنْ كَانَ كَالدَّاءِ" )
( clartts_0808 "فَمَا طَعْمٌ أَمَرُّ مِنْ السُّؤَالِ وَلَمْ أَرَ فِي الْخُطُوبِ" )
( clartts_0809 "يَقُولُ اللَّهُ يَا ابْنَ آدَمَ مَا أَنْصَفْتَنِي أَتَحَبَّبُ إلَيْك بِالنِّعَمِةِ" )
( clartts_0810 "مَوْعُوظًا أَحَقَّ بِأَنْ يَكُونَ وَاعِظًا مِنْك" )
( clartts_0811 "فَذَكَرَ فِيهِ خَيْرًا فَقَالُوا يَا رَسُولَ اللَّهِ خَرَجَ مَعَنَا حَاجًّا فَإِذَا نَزَلْنَا" )
( clartts_0812 "أَنْ أَحِلَّ لَك مَا حَرَّمَ اللَّهُ عَلَيْك وَقَالَ ابْنُ السَّمَّاكِ" )
( clartts_0813 "رُوِيَ أَنَّ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ" )
( clartts_0814 "وَالدَّاعِي إلَى ذَلِكَ شَيْئَانِ أَحَدُهُمَا إرْسَالُ الطَّرْفِ" )
( clartts_0815 "فِي مَدْحٍ وَلَا يُسْرِفَ فِي ذَمٍّ وَإِنْ كَانَتْ النَّزَاهَةُ عَنْ الذَّمِّ كَرَمًا وَالتَّجَاوُزُ فِي الْمَدْحِ" )
( clartts_0816 "وَلِذَلِكَ قِيلَ مَنْ تَفَكَّرَ أَبْصَرَ فَأَمَّا" )
( clartts_0817 "هَمَّهُ مُسَاءَتُك وَقَالَ بَعْضُ الْبُلَغَاءِ مَنْ أُولِعَ" )
( clartts_0818 "وَحُكِيَ أَنَّ رَجُلًا قَالَ وَأَعْرَابِيٌّ حَاضِرٌ" )
( clartts_0819 "فَأَنْتَ إذًا وَالْمُقْتِرُونَ سَوَاءُ عَلَى أَنَّ فِي الْأَمْوَالِ يَوْمًا" )
( clartts_0820 "وَكَانَ الْحَسَنُ الْبَصْرِيُّ رَحِمَهُ اللَّهُ تَعَالَى يَقُولُ" )
( clartts_0821 "كَفَضْلِي عَلَى أَدْنَاكُمْ رَجُلً وَقَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ" )
( clartts_0822 "يَا أَبَا إِسْحَاقَ إنِّي وَاثِقٌ مِنْك بِوُدِّكْ" )
( clartts_0823 "خُنْتَنِي فَاتَّهَمْتَنِي غَدَرْتَ بِعَهْدِي عَامِدًا" )
( clartts_0824 "يَكُونُ عَدْلُهُمْ فِيهَا بِالتَّوَسُّطِ فِي حَالَتَيْ التَّقْصِيرِ وَالسَّرَفِ" )
( clartts_0825 "أَمَّا أَنَا فَلَمْ أَرَ قَوْمًا أَمْثَلَ طَرِيقَةً فِي الْبَلَاغَةِ مِنْ الْكُتَّابِ" )
( clartts_0826 "وَعَلَاءٌ لَوْلَا أَنَّهُ بَلَاء وَحُسْنٌ لَوْلَا أَنَّهُ خزْن" )
( clartts_0827 "صَارَ وَعْدُهُ نَكْثًا وَوَعِيدُهُ عَجْزًا وَحُكِيَ أَنَّ سُلَيْمَانَ بْنَ دَاوُد عَلَيْهِمَا السَّلَامُ" )
( clartts_0828 "فَمَنْ خَرَجَ عَنْهَا كَانَ كَلًّا عَلَيْهَا وَإِذْ" )
( clartts_0829 "رَامَ أَمْرًا مُعْوِزًا وَاقْتَرَحَ وَصْفًا" )
( clartts_0830 "فَهَذَا حَالُ اللَّازِمِ وَقَدْ كَانَ ذَوُو الْهِمَمِ الْعَلِيَّةِ" )
( clartts_0831 "لِأَنَّ مَنْ جَهِلَ حَالَ نَفْسِهِ كَانَ لِغَيْرِهَا أَجْهَلَ" )
( clartts_0832 "وَلَكِنْ يُخْمِدُهَا أَنْ لَا تَجِدَ حَطَبًا كَذَلِكَ الْعِلْمُ" )
( clartts_0833 "وَمَا قَبْلَهَا أَسْبَابٌ تَعُودُ إلَيْهَا فَإِنْ اقْتَرَنَ بِهَا الْمُعَاضَدَةُ" )
( clartts_0834 "أَوْ لَمْ يَكُنْ هِبَةٌ فَقَرْضٌ يُسِّرَتْ أَسْبَابُهُ" )
( clartts_0835 "عَالِمٌ فَاجِرٌ وَجَاهِلٌ مُتَعَبِّدٌ وَقِيلَ يَا رَسُولَ اللَّه" )
( clartts_0836 "عِنْدَ مِثْلِي وَكَتَبَ بَعْضُ ذِي الْحُرُمَاتِ إلَى وَالٍذِي الْحُرُمَاتِ إلَى وَالٍ" )
( clartts_0837 "وَذُوَدٌ عَشْرٌ أَحَبُّ أَصْهَارِي إلَيَّ" )
( clartts_0838 "كَالشَّجَرِ الْمُثْمِرِ وَقِيلَ الْأَدَبُ أَحَدُ الْمَنْصِبَيْنِ" )
( clartts_0839 "فَهَلَكَ وَأَهْلَكَ فَلِذَلِكَ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0840 "اخْتِيَارُ صَاحِبِ الْخُلُقْ أَنْ يَكُونَ مَحْمُودَ الْأَخْلَاقِ" )
( clartts_0841 "وَقَالَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ رَضِيَ اللَّهُ عَنْهُ مَا رَأَيْت يَقِينًا لَا شَكَّ فِيهِ" )
( clartts_0842 "دَبَّ إلَيْكُمْ دَاءُ الْأُمَمِ قَبْلَكُمْ الْبَغْضَاءُ وَالْحَسَدُ" )
( clartts_0843 "وَبَسَطَ فِيهِ الرَّهْبَةَ فَلَا خَيْرُهُ يُرْجَى" )
( clartts_0844 "وَفِي الْعِلْمِ زَينٌ وَآفَةُ ذِي الْحِلْمِ طَيْشُ الْغَضَبْ" )
( clartts_0845 "بَعْدَ أَنْ بَدَتْ لَهُمَا وَقَبْلَ سَتْرِهَا وَقَالَتْ طَائِفَةٌ أُخْرَى" )
( clartts_0846 "لَمْ يَجْسُرْ أَحَدٌ عَلَى ظُلْمٍ وَقَالَ بَعْضُ الْأُدَبَاءِ" )
( clartts_0847 "فَلَا تَثِقَنَّ بِكُلِّ أَخِي إخَاءِ" )
( clartts_0848 "لِأَنِّي أَرَى الْمَدْفُونَ يَنْتَظِرُ النَّشْرَا" )
( clartts_0849 "فَأَخَذَهُ بَعْضُ الشُّعَرَاءِ فَقَالَ قَلْبِي إلَى مَا" )
( clartts_0850 "حَالَةُ اسْتِرَاحَةٍ حَالَةُ اسْتِرَاحَةٍ إنْ" )
( clartts_0851 "خَيْرٌ مِنْ أَقْوَى الشِّدَّةِ وَأَقَلُّ التَّأَنِّي خَيْرٌ مِنْ أَكْثَرِ الْعَجَلَةِ" )
( clartts_0852 "عَنْك دُنْيَا أَقْبَلَتْ لَهُمْ وَلَّتْهُمْ عَنْك" )
( clartts_0853 "مُتَوَاصِلِينَ بِالْحَاجَةِ لِأَنَّ ذَا الْحَاجَةِ وُصُولٌ" )
( clartts_0854 "وَخَطِرَاتِ النُّفُوسِ وَلَمْ يَكُنْ لِذِي الْهِمَّةِ السَّاقِطَةِ" )
( clartts_0855 "نَفَقْتُ عِنْدَ إخْوَانِي لِأَنِّي لَمْ أَسْتَعْمِلْ مَعَهُمْ النِّفَاقَ" )
( clartts_0856 "إنَّ الْحَاجَةَ إذَا لَمْ يَتَقَدَّمْهَا وَعْدٌ يَنْتَظِرُ صَاحِبُهُ" )
( clartts_0857 "يُكْفَرُ وَالرَّحِمُ تُقْطَعُ وَالْبَغْيُ عَلَى النَّاسِ" )
( clartts_0858 "وَإِنْ عَرِيَ عَنْ أَحَدِ هَذِهِ الْأَسْبَابِ" )
( clartts_0859 "بِمَا قَدْ كَسَبْتَا وَرُوِيَ أَنَّ الْعَبَّاسَ بْنَ عَبْدِ الْمُطَّلِبِ" )
( clartts_0860 "لِأَنَّ النُّفُوسَ بِالشَّهَوَاتِ آمِرَةٌ وَعَنْ الرُّشْدِ زَاجِرَةٌ" )
( clartts_0861 "وَقَالَ لَا خَيْرَ فِيمَنْ لَا يَسْتَحِي مِنْ النَّاسِ" )
( clartts_0862 "يَصُكُّ أَحَدُكُمْ صَاحِبَهُ بِأَشَدَّ مِنْ الْجَنْدَلِ" )
( clartts_0863 "أَحَدُهُمَا أَنَّ الْعَذَابَ الَّذِي هُوَ مِنْ فَوْقِهِمْ أُمَرَاءُ السُّوءِ" )
( clartts_0864 "فَمِنْهُمْ مَنْ يَسْتَجِيبُ إلَى فِعْلِ الطَّاعَاتِ وَيَكُفُّ عَنْ ارْتِكَابِ الْمَعَاصِي" )
( clartts_0865 "فَكَانَ كَمَا قَالَ الْمُتَنَبِّي يُعْجِبَنَّ حُسْنُ" )
( clartts_0866 "مِنْ الْمَطْعَمِ وَالْمَشْرَبِ بِأَحْوَجِ مِنَّا إلَى الْأَدَبِ" )
( clartts_0867 "وَأُلْفَةٌ جَامِعَةٌ تَنْعَطِفُ الْقُلُوبُ عَلَيْهَا" )
( clartts_0868 "وَكَانَ مُعْتَكِفًا فَمَرَّ بِهِ رَجُلَانِ مِنْ الْأَنْصَارِ" )
( clartts_0869 "فَإِنْ شَاءَ أَعْطَاهُمْ وَإِنْ شَاءَ مَنَعَهُمْ وَأَمَّا الْمَجْلِسُ الْآخَرُ" )
( clartts_0870 "إذَا ذَهَبَ الْحَيَاءُ يَعِيشُ الْمَرْءُ مَا اسْتَحْيَا بِخَيْرٍ" )
( clartts_0871 "إصْغَاءٌ لِتَأْنِيبٍ وَلَا قَبُولٌ" )
( clartts_0872 "وَلَوْ حَسُنَ ظَنُّ الْعَاقِلِ فِي صِحَّةِ نَظَرِهِ لَعَلِمَ مِنْ عِلَلِ الْمَصَالِحِ مَا صَارَ بِهِ" )
( clartts_0873 "وَتُعْطِيَ مَنْ حَرَمَكَ وَتَعْفُوَ عَمَّنْ ظَلَمَكَ" )
( clartts_0874 "وَقِيلَ لَهُ مَا اسْمُ امْرَأَةِ إبْلِيسَ لَعَنَهُ اللَّهُ" )
( clartts_0875 "وَيُسْتَفَادُ بِهِ إنْضَاجُهَا وَإِنْ كَانَتْ" )
( clartts_0876 "طُوِيَتْ أَتَاحَ لَهَا لِسَانَ حَسُودِ لَوْلَا اشْتِعَالُ النَّارِ فِيمَا جَاوَرَتْ" )
( clartts_0877 "فَأَمْسَكَ عَنْ جَوَابِيِ لِأَنَّهُ إنْ أَنْكَرَ كَابَرَ الْمَعْقُولَ" )
( clartts_0878 "وَقَالَ ابْنُ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُمَا فِي قَوْله تَعَالَى" )
( clartts_0879 "أُوصِيك أَنْ تَخْشَى اللَّهَ فِي النَّاسِ وَلَا تَخْشَى النَّاسَ فِي اللَّهِ" )
( clartts_0880 "كَمْ كَافِرٍ بِاَللَّهِ أَمْوَالُهُ تَزْدَادُ أَضْعَافًا عَلَى كُفْرِهِ" )
( clartts_0881 "فَيَنْبَغِي أَنْ نَنْظُرَ لِلَّذِي كَرِهْنَا مِنْهُمْ وَمَرَّ بَعْضُ الزُّهَّادِ بِبَابِ" )
( clartts_0882 "وَيَسْتَحِي فَيَكُفُّ كَمَا قَالَ أَبُو تَمَّامٍ مَنْ كَانَ مَفْقُودَ الْحَيَاءِ فَوَجْهُهُ" )
( clartts_0883 "لِأَنَّ الشَّرْعَ لَا يَرِدُ بِمَا يَمْنَعُ مِنْهُ الْعَقْلُ" )
( clartts_0884 "لِأَنَّ هَذَا مِنْ صِفَاتِ الْحَمِيرِ وَلَكِنْ أَنْ يَكُونَ لِلنَّفْسِ غَلُوبًا" )
( clartts_0885 "وَطَاعَةُ اللَّهِ فِي سِرِّهِ وَجَهْرِهِ وَإِيتَاءُ" )
( clartts_0886 "فَاطْلُبْ لِنَفْسِكَ مَسْكَنَاوَإِيَّاكَ وَالسُّكْنَى بِمَنْزِلِ" )
( clartts_0887 "إلَّا أَنْ وَحَمِيَّةُ الْمُنَاسِبِينَ إنَّمَا تَدْعُو إلَى النُّصْرَةِ" )
( clartts_0888 "لَعَمْرُك مَا يَدْرِي امْرُؤٌ كَيْفَ يَتَّقِي إذَا هُوَ لَمْ يَجْعَلْ لَهُ" )
( clartts_0889 "فَقَالَ يَا بُنَيَّ إنَّ الْآدَابَ مِيرَاثُ الْأَشْرَافِ" )
( clartts_0890 "إنْ قَصُرَ وَهَذْرًا إنْ كَثُرَ وَرُوِيَ أَنَّ أَعْرَابِيًّا تَكَلَّمَ عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَطَوَّلَ فَقَالَ النَّبِيُّ" )
( clartts_0891 "هَلْ يَتَوَقَّعُ أَحَدُكُمْ إلَّا غِنًى مُطْغِيًا" )
( clartts_0892 "فَإِنْ كَثُرَ فَضْلُهُ كَثُرَ حُسَّادُهُ وَإِنْ قَلَّ قَلُّوا" )
( clartts_0893 "الْحَيَاءُ مِنْ اللَّهِ تَعَالَى فَأَمَّا حَيَاؤُهُ مِنْ اللَّهِ تَعَالَى" )
( clartts_0894 "فَهُوَ فِي نَفْسِهِ خَيْرٌ وَقَدْ اخْتَلَفَ أَهْلُ التَّأْوِيلِ فِي قَوْلِهِ قَوْله تَعَالَى" )
( clartts_0895 "فَإِنْ أَعْيَا عَلَيْكُمْ فَبِالصَّرْمِ فَيَرْجُوك" )
( clartts_0896 "وَتَبَيَّنْتُ آثَارَ ذَاكَ فَأَكْثَرَتْ وَتَبَيَّنَتْ آثَارَ ذَاكَ فَأَكْثَرَتْ" )
( clartts_0897 "فَضْلَ الْعِلْمِ إِلا الْجَاهِلُ لِأَنَّ" )
( clartts_0898 "كُلُّ صُلْحٍ وَقَالَ ابْنُ الْجَلَّالِ رُزِقْتُ مَالًا وَلَمْ أُرْزَقْ مُرُوءَتَهُ" )
( clartts_0899 "رَاكِنًا وَبِهِمْ وَاثِقًا وَمِنْ مَكْرِهِمْ عَلَى تَحَرُّزٍ" )
( clartts_0900 "أَحَبَّ إلَيَّ أَلَا وَإِنِّي قَدْ فَسَوْتُ وَهَا أَنَا نَازِلٌ" )
( clartts_0901 "وَلَوْلَاك مَا تَخَالَجَهُ الشَّكُّ فِيهِ وَمِنْهَا" )
( clartts_0902 "وَخُبْثِ نَتَائِجِهِ لِأَنَّهُ يُنْتِجُ النَّمِيمَةَ" )
( clartts_0903 "فَقَدْ جَعَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ التَّعْلِيمَ صَدَقَةً فَقَالَ" )
( clartts_0904 "الَّذِي لَيْسَتْ غَرَائِبُهُ مَعْوِزَةً وَلَا ظَرَائِفُهُ مُعْجِزَةً" )
( clartts_0905 "إذَا كُنْت جَمَّاعًا لِمَالِكَ مُمْسِكًا فَأَنْتَ عَلَيْهِ" )
( clartts_0906 "يَكْتَفِيَ بِالتَّعْرِيضِ وَأَمَّا الشُّرُوطُ الْمُعْتَبَرَةُ فِي الْمَسْئُولِ فَثَلَاثَةٌ" )
( clartts_0907 "فِي مَعُونَةٍ فَهَذَا أَشْرَفُ الْإِخْوَانِ نَفْسًا وَأَكْرَمُهُمْ طَبْعًا" )
( clartts_0908 "لَمَّا قَالَ هَلْ أَتَّبِعُكَ عَلَى أَنْ تُعَلِّمَنِي مِمَّا عُلِّمْت رُشْدًاَ" )
( clartts_0909 "نَافِرَةً عَنْ مَوْضِعِهَا فَلَا تُكْرِهُهَا عَلَى الْقَرَارِ فِي غَيْرِ مَوْضِعِهَا" )
( clartts_0910 "فَمِنْهُمْ شَجَرُ الصَّنْدَلِ وَالْكَافُورِ وَالْبَانُ وَمِنْهُمْ شَجَرٌ" )
( clartts_0911 "حَتَّى انْصَرَفَ عَنْ رُشْدِهِ فَغَوَى وَانْحَرَفَ عَنْ سُنَنِ قَصْدِهِ فَهَوَى" )
( clartts_0912 "فَإِنَّ يَسِيرَ الْمَالِ مَعَ حُسْنِ تَّقْدِيرِ وَإِصَابَةِ التَّدْبِيرِ" )
( clartts_0913 "وَقَالَ بَعْضُ الْأُدَبَاءِ الْعِلْمُ أَفْضَلُ خَلَفٍ" )
( clartts_0914 "لَمْ يُخِلَّ بِوَاجِبِهِ وَلَمْ يُقَصِّرْ فِي فَرْضٍ" )
( clartts_0915 "قِيمَةُ كُلِّ امْرِئٍ مَا يُحْسِنُ فَنَظَّمَهُ شَعْرًا" )
( clartts_0916 "وَلَيْسَ لِمَنْ قَلَّ صَبْرُهُ عَلَى طَاعَةٍ حَظٌّ مِنْ بِرٍّ" )
( clartts_0917 "رَضِيَ اللَّهُ عَنْهُ لَا يَفْرَقُ مُؤْمِنٌ مُؤْمِنَةً" )
( clartts_0918 "مَا يُخَفِّفُ شَجْوَهُ وَيُقِلُّ هَلَعَهُ" )
( clartts_0919 "وَإِنَّمَا يَنْفَعُ سَمْعُ الْآذَانِ إِذَا قَوِيَ فَهْمُ الْقُلُوبِ فِي الْأَبْدَانِ" )
( clartts_0920 "لِأَنَّهَا تُكْسِبُ بِصَادِقِ الْمَيْلِ إخْلَاصًا وَمُصَافَاةً" )
( clartts_0921 "وَلَيْسَتْ بِقَهْرَمَانَةٍ وَلَيْسَ فِي هَذَا الْقَصْدِ تَأْثِيرٌ فِي دِينٍ وَلَا قَدَحٌ فِي مُرُوءَةٍ" )
( clartts_0922 "وَقَالَ بَعْضُ الْحُكَمَاءِ كُلُّ عَقْلٍ لَا يُدَارَى بِهِ الْكُلُّ" )
( clartts_0923 "وَأَيَّامُنَا تُطْوَى وَهُنَّ مَرَاحِلُ" )
( clartts_0924 "قَالُوا بَلَى قَالَ فَفِي هَذَا رَاحَةٌ لَكُمْ فَبَلَغَ ذَلِكَ سُلَيْمَانَ رَضِيَ اللَّهُ عَنْهُ" )
( clartts_0925 "أَمَّا الْمَمْنُوعُ فَلِأَنَّهُ قَدْ فَضَّلَ" )
( clartts_0926 "وَرَوَى أَبُو الدَّرْدَاءِ قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0927 "وَمَا لَمْ يَكُنْ مِنْ الْكَلَامِ مَحْصُورًا كَانَ حَصْرًا" )
( clartts_0928 "حَتَّى يَصِيرَ بِهِ مُسْتَغْنِيًا مِنْ مَنَازِلِ السُّكْنَى" )
( clartts_0929 "قَهْرِ النَّفْسِ عَنْ الْمُحَالِ وَقَهْرُهَا عَنْ هَذِهِ الْأَحْوَالِ يَكُونُ بِثَلَاثَةِ أُمُورٍ" )
( clartts_0930 "عَلَى نَقْلِ خَبَرٍ يَكُونُ كَذِبًا" )
( clartts_0931 "تَقَاطُعًا وَتَعَادِيًا وَكَانَ بَيْنَ الْأَوْسِ وَالْخَزْرَجِ مِنْ الِاخْتِلَافِ وَالتَّبَايُنِ" )
( clartts_0932 "فَإِذَا عَبَثْتَ بِهِ فَأَنْتَ ثَقِيلُ تَعَاوَن الِائْتِلَاف مَقْبُولٌ وتعاون التَّفَضُّل مَكْرُوهٌ" )
( clartts_0933 "وَاحْتَجّْتْ لَهُ وَاحْتَجَّتْ لَهُ" )
( clartts_0934 "لِمَا تَقَدَّمَ مِنْ قَوْلِ الْحُكَمَاءِ أُسْبُرْ" )
( clartts_0935 "وَلَا يُفْقَدُ مَعَهُمَا حَزْمٌ وَقَالَ سَيْفُ بْنُ ذِي يَزَنَ" )
( clartts_0936 "إنَّهُ لَوْ كَانَ لِأَمْرِ الدُّنْيَا مَا كَانَ هَذَا ثُمَّ رَمَى إلَيَّ بِالْقِرْطَاسِ" )
( clartts_0937 "الزُّعَمَاءِ فِي شِعْرِهِ أَوَكُلَّمَا طَنَّ الذُّبَابُ" )
( clartts_0938 "وَمِنْهَا أَنْ يُؤْثِرَ أَنْ يَكُونَ حَدِيثَهُ" )
( clartts_0939 "عِنْدَ الرُّحَمَاءِ مِنْ أُمَّتِي تَعِيشُوا فِي أَكْنَافِهِمْ" )
( clartts_0940 "وَاَللَّهِ يَا رَسُولَ اللَّهِ لَقَدْ صَدَقْت فِي الْأُولَى" )
( clartts_0941 "وَقَالَ بَعْضُ الْحُكَمَاءِ الْجُودُ حَارِسُ الْأَعْرَاضِ" )
( clartts_0942 "لَمْ تُطْعِمِي ثُكْلَ الشَّبَابِ وَلَمْ" )
( clartts_0943 "وَقَدْ كَتَبَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ إلَى سَعْدِ بْنِ أَبِي وَقَّاصٍ" )
( clartts_0944 "عَنْ غَائِبِ الْمَرْءِ فِعْلُهُ كَفَى الْفِعْلُ" )
( clartts_0945 "لَمْ يُخْلَقْ لَهُ بَصَرُ عَمِيَ فَأَتَاهُ آتٍ فِي مَنَامِهِ فَقَالَ" )
( clartts_0946 "الْأَجَلْ الفَرْقُ بَيْنَ الْآمَالِ وَالْأَمَانِي" )
( clartts_0947 "فَهُوَ بِرِيَائِهِ مَحْرُومُ الْأَجْرِ مَذْمُومُ الذِّكْرِ" )
( clartts_0948 "وَالْآبَاءْ لِيَكُن القَصْدُ والعَطَاءُ لِلَّهِ تَعالَى" )
( clartts_0949 "مِنْ مَكْرُوهٍ وَالْقِسْمُ السَّادِسُ الصَّبْرُ عَلَى مَا نَزَلَ مِنْ مَكْرُوهٍ" )
( clartts_0950 "لِأَنَّ مَا أَعْوَزَ فِيهِ مَعْفُوٌّ عَنْهُ وَهَذَا لَا يَنْبَغِي" )
( clartts_0951 "لِأَنَّ مِنَ الْحَيَوانِ ما يَسْتَقِلُّ بِنَفْسِهِ عَنْ جِنْسِهِ" )
( clartts_0952 "وَيَأْنِسُ بِهِ الضَّعِيفُ فَلَيْسَ لِخَائِفٍ رَاحَةٌ" )
( clartts_0953 "صَحِيحًا وَيُعْطِي خَيْرَهُ حِينَ يُكْسَرُ" )
( clartts_0954 "وَأَمَّا طَالِبُ الْعِلْمِ لَدَاعٍ يَدْعُوهُ وَبَاعِثٍ" )
( clartts_0955 "إنَّ فِي صِحَّةِ الْإِخَاءِ مِنْ النَّاسِ فِي خُلَّةِ الْوَفَاءِ لَقِلَّهُ" )
( clartts_0956 "وَتَحَرَّكَتْ فِيهِ أَرْيَحِيَّةُ الْكَرَمِ وَآثَرَ أَنْ يَكُونَ رَأْسًا وَمُقَدَّمًا" )
( clartts_0957 "أَحَدُهَا غَضُّ الطَّرْفِ عَنْ إثَارَتِهَا وَكَفُّهُ عَنْ مُسَاعَدَتِهَا" )
( clartts_0958 "فَهُوَ كَمَنْ قَطَعَ سَفَرًا بِغَيْرِ زَادٍ ظَنًّا بِأَنَّهُ سَيَجِدُهُ فِي الْمَفَازِ" )
( clartts_0959 "وَلَا أَلُومَك إنْ لَمْ يُمْضِهِ قَدَرٌ فَالشَّيْءُ بِالْقَدَرِ الْمَحْتُومِ مَصْرُوفُ" )
( clartts_0960 "وَشُرْبِ الْخُمُورِ الْمُؤَدِّيَةِ إلَى فَسَادِ الْعَقْلِ وَزَوَالِهِ" )
( clartts_0961 "يُوَادُّونَ مَنْ حَادَّ اللَّهَ وَرَسُولَهُ وَلَوْ كَانُوا آبَاءَهُمْ" )
( clartts_0962 "وَقَالَ بَعْضُ الْأُدَبَاءِ مِنْ حُكَمَاءِ الْمُتَقَدِّمِينَ" )
( clartts_0963 "شِدَّةٌ بَعْدَ رَخَاءٍ وَرَخَاءٌ بَعْدَ شِدَّهْ" )
( clartts_0964 "وَقَدْ قَالَ مُحَمَّدُ بْنُ عَلِيٍّ فِي قَوْله تَعَالَى" )
( clartts_0965 "وَذَهَبَ آخَرُونَ إلَى وُجُوبِ ذَلِكَ بِالشَّرْعِ دُونَ الْعَقْلِ" )
( clartts_0966 "مَعَ كَثْرَةِ مَا نَعْصِيهِ فَلَا نَدْرِي أَيَّهُمَا نَشْكُرُ" )
( clartts_0967 "مِنْ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ وَعَيَّرَتْ الْيَهُودُ عِيسَى ابْنَ مَرْيَمَ" )
( clartts_0968 "وَقَالَ ابْنُ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُمَا الْعِلْمُ أَكْثَرُ" )
( clartts_0969 "الْتَمِسُوا الرِّزْقَ فِي خَبَايَا الْأَرْضِ يَعْنِي الزَّرْعَ وَحُكِيَ عَنْ الْمُعْتَضِدِ أَنَّهُ قَالَ" )
( clartts_0970 "رَحِمَهُ اللَّهُ كَيْفَ تَرَى الدُّنْيَا قَالَ شَغَلَنِي تَوَقُّعُ بَلَائِهَا" )
( clartts_0971 "خَمْسَ عَشْرَةَ سَنَةً حَتَّى ضَاقَتْ حِيلَتُهُ وَقَلَّ صَبْرُهُ" )
( clartts_0972 "وَقَالَ آخَرُ تَصَبَّرْتُ مَغْلُوبًا وَإِنِّي" )
( clartts_0973 "وَمِنْ دَوَاعِي الْكَذِبِ التَّعَوُدُ عَلَيْهِ وَمِنْهَا أَنْ تَكُونَ دَوَاعِي الْكَذِبِ" )
( clartts_0974 "وَالْحُكْمُ لِلَّهِ تَعَالَى فَأَخَذَ هَذَا الْمَعْنَى بَعْضُ الشُّعَرَاءِ فَقَالَ" )
( clartts_0975 "رَطْبَا وَاعْلَمْ بِأَنَّ جَفَافَهُ مِمَّا يُعِيدُ السَّهْلَ صَعْبَا" )
( clartts_0976 "أَوْلَادُ عِلَّهُ تَأَلُّفُ الْأَعْدَاءِ يُثْنِيهِمْ عَنِ الْبَغْضَاءِ" )
( clartts_0977 "أَوْ ظُهُورُ الْحُجَّةِ فِي صَلَاحِهِ وَهَذَا مَعَ الِاجْتِمَاعِ أَبْلَغُ" )
( clartts_0978 "أَلَا تَتَزَوَّجُ فَقَالَ إنَّمَا نُحِبُّ التَّكَاثُرَ فِي دَارِ الْبَقَاء" )
( clartts_0979 "يَعْتَرِيهِ الْجَهْلُ بِإِظْهَارِ عِنَادِهِ وَيَبْعَثُهُ اللُّؤْمُ" )
( clartts_0980 "فَاعْلَمْ بِأَنَّ تَمَامَهَا تَعْجِيلُهَا وَالْحَالُ الثَّانِيَةُ" )
( clartts_0981 "وَمِنْهُمْ مَنْ إنْ تَأْمَنْهُ بِدِينَارٍ لَا يُؤَدِّهِ إلَيْك" )
( clartts_0982 "وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمْ الْمُفْلِحُونَ" )
( clartts_0983 "أَوْ قُتِلَ وَعَلَى هَذَا الْوَجْهِ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_0984 "وَقَالَ بَعْضُ الْحُكَمَاءِ الْحِرْصُ مَفْسَدَةٌ لِلدِّينِ وَالْمُرُوءَةِ" )
( clartts_0985 "فَإِنَّ ذَلِكَ ذَمٌّ لَا يُسْتَحْسَنُ وَعَيْبٌ لَا يُرْتَضَى" )
( clartts_0986 "وَالْكِرَامُ أَصْبَرُ نُفُوسًا وَلَيْسَ الصَّبْرُ الْمَمْدُوحُ صَاحِبُهُ أَنْ يَكُونَ الرَّجُلُ قَوِيَّ الْجَسَدِ عَلَى الْكَدِّ وَالْعَمَلِ" )
( clartts_0987 "وَقَالَ الشَّاعِرُ وَلَا تَسْأَلَنَّ امْرَأً حَاجَةً" )
( clartts_0988 "حَكَى عُمَرُ بْنُ حَفْصٍ قَالَ قِيلَ لِلْحَجَّاجِ كَيْفَ وَجَدْت مَنْزِلَك بِالْعِرَاقِ" )
( clartts_0989 "وَالتَّعَفُّفُ وَقَدْ رَوَى سَعِيدُ بْنُ أَبِي سَعِيدٍ عَنْ أَبِي هُرَيْرَةَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_0990 "فَإِنْ تَجَرَّدَ عَنْ غَيْرِهِ مِنْ الْأَسْبَابِ وَعَرِيَ عَمَّا سِوَاهُ مِنْ الْمَوَادِّ" )
( clartts_0991 "وَلْيَعْدِلْ إلَى الْكِنَايَةِ عَمَّا يُسْتَقْبَحُ صَرِيحُهُ وَيُسْتَهْجَنُ فَصِيحُهُ" )
( clartts_0992 "فَإِنَّ لِينَ اللَّفْظِ فِي التَّرْهِيبِ وَخُشُونَتُهُ فِي التَّرْغِيبِ" )
( clartts_0993 "عَلَى أَنَّ ذَا الزَّيْغِ قَدْ يَسْتَفِيقُ وَيَسْتَأْنِفُ الزَّيْغَ" )
( clartts_0994 "لِأَنَّهُ يَحْتَاجُ إلَى مُعَاطَاةٍ فِي تَعَلُّمِهِ" )
( clartts_0995 "وَيُوغِرُ صُدُورَ الْإِخْوَانِ وَحَسْبُك بِذَلِكَ" )
( clartts_0996 "وَلَا يَنْزَعِجَ لَهُ انْزِعَاجًا مُسْتَهْجَنًا وَلْيَكُفَّ عَنْ حَرَكَةٍ تَكُونُ طَيْشًا وَعَنْ حَرَكَةٍ تَكُونُ عِيًّا" )
( clartts_0997 "وَالْوُقُوفُ بَيْنَ حَالَتَيْ سَلَامَةٍ وَسَقَمٍ ذِلَّةُ الْمُرِيبِينَ" )
( clartts_0998 "وَتْرَتِهِ وَكَافَأَ عَلَى مُسَاءَتِهِ" )
( clartts_0999 "عِيٌّ وَإِكْثَارُ يَجِب اخْتِيَارُ الْكَلَامِ" )
( clartts_1000 "وَلَا تَنْكَفُّ عَنْهُ بِقَنَاعَة وَقَدْ رُوِيَ عَنْ عَلِيٍّ" )
( clartts_1001 "وَالضَّرْبُ الثَّالِثُ نْ يَكُونَ مَا أَخَلَّ بِهِ مِنْ مَفْرُوضِ عِبَادَتِهِ" )
( clartts_1002 "نَجَا بِكَ لُؤْمُكَ مَنْجَى الذُّبَابِ حَمَتْهُ مَقَادِيرُهُ" )
( clartts_1003 "أَوْ يَكُونَ قَدْ زَادَ فِيهَا حَتَّى تَجَاوَزَتْ حْدُودَهَا" )
( clartts_1004 "وَمُجَانِبُهْ الْعَفْوُ عَنْ هَفَوَاتِ الْإِخْوَان وَتَسْتُرَ زَلَّاتِهِمْ" )
( clartts_1005 "كُلَّمَا حَسُنَتْ نِعْمَةُ الْجَاهِلِ ازْدَادَ قُبْحًا" )
( clartts_1006 "وَمَنَعَك مَالِهِ وَقِيلَ لِهِنْدِ بِنْتِ الْحَسَنِ" )
( clartts_1007 "نُجْحَهُ لَمْ يَجِدْ سُرُورَهَا لِأَنَّ الْوَعْدَ" )
( clartts_1008 "وَلَمْ يَعْلَمْ شُرُوطَ إجْزَائِهَا" )
( clartts_1009 "وَالْأَنْفَذِ أَمْرًا وَهُوَ أَرْخَصُ الْمَكَارِمِ ثَمَنًا وَأَلْطَفُ الصَّنَائِعِ مَوْقِعًا" )
( clartts_1010 "وَخَيْرُ النَّاسِ أَنْفَعُهُمْ لِلنَّاسِ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1011 "عِنْدَ الشَّيْبَةِ الْأَدَبُ وَقَالَ آخَرُ" )
( clartts_1012 "وَفَرْجَك نَالَا مُنْتَهَى الذَّمِّ أَجْمَعَا" )
( clartts_1013 "لِتَوَحُّدِهِمْ بِفَضِيلَةِ الْعِلْمِ وَلَوْ أَنَّهُمْ نَظَرُوا حَقَّ النَّظَرِ" )
( clartts_1014 "وَأَعْدَاء وَرَوَى ابْنُ الْمُسَيِّبِ عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1015 "أَيُّهَا النَّاسُ فَيَقْبِضُ لِي الْقَبْضَةَ مِنْ التَّمْرِ وَالزَّبِيبِ" )
( clartts_1016 "عَشِيَّةَ يُقْرِي أَوْ غَدَاةَ يُنِيلُ" )
( clartts_1017 "وَأُسَرَاءِ الْحِرْصِ وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1018 "مَنْ كَانَ يَعْلَمُ أَنَّ الْمَوْتَ مُدْرِكُهُ وَالْقَبْرَ مَسْكَنُهُ وَالْبَعْثَ" )
( clartts_1019 "عَلَيْهَا تَنْبُتُ الشَّجَرُ أَدَبُ النَّشْئَةِ وَأَمَّا الْأَدَبُ اللَّازِمُ لِلْإِنْسَانِ عِنْدَ نُشُوئِهِ" )
( clartts_1020 "أَسْقَطَ شُكْرِهِ وَمَنْ أُعْجِبَ بِعَمَلِهِ أُحْبِطَ أَجْرُهُ" )
( clartts_1021 "يَا أَيُّهَا الَّذِينَ آمَنُوا لَا يَسْخَرْ قَوْمٌ مِنْ قَوْمٍ عَسَى أَنْ يَكُونُوا خَيْرًا مِنْهُمْ" )
( clartts_1022 "فَالسَّخَاءُ غِطَاؤُهُ حَدُّ السَّخَاءِ" )
( clartts_1023 "وَهَذَا أَبْلَغُ فِي فَضْلِهِ لِأَنَّ فَضْلَهُ لَا يُعْلَمُ" )
( clartts_1024 "وَمَنْ لَا يَسْتَحِقُّهُ شَرٌّ مِنْ الْخِنْزِيرِ وَحُكِيَ أَنَّ تِلْمِيذًا سَأَلَ عَالِمًا" )
( clartts_1025 "وَمُتَابَعَةِ الشُّهُورِ لِيَكُونَ أَدْوَمَ لِحَالِ الْأُلْفَةِ" )
( clartts_1026 "فَاتَّقُوا اللَّهَ وَأَجْمِلُوا فِي الطَّلَبِ وَلَا" )
( clartts_1027 "قَالُوا بَلْ نَسْمَع صَوَابًا قَالَ فَالزِّيَادَةُ" )
( clartts_1028 "لَيسَ مَنْعُ غَيْرِ ذِي الحَقِّ بُخْل وَمِنْ النَّاسِ مَنْ اعْتَبَرَ الْأَسْبَابِ" )
( clartts_1029 "قَلِيلُهَا مَتَاعٌ وَكَثِيرُهَا بَوَارٌ وَلَقَدْ أَحْسَنَ ابْنُ الرُّومِيِّ فِي هَذَا الْمَعْنَى" )
( clartts_1030 "أَوْ أَخًا قَدْ اسْتَجَدَّ جَفْوَةً وَتَنَكُّرًا" )
( clartts_1031 "وَوَقَفَ بَعْضُ الْمُتَعَلِّمِينَ بِبَابِ عَالِمٍ ثُمَّ نَادَى" )
( clartts_1032 "عَلَى مَرِّ الْأَيَّامِ وَالأَزَّمَانِ وَقَالَ مَهْبُودٌ" )
( clartts_1033 "مَا ذَكَرْنَا مِنْ الِاسْتِحْيَاءِ وَقَدْ قِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_1034 "كَمْ رَأَيْتَ مِنْ الْأَحْيَاءِ ثُمَّ رَأَيْتُهُمْ مَوْتَى" )
( clartts_1035 "إذَا أَفْضَيْتُمْ إلَى نِسَائِكُمْ فَالْكَيْسَ الْكَيْسَ" )
( clartts_1036 "وَاعْلَمْ أَنَّ لِكُلِّ مَطْلُوبٍ بَاعِثًا وَالْبَاعِثُ عَلَى الْمَطْلُوبِ شَيْئَانِ" )
( clartts_1037 "وَوَصَفَ بَعْضُهُمْ الْكَاتِبَ فَقَالَ الْكَاتِبُ مَنْ إذَا أَخَذَ شِبْرًا كَفَاهُ" )
( clartts_1038 "مِنْ أَبْنَاءِ السَّبِيلِ ثُمَّ أَعْلَمَ بِمُشَاهَدَةِ حَرَمِهِ الَّذِي أَنْشَأَ مِنْهُ دِينَهُ وَبَعَثَ فِيهِ رَسُولَهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1039 "رِضَى اللَّهِ تَعَالَى وَفِي الْبِرِّ رِضَى النَّاسِ وَمَنْ جَمَعَ بَيْنَ رِضَى اللَّهِ تَعَالَى وَرِضَى النَّاسِ" )
( clartts_1040 "لِأَبِي حَسَنٌ عَلِيّ ابْنُ مُحَمَّدٍ" )
( clartts_1041 "أَلَا لَا يَرْجُوَنَّ أَحَدٌ إلَّا رَبَّهُ وَلَا يَخَافَنَّ إلَّا ذَنْبَهُ" )
( clartts_1042 "يُرْجِعُنِي مِنْهُ بِحَظِّ يَدٍ صِفْرِ" )
( clartts_1043 "وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلَاثٌ مُنْجِيَاتٌ" )
( clartts_1044 "هَذَيْنِ حَاجَةٌ دَاعِيَةٌ وَلَا نَفْعٌ مَرْجُوٌّ وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ َنَّهُ قَالَ" )
( clartts_1045 "بِتَوْقِيفِ الْعَقْلِ وَلَا بِالِانْقِيَادِ لِلطَّبْعِ" )
( clartts_1046 "وَاخْتَلَفَ النَّاسُ هَلْ وَجَبَ ذَلِكَ بِالْعَقْلِ أَوْ بِالشَّرْعِ" )
( clartts_1047 "وَأُغْمِضُ عَنْهُمْ نَاظِرِي وَجُفُونِي وَأَقْطَعُ أَيَّامِي بِيَوْمِ" )
( clartts_1048 "وَقَالَ بَعْضُ الْفُصَحَاءِ جُودُ الرَّجُلِ يُحَبِّبُهُ إلَى أَضْدَادِهِ" )
( clartts_1049 "فَعَاقِلٌ فَطِنٌ أَعْيَتْ مَذَاهِبُهُ وَجَاهِلٌ خَرِقٌ تَلْقَاهُ مَرْزُوقَا" )
( clartts_1050 "وَقَدْ كَانَتْ قُرَيْشٌ مَعَ مَا كَانُوا عَلَيْهِ مِنْ وُفُورِ الْعَقْلِ وَصِحَّةِ الْأَلْبَابِ" )
( clartts_1051 "جِلْوَتُهُ حَتَّى يَلِجَّ بِهِ" )
( clartts_1052 "فِي الْكَلَامِ فَنَضَّرَ اللَّهُ وَجْهَ امْرِئٍ أَوْجَزَ فِي كَلَامِهِ" )
( clartts_1053 "أَشْخَصَهُ عَنْهَا مَكْرُوهٌ وَإِنْ سَكَنَ مِنْهَا إلَى إينَاسٍ" )
( clartts_1054 "مِنْ أَسْرِ الِامْتِنَانِ طَلِيقًا وَمِنْ رِقِّ الْإِحْسَانِ وَعُبُودِيَّتِهِ عَتِيقًا" )
( clartts_1055 "كَانَ يَأْلَفُ عِشْرَتَهُمْ فَلَمْ يُجِبْهُمْ" )
( clartts_1056 "وَأَحْلِفُ لِلْمُسْتَخْبِرِ وَقَالَ بَعْضُ الشُّعَرَاءِ" )
( clartts_1057 "وَقَالَ بَعْضُ الْأُدَبَاءِ رُبَّ حَظٍّ أَدْرَكَهُ غَيْرُ طَالِبِهِ" )
( clartts_1058 "مَا يَلْزَمُ التَّحَرُّزُ مِنْهُ لِبُعْدِ الْخَيْرِ عَنْهُ" )
( clartts_1059 "وَيَدْفَعُ عَنْهَا عِقَابًا كَانَ مِنْ سُوءِ الِاخْتِيَارِ بَعِيدًا" )
( clartts_1060 "وَارْتَضَيْتَ وَتِيرَتَهُ وَعَرَفْتَ فَضْلَهُ وَبَطَنْتَ عَقْلَهُ" )
( clartts_1061 "وَسُوءُ الظَّنِّ وَالْحَسَدُ فَإِذَا تَطَيَّرْت فَلَا تَرْجِعْ" )
( clartts_1062 "وَظَنَّ أَنَّهُ لِتَجَافِي النَّاسِ عَنْهُ حِمًى يُتَّقَى وَرُتْبَةً تُرْتَقَى" )
( clartts_1063 "وَلَا مَا يُبْدِيهِ مِنْ الْعِفَّةِ غُرُورًا فَيَنْهَتِكَ الزُّورُ وَيَنْكَشِفُ الْغُرُورُ" )
( clartts_1064 "وَيَخْلُفُهَا عَلَى وَرَثَتِهِ مَعَ شِدَّةِ ظَنِّهِ عَلَى نَفْسِهِ" )
( clartts_1065 "وَلَكِنْ نَدَبَهُ إلَى أَخْذِ الْبُلْغَةِ مِنْهَا وَعَلَى هَذَا الْمَعْنَى قَالَ" )
( clartts_1066 "أَكْثَرُ إشْفَاقًا وَالْأُمَّهَاتُ أَكْثَرُ إشْفَاقًا وَأَوْفَرُ حُبًّا لِمَا بَاشَرْنَ مِنْ الْوِلَادَةِ" )
( clartts_1067 "ثُمَّ أَكَّدَ اللَّهُ زَوَاجِرَهُ بِإِنْكَارِ الْمُنْكِرِينَ لَهَا" )
( clartts_1068 "وَقَالَ أَبُو حَازِمٍ إنَّ الدُّنْيَا غَرَّتْ أَقْوَامًا فَعَمِلُوا فِيهَا بِغَيْرِ الْحَقِّ" )
( clartts_1069 "لَا يُمْكِنُ أَنْ يُرَجَّحَ فِيهِ أَوْلَى الْأُمُورِ" )
( clartts_1070 "ابْنِ زَيْدٍ فَأَوْجَبَ بِهَذِهِ الْآيَةِ سَتْرِ الْعَوْرَةِ الَّتِي" )
( clartts_1071 "وَقِيلَ فِي مَنْثُورِ الْحِكَمِ مَنْ لَزِمَ الرُّقَادَ" )
( clartts_1072 "لَا يَجِدُ فِيهَا بُلْغَةً وَلَا يُدْرِكُ مِنْهَا حَاجَةً" )
( clartts_1073 "ذُو الْتَوَانِي نِهَايَةُ الْمَقْطَعْ" )
( clartts_1074 "وَالْجَاهِلُ اللَّئِيمُ عَدُوُّ كُلِّ أَحَدٍ إلَّا مَنْ نَفَعَهُ" )
( clartts_1075 "مَنْ أُعْجِبَ بِرَأْيِهِ لَمْ يُشَاوِرْ وَمَنْ اسْتَبَدَّ بِرَأْيِهِ كَانَ مِنْ الصَّوَابِ بَعِيدًا" )
( clartts_1076 "يُزَيِّنُ كُلَّ أَحَدٍ إلَّا السُّعَاةَ فَإِنَّ السَّاعِيَ أَذَمُّ" )
( clartts_1077 "الْوَلَدُ مَبْخَلَةٌ مَجْهَلَةٌ مَجْبَنَةٌ مَحْزَنَةٌ" )
( clartts_1078 "وَالْمُقَلِّلُ فِي الزَّمَانِ الطَّوِيلِ مُسْتَيْقِظُ الْأَفْكَارِ" )
( clartts_1079 "خَيْرُ إِخْوَانِكَ مَنْ وَاسَاكَ وَخَيْرٌ مِنْهُ مَنْ كَافَاكَ" )
( clartts_1080 "تَضَعُ الْحَدِيثَ عَلَى مَوَاضِعِهِ وَكَلَامُهَا" )
( clartts_1081 "إذَا مَا مِيَاهُ الْأَرْضِ غَارَتْ تَدَفَّقَا" )
( clartts_1082 "أَلَا فَاضْرِبْ بِهِ وَجْهَ الطَّبِيبِ وَلِذَلِكَ عِلَّتَانِ" )
( clartts_1083 "وَلِدَفْعِ عَجْزِهِ حِيَلًا دَلَّهُ عَلَيْهَا بِالْعَقْلِ" )
( clartts_1084 "الكِتابُ والسُّنَّةُ يَضُمّانِ الحَسَدَ اعْلَمْ أَنَّ الْحَسَدَ خُلُقٌ ذَمِيمٌ مَعَ إضْرَارِهِ بِالْبَدَنِ وَفَسَادِهِ لِلدَّيْنِ" )
( clartts_1085 "تَنْبِيهًا لِعُقُولِهِمَا فِي سَتْرِ مَا رَأَيَاهُ مُسْتَقْبَحًا مِنْ سَوْآتِهِمَا" )
( clartts_1086 "وَإِجْمَالَ الطَّلَبِ فِيهِ وَمُجَانَبَةَ الشُّبْهَةِ الْمُمَازَجَةِ لَهُ" )
( clartts_1087 "لَكِنَّنِي عَالِمٌ أَنِّي وَأَنَّكُمْ سَنَسْتَجْدِي خِلَافَ الْحَالَتَيْنِ" )
( clartts_1088 "وَحُكِيَ أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ" )
( clartts_1089 "مَنْ يَزْرَعِ الشَّوْكَ لَا يَحْصُدْ بِهِ عِنَبًا" )
( clartts_1090 "خَيْرُ الْعِلْمِ مَا نَفَعَ وَخَيْرُ الْقَوْلِ مَا رَدَعَ" )
( clartts_1091 "الْحَيَاءُ نِظَامُ الْإِيمَانِ فَإِذَا انْحَلَّ نِظَامُ الشَّيْءِ" )
( clartts_1092 "مُخْرِجُهُ وَأَنَّهُ بَيْنَ جَنَّاتٍ سَتُبْهِجُهُ يَوْمَ الْقِيَامَةِ أَوْ نَارٍ" )
( clartts_1093 "أَمَّا الْآنَ فَأَنْتَ أَعْوَرُ فَإِمَّا أَنْ تَبْرَأَ" )
( clartts_1094 "ادَّهِنُوا يَذْهَبْ الْبُؤْسُ عَنْكُمْ وَالْبَسُوا" )
( clartts_1095 "أَنْ يَعْدَمَ الْأَفَاضِلُ فَضْلَهُمْ أَنْ يَصِيرَ الْفَضْلُ لَهُفَهَذَا الْفَرْقُ بَيْنَ الْمُنَافَسَةِ" )
( clartts_1096 "فِي الدُّنْيَا الْعِلْمُ وَالْعِبَادَةُ وَفِي الْآخِرَةِ الْجَنَّةُ" )
( clartts_1097 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ لِأَبِي ذَرٍّ" )
( clartts_1098 "آفَةٌ تُكْسِبُ الْوِزْرَ فَأَمَّا الْمُكْسِبَةُ لِلْوِزْرِ" )
( clartts_1099 "لَا يُؤَيِسَنَّكَ مِنْ صَدِيقٍ نَبْوَةٌ" )
( clartts_1100 "وَقَدْ رُوِيَ عَنْ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَاأَنَّهَا قَالَتْ يَا رَسُولَ اللَّهِ مَتَى يَعْرِفُ الْإِنْسَانُ رَبَّهُ" )
( clartts_1101 "وَبِحَسَبِ ذَلِكَ وَجَبَ أَنْ يَكُونَ التَّعَطُّفُ عَلَيْهِنَّ" )
( clartts_1102 "وَنُصْحٍ مَبْذُولٍ وَوُدٍّ مَوْفُورٍ وَكَتُومًا بِالطَّبْعِ" )
( clartts_1103 "وَإِذَا اُسْتُعِنْتَ فَأَعِنْ وَإِذَا اُسْتُشِرْتَ فَلَا تُعَجِّلْ حَتَّى تَنْظُرَ" )
( clartts_1104 "التَّبَرُّعُ بِبَذْلِ الْمَالِ فِي الْجِهَاتِ الْمَحْمُودَةِ لِغَيْرِ عِوَضٍ مَطْلُوبٍ" )
( clartts_1105 "فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا فَقَالَ عِكْرِمَةُ" )
( clartts_1106 "فَلَيَأْتِيَنَّكَ رِزْقُك الْمَقْدُورُ وَاعْلَمْ بِأَنَّك آخِذٌ" )
( clartts_1107 "الْعُلَمَاءُ وَرَثَةُ الْأَنْبِيَاءِ لِأَنَّ الْأَنْبِيَاءَ لَمْ يُوَرِّثُوا دِينَارًا وَلَا دِرْهَمًا" )
( clartts_1108 "بَخِلْت بِهِ مِنْ أَهْلِ الْمُرُوءَةِ فِي دَفْعِ مَا يُخَادِعُهُمْ" )
( clartts_1109 "مِنْ حَيْثُ تَوَجُّهُ الذَّمِّ عَلَى تَارِكِهِ وَمُخَالِفًا لَهُ" )
( clartts_1110 "قَلْبُ التَّقِيّ التَّقْصِيرُ بِالتَّكَالِيفِ اغْتِرَارٌ بِالْأَمَلِ فِي الْإمْهَالِ" )
( clartts_1111 "فَدَعْهُ حَيْثُ كَانَ قَبْلَ مَعْرِفَتِهِ وَقَالَ نَصْرُ بْنُ أَحْمَدَ" )
( clartts_1112 "فَقِيلَ لَهُ فِي ذَلِكَ فَقَالَ إذَا اتَّسَعْتُ تَزَيَّنَتْ بِالْجُودِ" )
( clartts_1113 "وَثُلُثًا لِلشَّرَابِ وَثُلُثًا لِلرِّيحِ" )
( clartts_1114 "التَّعْلِيمُ يَعُودُ بِالنَّفْعِ عَلَى الْعَالِمْ ثُمَّ لَهُ بِالتَّعْلِيمِ نَفْعَانِ" )
( clartts_1115 "وَتَكُفُّ بِسَطْوَتِهِ الْأَيْدِي الْمُتَغَالِبَةُ" )
( clartts_1116 "شِرَارُ الرِّجَالِ مَنْ يُسِيءُ فَيُعْذَرُ" )
( clartts_1117 "وَلَمْ يُطَاوِعْهُ الْفَهْمُ ازْدَادَ الْقَلْبُ بِهِ عَمًى" )
( clartts_1118 "فَأَمَّا مَا كَانَ لَازِمًا بِالطَّبْعِ فَهُوَ الْحَذَرُ وَالْإِشْفَاقُ" )
( clartts_1119 "فَإِنَّ ذَا الْحَسَبِ يَخَافُ الْعَوَاقِبَ وَذَا الْمَالِ" )
( clartts_1120 "عَنْ النُّطْقِ بِهِ فَإِنَّك عِنْدَ اسْتِمَاعِ الْقَبِيحِ شَرِيكٌ لِقَائِلِهِ" )
( clartts_1121 "لِأَنَّ النُّفُوسَ قَدْ أَلْهَتْهَا الصَّبْوَةُ" )
( clartts_1122 "وَظُهُورِ شَهْوَتِهِ وَرَوَى الْحَسَنُ عَنْ أَبِي هُرَيْرَةَ" )
( clartts_1123 "الصَّاحِبُ مُنَاسِب وَقَالَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ رَضِيَ اللَّهُ عَنْهُ" )
( clartts_1124 "وَفَنَاءٍ كَالنَّارِ إذَا وَقَعَتْ فِي يَابِسِ الشَّجَرِ" )
( clartts_1125 "قَالَ مِنْ شِرَارِكُمْ الْمَشَّاءُونَ بِالنَّمِيمَةِ الْمُفْسِدُونَ بَيْنَ الْأَحِبَّةِ" )
( clartts_1126 "مَنْ سَاسَ نَفْسَهُ سَادَ نَاسَهُ الْإِعْتِدَالُ" )
( clartts_1127 "يُدْعَى الطَّبِيبُ لِشِدَّةِ الْأَوْصَابِ كَثْرَةُ الْإِخْوَانِ" )
( clartts_1128 "وَالثَّانِيَةَ عَلَيْك وَفِي قَوْلِهِ لَا تُتْبِعْ النَّظْرَةَ النَّظْرَةَ تَأْوِيلَانِ" )
( clartts_1129 "خَافِقَةٍ سُكُونُ وَلَا تَغْفُلْ عَنْ الْإِحْسَانِ فِيهَا" )
( clartts_1130 "الْعُلَمَاءُ يَا عَجَبًا كَيْفَ لَا تَسْتَحْيِي مِنْ كَثْرَةِ مَا لَا تَسْتَحْيِ" )
( clartts_1131 "قَطِيعَةً وَأَفْظَعُ عَجْزٍ عِنْدَهُمْ عَجْزُ حَازِمِ" )
( clartts_1132 "تَضِيعُ وَالسَّبَبُ الثَّالِثُ أَنْ يَكُونَ لِتَعْرِيضٍ" )
( clartts_1133 "فَقَالَ حَسَنُ الِاخْتِصَارِ عِنْدَ الْبَدِيهَةِ وَالْغَزَارَةُ" )
( clartts_1134 "مَعْرِفَةُ الْفَصْلِ مِنْ الْوَصْلِ وَقِيلَ لِلْعَرَبِيِّ فَقَالَ" )
( clartts_1135 "كَمْ رَأَيْنَا الْيَوْمَ حُرًّا لَمْ يَكُ بِالْأَمْسِ حُرَّا" )
( clartts_1136 "أَتَصْبِرُ لِلْبَلْوَى عَزَاءً وَخَشْيَةً فَتُؤْجَرُ أَوْ تَسْلُو سُلُوَّ الْبَهَائِمْ" )
( clartts_1137 "أَنَّهُ قَالَ يَوْمًا لِصَاحِبِه مَازِحًا أَفْقَهُ النَّاسِ" )
( clartts_1138 "فَرَاحِلٌ وَنَازِلٌ وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_1139 "وَعَلَى الْهَمِّ مُصِرٌّ حَتَّى رُبَّمَا أَفْضَى بِصَاحِبِهِ إلَى التَّلَفِ مِنْ غَيْرِ نِكَايَةٍ" )
( clartts_1140 "فَلَا خِلَافَ بَيْنَ النَّاسِ أَنَّ أَمَرَهُمْ بِالْمَعْرُوفِ" )
( clartts_1141 "وَالْبَذَاءُ وَالْبَيَانُ شُعْبَتَانِ مِنْ النِّفَاقِ وَيُشْبِهُ أَنْ يَكُونَ الْعِيُّ فِي مَعْنَى الصَّمْتِ" )
( clartts_1142 "وَأَنْشَدْت لِأَبِي الْفَتْحِ الْبُسْتِيِّ يَا خَادِمَ الْجِسْمِ كَمْ تَشْقَى بِخِدْمَتِهِ" )
( clartts_1143 "وَمَشَاقُّ الْحَمْدِ بَيْنَهُمَا مُسَهَّلَةً مُتَبَيَّنَةً" )
( clartts_1144 "ذَبْحُ وَقَالَ ابْنُ الْمُقَفَّعِ قَابِلُ الْمَدْحَ" )
( clartts_1145 "وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّم أَنَّهُ قَالَ" )
( clartts_1146 "فَكَانَ ذَلِكَ مِنْ نِعَمِهِ عَلَيْنَا وَحُسْنِ نَظَرِهِ إلَيْنَا" )
( clartts_1147 "لَا زَوَالَ لِلنِّعْمَةِ مَعَ الشُّكْرِ وَلَا بَقَاءَ لَهَا مَعَ الْكُفْرِ" )
( clartts_1148 "وَالْبَغْي مُجْلِبَةٌ للنقم وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_1149 "فَقَالَتْ لَا فَقَالَ بَلَى فَانْصَرَفَتْ عَجْلَى إلَى زَوْجِهَا وَجَعَلَتْ تَتَأَمَّلُ عَيْنَيْهِ فَقَالَ لَهَا" )
( clartts_1150 "مَعَ أَعْرَابِيَّةٍ بِمَا تَبَيَّنَ بِهِ حَالُ الْأَمَلِ فِي" )
( clartts_1151 "مَعَ مَا تَكَفَّلَ بِهِ مِنْ إرْشَادِهِ وَوَعَدَ بِهِ مِنْ تَأْيِيدِهِ" )
( clartts_1152 "فَإِنَّ لِكُلِّ نَوْعٍ مِنْ الْعُلُومِ طَرِيقَةً هِيَ أَوْضَحُ مَسْلَكًا" )
( clartts_1153 "وَأَنْشَدَ عَبْدُ اللَّهِ بْنُ الزُّبَيْرِ ثَلَاثَ أَبْيَاتٍ جَامِعَةً لِكُلِّ مَا قَالَتْهُ الْعَرَبُ" )
( clartts_1154 "وَالْإِدْلَالُ فِي الْأَبْنَاءِ فِي مُقَابَلَةِ الْمَحَبَّةِ فِي الْآبَاءِ" )
( clartts_1155 "وَكَانَ أَبُو هُرَيْرَة رَضِيَ اللهُ عَنْهُ يَقُول اللَّهُمَّ إنِّي أَعُوذُ بِك" )
( clartts_1156 "وَلَا خَيْرَ فِي وَاحِدٍ مِنْهُمَا الِاعْتِبَارِ" )
( clartts_1157 "فَإِنَّهُ رِدْءٌ لَك عِنْدَ حَاجَتِكَ وَيَدٌ" )
( clartts_1158 "مَا خَرَجَ عِنْدَهُمْ عَنْ الْمَالِ كَانَ فَارِغًا" )
( clartts_1159 "وَقِيلَ فِي بَعْضِ الْمَوَاعِظِ عَجَبًا لِمَنْ يَخَافُ الْعِقَابَ كَيْفَ" )
( clartts_1160 "بِاتِّبَاعِ الْمَيْسُورِ وَحَذْفِ الْمَعْسُورِ وَتَرْكِ التَّسَلُّطِ بِالْقُوَّةِ" )
( clartts_1161 "كَمَا تَعْرِضُ الْأَمْرَاضُ فِي الْأَجْسَامِ السَّلِيمَةِ فَإِنْ عُولِجَتْ أَقْلَعَتْ وَإِنْ أُهْمِلَتْ" )
( clartts_1162 "وَهُوَ بِالذَّمِّ جَدِيرٌ وَقَدْ قَالَ اللَّهُ تَعَالَى وَلَا تُسْرِفُوا" )
( clartts_1163 "إلَى خَلْقِهِ أَوَامِرَهُ هَزْلًا وَمَزْحًا فَقَدْ عَصَى اللَّهَ وَرَسُولَهُ" )
( clartts_1164 "فَلَمْ تَنَلْهُ مِثْلَ مَا لَا يَخْطُرُ بِبَالِك" )
( clartts_1165 "وَإِنْ رَأَى كِتَابًا أَعْرَضَ عَنْهُ وَإِنْ رَأَى" )
( clartts_1166 "مِنْ قَارُورَةٍ فَارِغَهْ فَكُلُّ" )
( clartts_1167 "وَمُسْتَحِقًّا لِصِدْقِ مَيْلِهِمْ وَمَحَبَّتِهِمْ" )
( clartts_1168 "أَنَّ التَّبَايُنَ فِي النَّاسِ غَالِبٌ وَاخْتِلَافَهُمْ فِي الشِّيَمِ ظَاهِرٌ" )
( clartts_1169 "وَاسْتَظْهَرَ لِنَفْسِهِ وَالشَّقِيُّ مَنْ جَمَعَ لِغَيْرِهِ" )
( clartts_1170 "أَنْ نُوَلِّيَهُ حِمْصَ فَقَالَ رَجُلًا" )
( clartts_1171 "عَلَى مَنْ اتَّخَذَ عِيسَى عَلَى نَبِيِّنَا وَعَلَيْهِ السَّلَامُ" )
( clartts_1172 "أَوْ غَلَطٍ مُذِلٍّ وَرَأَيْت قَوْمًا مِنْهُمْ يَرَوْنَ الِاشْتِغَالَ بِالْمَذَاهِبِ تَكَلُّفًا" )
( clartts_1173 "نَحِيلَا لِأَنَّهُ خَرَجَ مُخْرَجَ الْمُبَالَغَةِ فِي التَّشْبِيهِ وَالِاقْتِدَارِ عَلَى صَنْعَةِ الشَّعْرِ" )
( clartts_1174 "وَاَللَّهِ لِكَأَنِّي أُخَاطَبُ بِهَذَا الشَّعْرِ دُونَ النَّاسِ" )
( clartts_1175 "فَانْظُرْ بِمَا يَنْقَضِي مَجِيءُ غَدِهْ" )
( clartts_1176 "وَمَنِ اسْتَدَامَ الْكَدَّ وَالتَّعَبُ لَمْ يَفِ" )
( clartts_1177 "قَال قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1178 "لِأَنَّ الثَّنَاءَ يَبْعَثُ عَلَى الْبَذْلِ وَحُبَّ الْمَالِ" )
( clartts_1179 "قَالَ خَيْرَ مَنْزِلٍ لَوْ كَانَ اللَّهُ" )
( clartts_1180 "كَتَبَ إلَيْهِ عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ بْنِ طَاهِرٍ" )
( clartts_1181 "وَبَيْنَ أَنْ أَخَافَ اللَّهَ فِيكُمْ فَكَانَ أَنْ أَخَافَ اللَّهَ فِيكُمْ" )
( clartts_1182 "ثَلَاثَةٌ لَا يَسْلَمُ أَحَدٌ مِنْهُنَّ الطِّيَرَةُ" )
( clartts_1183 "فَإِذَا عَاقَهُ الْقَضَاءُ وَخَانَهُ الرَّجَاءُ جَعَلَ الطِّيَرَةَ" )
( clartts_1184 "كَمَا يَقْتَضِيهِ دَلِيلُ الْحَالِ تَعْلِيلًا وَكَشْفًا" )
( clartts_1185 "فَسَدَ وَقَدْ قَالَ الْفَضْلُ بْنُ الْعَبَّاسِ بْنِ عُتْبَةَ" )
( clartts_1186 "وَبِالْحَسْرَةِ هَلَعًا وَلِذَلِكَ قَالَ اللَّهُ تَعَالَى" )
( clartts_1187 "لَمْ يَكُنْ لَهُ هِمَّةٌ فِيمَا يَجِدُ بُدًّا مِنْهُ" )
( clartts_1188 "فَلَمْ تَقُلْهُ وَقَالَ بَعْضُ الشُّعَرَاءِ إذَا مَلَكَ الْقَضَاءُ عَلَيْك أَمْرًا" )
( clartts_1189 "وَلَمْ يُجَاوِزْ تَبَعَاتِ الزِّيَادَةِ إلَّا تَوَخِّي الْحَلَالِ مِنْهَا" )
( clartts_1190 "وَاجْتَبَاهُ لِنُبُوَّتِهِ وَقَدْ كَانَ أَكْثَرُ أَنْبِيَاءِ اللَّهِ تَعَالَى" )
( clartts_1191 "وَكَيْفَ يَسُودُ أَخُو بِطْنَةٍ" )
( clartts_1192 "الْخُطُوبُ فَقُلْت لِمَنْ هَذِهِ الْأَبْيَاتُ قَالَ لِي" )
( clartts_1193 "وَيُقَابِلَ دَوَاعِيَ شِرَّتِهِ بِحَزْمِهِ فَيَرُدُّهَا" )
( clartts_1194 "أَغَرَّكُمْ أَنِّي بِأَحْسَنِ شِيمَةٍ بَصِيرٌ وَأَنِّي بِالْفَوَاحِشِ" )
( clartts_1195 "فَنَفَى أَنْ يَكُونَ غَيْرُ الْعَالِمِ يَعْقِلُ عَنْهُ أَمْرًا" )
( clartts_1196 "مَنْ أَعْطَى فَضْلَ مَالِهِ فَهُوَ خَيْرٌ لَهُ وَمَنْ أَمْسَكَ فَهُوَ شَرٌّ لَهُ" )
( clartts_1197 "وَعَلَى مِثْلِ ذَلِكَ كَانَتْ مَرَاثِي الشُّعَرَاءِ قَالَ الْبُحْتُرِيُّ" )
( clartts_1198 "غَيْرُ خَائِفٍ مَنْ لَمْ يَخَفْ اللَّهَ تَعَالَى هَانَتْ عَلَيْهِ أَوَامِرُهُ" )
( clartts_1199 "إنْعَامَهُ عَلَيْك فِيمَا كَلَّفَك وَإِحْسَانَهُ إلَيْك فِيمَا تَعَبَّدَك" )
( clartts_1200 "وَلِذَلِكَ قِيلَ تَفَقَّهُوا قَبْلَ أَنْ تَسُودُوا" )
( clartts_1201 "نَوْمُ الضُّحَى خَرَقٌ وَالْقَيْلُولَةِ خَلَقٌ وَنَوْمُ الْعَشِيِّ حُمْقٌ" )
( clartts_1202 "مَا تَقُولُ فِي الْعَفْوِ وَالْعُقُوبَةِ قَالَ هُمَا بِمَنْزِلَةِ الْجُودِ وَالْبُخْلِ" )
( clartts_1203 "فَإِنَّ الَّذِي يُؤْذِيك مِنْهُ سَمَاعُهُ وَإِنَّ الَّذِي قَالُوا وَرَاءَك" )
( clartts_1204 "أَنْ يَسْتَوْلِيَ عَلَيْهِ حُبُّ الْمَالِ وَبُعْدُ الْأَمَلِ" )
( clartts_1205 "إلَّا أَنَّ انْكِشَافَهَا وَشِيكًا وَكَانَ الْفَرَجُ مِنْهُ قَرِيبًا" )
( clartts_1206 "فَيَكُونُ مَعَ هَتْكِهِ لِلتَّدْلِيسِ أَقْبَحَ وَلِمَعَرَّةِ الرِّيَاءِ أَفْضَحَ" )
( clartts_1207 "فُصُولًا تَحْتَوِي عَلَى مَا يَلْزَمُ مُرَاعَاتُهُ مِنْ الْأَخْلَاقِ" )
( clartts_1208 "لِلْمُتَبَدِّدِ وَإِنْ كَانَتْ الْأُلْفَةُ بِمَا" )
( clartts_1209 "وَاسْتَرْزِقْ اللَّهَ مِمَّا فِي خَزَائِنِهِ فَإِنَّمَا هُوَ" )
( clartts_1210 "حَتَّى تَشْفَعَ لِلنَّاسِ مِنْ آدَابِ الْعُلَمَاءِ بَذْلُ العِلْمِ لِطَالِبِهِ" )
( clartts_1211 "وَبِقَضَائِهِ يَتَبَرَّمُونَ وَعَنْ ثَوَابِهِ يَرْغَبُونَ" )
( clartts_1212 "وَكَانَ طَبْعُهُ إلَيْهِ مَائِلًا لِيَنْفِيَ عَنْهُ" )
( clartts_1213 "أَعْطِ مَوْلَاك الَّذِي تَطْلُبُ مِنْ طَاعَةِ عَبْدِكْ" )
( clartts_1214 "سَبِيلٌ نَظَرَ فَإِنْ كَانَ التَّأْخِيرُ مُضِرًّا" )
( clartts_1215 "لِأَنَّ الْمُسْرِفَ يُخْطِئُ فِي الزِّيَادَةِ وَالْمُبَذِّرُ يُخْطِئُ فِي الْجَهْلِ" )
( clartts_1216 "إذَا جِئتَ مِنْ كُلِّ الْأُمُورِ بِهِمّةٍ" )
( clartts_1217 "وَمُتَخَطِّيًا إلَى الْتِمَاسِ مَا لَا يَسْتَوْجِبُهُ" )
( clartts_1218 "آلَةٌ مُعْتَمَلَهْ لِلْخَيْرِ وَالشَّرِّ جَمِيعًا" )
( clartts_1219 "تَاجِرُ اللَّهِ فِي أَرْضِهِ وَقَالَ الْبُحْتُرِيُّ إنْ لَمْ يَكُنْ" )
( clartts_1220 "لِلنِّكَاحِ بِهَذِهِ الْمَنْزِلَةِ مِنْ الْأُلْفَةِ فَقَدْ" )
( clartts_1221 "لِأَنَّ النُّفُوسَ عَلَى الْأَمْوَالِ أَشَحُّ وَبِمَا يَتَعَلَّقُ بِالْأَبْدَانِ أَسْمَحُ" )
( clartts_1222 "اعْتَضْت مِنْهَا ثَلَاثَ خِلَالٍ إحْدَاهُنَّ" )
( clartts_1223 "سَعِدَ مَنْ لِسَانُهُ صَمُوتٌ وَكَلَامُهُ قُوتٌ" )
( clartts_1224 "أَحَدُهُمَا لَا تُسْرِفُوا فِي التَّحْرِيمِ وَهَذَا قَوْلُ السُّدِّيِّ" )
( clartts_1225 "أَعْقَبَ ذَلِكَ اسْتِهَانَةً اسْتِهَانَةَ الْآيِسِ" )
( clartts_1226 "فَقَدْ وَكَّلْتُك إلَى فِطْنَتِك وَأَحَلْتُك عَلَى بَصِيرَتِك" )
( clartts_1227 "خَلِّ جَنْبَيْك لِرَامٍ وَامْضِ عَنْهُ بِسَلَامِ" )
( clartts_1228 "كَبَتَ اللَّهُ كُلَّ عَدُوٍّ لَك إلَّا نَفْسَك" )
( clartts_1229 "لَا يَجُوزُ شَرْعًا لِمَا رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1230 "وَأَرْهَنُهُ الْكَفَالَةَ بِالْخَلَاصِ أَطَاعَ اللَّهَ قَوْمٌ وَاسْتَرَاحُوا" )
( clartts_1231 "تَطْلُبُ الْأَكْثَرَ فِي الدُّنْيَا وَقَدْ تَبْلُغُ الْحَاجَةَ" )
( clartts_1232 "وَلَيْسَ لِلرَّاغِبِ فِيهِ قَنَاعَةٌ بِبَعْضِهِ" )
( clartts_1233 "بَائِعُ جَاهِهِ وَمُعَاوِضُ عَلَى نِعَمِ اللَّهِ تَعَالَى" )
( clartts_1234 "إذَا خَلَا مِنْ هَذِهِ الْقَوَاطِعِ فَلَا حُكِيَ أَنَّ الْأَحْنَفَ" )
( clartts_1235 "أَنَّ نَفْسًا لَنْ تَمُوتَ حَتَّى تَسْتَوْفِيَ رِزْقَهَا" )
( clartts_1236 "وَإِلَهِي رَازِقُ الطِّفْلِ الصَّغِيرِ كَمَا أَنَّهُ رَازِقُ الْوَلَدِ الْكَبِيرِ" )
( clartts_1237 "مَنْ يُؤَمِّلُ أَنْ يَعِيشَ غَدًا فَإِنَّهُ يُؤَمِّلُ أَنْ يَعِيشَ أَبَدًا" )
( clartts_1238 "كَمَا يَشَاءُ وَقَالَ آخَرُ إذَا لَمْ تَصُنْ عِرْضًا وَلَمْ تَخْشَ خَالِقًا" )
( clartts_1239 "فَالتَّوَاضُعُ وَمُجَانَبَةُ الْعُجْبِ لِأَنَّ التَّوَاضُعَ عَطُوفٌ" )
( clartts_1240 "قَالَ الْمُفَسِّرُونَ الْحَقُّ فِي هَذَا الْمَوْضِعِ هُوَ اللَّهُ جَلَّ جَلَالَهُ" )
( clartts_1241 "وَالثَّانِي لَا تَأْكُلُوا حَرَامًا فَإِنَّهُ إسْرَافٌ وَهَذَا قَوْلُ" )
( clartts_1242 "وَيَرُدُّهُمْ إلَى الْحِلْمِ وَيَصُدُّهُمْ عَنْ الْأَذِيَّةِ" )
( clartts_1243 "أَنَّهُ قَالَ إذَا وَلَّيْتُمْ أَبَا بَكْرٍ تَجِدُوهُ قَوِيًّا فِي دِينِ اللَّهِ عَزَّ وَجَلَّ ضَعِيفًا فِي بَدَنِهِ" )
( clartts_1244 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ الدُّنْيَا يَوْمَانِ" )
( clartts_1245 "الْعِلْمُ إِنْ لَمْ يُكْسِبُ مَالًا أَكْسَبَ جَمَالًا" )
( clartts_1246 "مِنْ إدْبَارِهَا عَنْك وَلَا دَوْلَةٌ لَك مِنْ إذَالَةٍ مِنْك" )
( clartts_1247 "وَقَالَ بَعْضُ الشُّعَرَاءِ وَسِرُّك مَا كَانَ عِنْدَ امْرِئٍ" )
( clartts_1248 "وَالْحَرْبُ تَرْكَبُ رَأْسَهَا فِي مَشْهَدٍ" )
( clartts_1249 "أَوْشَكْتُمَا أَنْ تَتَفَارَقَا وَحَكَى الْأَصْمَعِيُّ عَنْ بَعْضِ الْأَعْرَابِ أَنَّهُ قَالَ" )
( clartts_1250 "مَا أَحْسَنَ مَا شَكَا أَمْرَهُ بَيْنَ أَضْعَافِ مَدْحِهِ" )
( clartts_1251 "وَإِظْهَارُ الرَّجُلِ سِرَّ غَيْرِهِ أَقْبَحُ مِنْ إظْهَارِهِ سِرَّ نَفْسِهِ" )
( clartts_1252 "أَرَاك امْرَأً تَرْجُو مِنْ اللَّهِ عَفْوَهُ وَأَنْتَ عَلَى مَا لَا يُحِبُّ مُقِيمُ" )
( clartts_1253 "جِسْمُك قَدْ أَفْنَيْته بِالْحِمَى" )
( clartts_1254 "وَقَدْ قَالَ بَعْضُ الْحُكَمَاءِ عَلَيْك بِالْعِلْمِ وَالْإِكْثَارِ مِنْهُ" )
( clartts_1255 "وَمَا شَيْءٌ إذَا فَكَّرْتَ فِيهِ بِأَذْهَبَ لِلْمُرُوءَةِ وَالْجَمَالِ" )
( clartts_1256 "حُكِيَ أَنَّ الْحَجَّاجَ أُتِيَ إلَيْهِ بِقَوْمٍ مِنْ الْخَوَارِجِ" )
( clartts_1257 "وَوَدِدْت أَنِّي لَوْ حَفِظْتهَا فَلَمْ يَبْدَأْ بِشَيْءٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1258 "وَأَمِنَ اللَّهَ وَلِذَلِكَ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1259 "وَأَمَّا الضَّحِكُ فَإِنَّ اعْتِيَادَهُ شَاغِلٌ عَنْ النَّظَرِ فِي الْأُمُورِ الْمُهِمَّةِ" )
( clartts_1260 "وَأَطْفَأَ ثَائِرَتَهُ بِحِلْمِهِ وَلَمْ يَعْدَمْ" )
( clartts_1261 "وَمَنْ اسْتَغْنَى فِيهَا فُتِنَ وَمَنْ افْتَقَرَ فِيهَا حَزِنَ" )
( clartts_1262 "وَإِنَّمَا يُطْفِئُ الْخَيْرُ الشَّرَّ كَمَا يُطْفِئُ الْمَاءُ النَّارَ" )
( clartts_1263 "وَآرَاءٍ مُخْتَلِفَةٍ فَيَحْدُثُ بَيْنَ الْمُخْتَلِفِينَ فِيهِ الْعَدَاوَةَ وَالتَّبَايُنَ" )
( clartts_1264 "وَقَدْ أَنْبَأَ اللَّهُ تَعَالَى فِي كِتَابِهِ الْعَزِيزِ أَخْبَارًا" )
( clartts_1265 "إنَّ السَّعِيدَ لَهُ مِنْ غَيْرِهِ عِظَةٌ وَفِي التَّجَارِبِ تَحْكِيمٌ وَمُعْتَبَرُ" )
( clartts_1266 "وَقَدْ أَجَلَّكَ مَنْ يَعْصِيكَ مُسْتَتِرَا إنْ أَصَرَّ صَدِيق المخطيء عَلَى ذَلِّلْه" )
( clartts_1267 "لَمْ يُمْكِنُ حَصْرُ شُرُوطِهِ لِأَنَّهُ قَدْ يَخْتَلِفُ بِاخْتِلَافِ الْأَحْوَالِ" )
( clartts_1268 "إنَّ أَصْحَابَك قَدْ شَقَّ عَلَيْهِمْ فَقَالُوا أَيُّ مَالٍ نَتَّخِذُ" )
( clartts_1269 "ظَفَرٌ وَمَشُورَةُ غَيْرِ الْحَازِمِ خَطَرٌ" )
( clartts_1270 "لَا يَلْحَقُهُ فِيهَا غَضٌّ وَلَا يَتَدَنَّسُ لَهُ بِهَا عِرْضٌ" )
( clartts_1271 "وَذَهَبَ آخَرُونَ إلَى تَفْضِيلِ الْفَقْرِ عَلَى الْغِنَى لِأَنَّ الْفَقِيرَ تَارِكٌ" )
( clartts_1272 "وَخِلَالُهُ عَلَيْهِ فَمَنْ قَوِيَتْ أَسْبَابُهُ قَوِيَتْ الثِّقَةُ بِهِ" )
( clartts_1273 "وَقَالَ بَعْضُ الْحُكَمَاءِ مَقْتَلُ الرَّجُلِ بَيْنَ فَكَّيْهِ" )
( clartts_1274 "لِمُصْعَبِ بْنِ عَبْدِ اللَّهِ أُجَادِلُ كُلَّ مُعْتَرِضٍ ظَنِينِ" )
( clartts_1275 "ثُمَّ لَوْ اسْتَكْمَلَ الْفَضْلَ طَبْعًا وَفِي الْمُعْوِزِ أَنْ يَكُونَ مُسْتَكْمِلًا" )
( clartts_1276 "مَنْ رَبُّهُ خَلَقَهُ كَيْفَ يُخَلِّي خَلْقَهُ" )
( clartts_1277 "فِي مَوْضِعِ الْحَقِّ غَنِينَا بِالْأَسْرَار عَنْ جَمِيعِ الْخَلْقِ" )
( clartts_1278 "حَبَسَ رَجُلًا ثُمَّ سَأَلَ عَنْهُ بَعْدَ زَمَانٍ فَقَالَ" )
( clartts_1279 "وَبِحَسَبِ الثِّقَةِ بِهِ يَكُونُ الرُّكُونُ إلَيْهِ وَالتَّعْوِيلُ عَلَيْهِ" )
( clartts_1280 "وَرَوَى شَهْرُ بْنُ حَوْشَبٍ عَنْ أُمَامَةَ" )
( clartts_1281 "وَإِنَّمَا الْأَغْلَبُ أَنْ يَكُونَ بَعْضُ فَضَائِلِهِ" )
( clartts_1282 "وَقَدْ قَالَ الشَّاعِرُ إذَا عُرِفَ الْكَذَّابُ بِالْكَذِبِ" )
( clartts_1283 "فَلَمْ نَبْلُغْ مِنْهَا الْمَحْدُودَ فَنَحْنُ كَمَا قَالَ الشَّاعِرُ" )
( clartts_1284 "عُلُوُّ الْهِمَّةِ أَحَدُهُمَا عُلُوُّ الْهِمَّةِ وَالثَّانِي" )
( clartts_1285 "أَخْوَفُ مَا أَخَافُ وَكَانَ يُقَالُ خَيْرٌ مِنْ الْقَوْلِ" )
( clartts_1286 "وَقَالَ بَعْضُ الْأُدَبَاءِ الرُّغْبُ لُؤْمٌ لُؤْمٌ" )
( clartts_1287 "كَمُقَامِي مَعَ مَخْلُوقٍ أَخَافُهُ وَقِيلَ لِأَبِي بَكْرٍ الصِّدِّيقِ رَضِيَ اللَّهُ عَنْهُ فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ" )
( clartts_1288 "إنَّ إنْ صَرَفَ إلَيْهَا نَفْسَهُ قَطَعَتْهُ عَمَّا هُوَ أَهَمُّ مِنْهَا" )
( clartts_1289 "وَالْعُلُومُ وَحْشِيَّةٌ" )
( clartts_1290 "فَلَا تَسْتَكْثِرَنَّ مِنْ الصِّحَابِ فَإِنَّ الدَّاءَ أَكْثَرَ مَا تَرَاهُ" )
( clartts_1291 "لِأَنَّ مَنْ صَلُحَتْ حَالُهُ مَعَ فَسَادِ الدُّنْيَا" )
( clartts_1292 "وَأَلْزَمَهُمْ مُفْتَرَضَاتِهِ وَبَعَثَ إلَيْهِمْ رُسُلَهُ وَشَرَعَ لَهُمْ دِينَهُ" )
( clartts_1293 "وَكُلُّ ذَلِكَ حَثٌّ مِنْهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1294 "وَقَدْ قِيلَ مَنْ بَسَطَهُ الْإِدْلَالُ قَبَضَهُ الْإِذْلَالُ" )
( clartts_1295 "وَاَلَّذِي نَفْسُ مُحَمَّدٍ بِيَدِهِ لَا تُؤْمِنونَ" )
( clartts_1296 "فَإِذَا بَلَغْت مِنْ الْجَوَابِ حَدَّ الِاسْتِحْقَاقِ فَلَا تَزِدْ" )
( clartts_1297 "وَقِيلَ فِي مَنْثُورِ الْحِكَمِ مَنْ أَحَبَّ الْبَقَاءَ" )
( clartts_1298 "وَتَبْقَى مِنْ طُولِ مَا لَا تَبْقَى وَقَالَ بَعْضُ الشُّعَرَاءِ" )
( clartts_1299 "إنْ كَانَتْ يَدُهُ الْعُلْيَا فَقَدْ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1300 "يُسَبَّبْ لَك رِزْقُك وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_1301 "وَأَنَالَتْك مِنْ غَرَائِبِهَا فَتَعْلَمَ أَنَّ الْعَطِيَّةَ فِيهَا مُرْتَجَعَةٌ" )
( clartts_1302 "امْرَأَةِ الرَّجُلِ مِنْ غَيْرِهِ وَسُمُّوا حَفَدَةً" )
( clartts_1303 "فَانْظُرْ إلَى هَؤُلَاءِ كَيْفَ أَبَانُوا بِالْكَلَامِ عَنْ جَهْلِهِمْ" )
( clartts_1304 "فَلَا أَعْلَمُ فِيهِ خَيْرًا وَقِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_1305 "وَيُخْبِرُ بِمَكْنُونَاتِ السَّرَائِرِ لَا يُمْكِنُ اسْتِرْجَاعُ بَوَادِرِهِ" )
( clartts_1306 "وَأَعْجَزَ مِنْهُ مَنْ ضَيَّعَ مَنْ ظَفِرَ بِهِ مِنْهُمْ" )
( clartts_1307 "يُؤَدِّي سِرَّهَا النَّظَرُ وَإِذَا اتَّسَمَ بِالْكَذِبِ نُسِبَتْ إلَيْهِ شَوَارِدُ الْكَذِبِ الْمَجْهُولَةُ" )
( clartts_1308 "وَلَيْسَ مَنْ سَكَتَ فَأَحْسَنَ يَقْدِرُ عَلَى أَنَّ يَتَكَلَّمَ فَيُحْسِنَ" )
( clartts_1309 "وَإِذَا تَكَافَأَ أَهْلُ الْأَدْيَانِ الْمُخْتَلِفَةِ وَالْمَذَاهِبِ الْمُتَبَايِنَةِ" )
( clartts_1310 "أَفْضَلُ الذَّخَائِرِ أَخٌ وَفِيٌّ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_1311 "وَقَوْلُهُ أَنْتَ رَبِّي يَعْنِي رَبِّي وَلَدَك مِنْ التَّرْبِيَةِ" )
( clartts_1312 "وَصَارَتْ تَنْتَقِلُ بِعُمْرَانِهَا إلَى قَرْنٍ بَعْدَ قَرْنٍ" )
( clartts_1313 "حَتَّى إذَا تَهَذَّبَ وَاسْتَكْمَلَ وَكِدْتُ" )
( clartts_1314 "وَقَدْ قَالَ الشَّاعِر وَإِنَّك إنْ أَعْطَيْتَ بَطْنَك هَمَّهُ" )
( clartts_1315 "وُفُورُ الْشَهَوَاتِ تَمْنَعُ الْعِلْمً صَرْفُ الْهَوَى عَنْ ذِي الْهَوَى عَزِيزُ" )
( clartts_1316 "وَقَدْ قَالَ أَبُو الْعَتَاهِيَةِ رَحِمَهُ اللَّهُ أسْمَعُ إِلَى الْأَحْكَامِ تَحْمِلُهَا" )
( clartts_1317 "وَفِي كُلِّ وَقْتٍ مِنْ أَوْقَاتِ دَهْرِهِ عَمَلًا وَتَعَاطَى أَفْعَالَ الْفُكَاهَةِ وَالْبَطَرِ" )
( clartts_1318 "وَمُجَانَبَةِ الْمَعَاصِي قَالَ اللَّهُ تَعَالَى" )
( clartts_1319 "وَكَانَ إنْكَارُ الْمُجَالِسِينَ أَزْجَرَ لَهَا" )
( clartts_1320 "مَثَلُ ضَرَّتَيْنِ إنْ أَرْضَيْت إحْدَاهُمَا" )
( clartts_1321 "أَوْ النَّارُ أَمْسِ وَالْيَوْمَ وَغَداً" )
( clartts_1322 "افْعَلُوا مِنْ الْأَعْمَالِ مَا تُطِيقُونَ فَإِنَّ اللَّهَ لَا يَمَلُّ مِنْ الثَّوَابِ حَتَّى تَمَلُّوا مِنْ الْعَمَلِ" )
( clartts_1323 "وَانْخَفَضَ لَهَا جَنَاحُ الْعُجْبِ تَوْفِيقًا" )
( clartts_1324 "أَوْفَرَ جَزَاءٍ لِفِعْلِهِنَّ وَكِفَاءً لِحَقِّهِنَّ" )
( clartts_1325 "وَإِنْ أُخْرِجَ مِنْهُ شَرٌّ دَخَلَهُ شَرٌ تَدْبِيرُ" )
( clartts_1326 "وَقَدْ قِيلَ الْعَجَبُ لِغَفْلَةِ الْحُسَّادِ عَنْ سَلَامَةِ الْأَجْسَادِ" )
( clartts_1327 "فَانْظُرْ إلَى هَذَا التَّكَلُّفِ التَّكَلُّفِ الشَّنِيعِ وَالتَّعَمُّقِ الْبَشِيعِ" )
( clartts_1328 "وَلَا يَطْلُبُ لِتَرْكِهِ احْتِجَاجًا وَلَا لِلتَّقْصِيرِ فِيهِ" )
( clartts_1329 "هَلْ تُحْسِنُ نُهُوضًا بِشُكْرِهِ إذَا فَعَلْت مَا أَمَرَك" )
( clartts_1330 "تُكَثَّرُ بِهِ الْأَعْدَادَ مَذْهَبُ الْعُقَلَاءِ" )
( clartts_1331 "وَلَمْ يَكُنْ أَحَدُ الْفَرِيقَيْنِ أَعْلَى يَدًا وَأَكْثَرَ عَدَدًا" )
( clartts_1332 "وَأَنْشَدَ بَعْضُ الْأُدَبَاءِ لِعُثْمَانَ بْنِ عَفَّانَ رَضِيَ اللَّهُ عَنْهُ" )
( clartts_1333 "وَهُوَ يَجُودُ بِمَا يَجُودُ بِهِ فَقِيلَ لَهُ فِي ذَلِكَ فَقَالَ" )
( clartts_1334 "وَلَسْتُ أَرَى عِنْدَك مَنْ سَلَفِك إرْثًا الْمُسَامَحَةُ فِي الْأحْوَالِ" )
( clartts_1335 "وَقَدْ قِيلَ لِأَنُوشِرْوَان مَا الَّذِي لَا خَيْرَ فِيهِ" )
( clartts_1336 "تَسِبُّ قُلُوبَهُمْ تَحِيَّتَك الْحُسْنَى" )
( clartts_1337 "إنَّ لِلَّهِ حُرَّاسًا فِي السَّمَاءِ وَحُرَّاسًا فِي الْأَرْضِ" )
( clartts_1338 "وَاقِفًا عَلَى بَابِ السُّلْطَانِ فَقَالَ مِثْلُ هَذَا الدِّرْهَمِ" )
( clartts_1339 "الصَّبْرُ فِيمَا يَتَوَقَّعُ مِنْ رَغْبَةٍ وَالْقِسْمُ الْخَامِسُ" )
( clartts_1340 "مَا صِحَّةٌ مَا صِحَّةٌ أَبَدًا بِنَافِعَةٍ" )
( clartts_1341 "فَلِأَنَّهَا إذَا أَطَاعَتْهُ مَلَكَهَا" )
( clartts_1342 "وَالشَّهْوَةُ الْخَفِيَّةُ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1343 "وَنَحْنُ لَا نَتُوبُ حَتَّى نَمُوتَ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_1344 "فَهَذَا حُكْمُ الْمُؤَازَرَةِ الْمُيَاسَرَةِ" )
( clartts_1345 "وَلَا الْحَيَاءُ أَنْ يَكُفَّ وَقَدْ حُكِيَ أَنَّ رَجُلًا" )
( clartts_1346 "سُوءًا عَنْ اسْتِقْصَاءِ ذَمِّهِ وَلِذَلِكَ قَالَ النَّبِيُّصَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِعَمِّهِ الْعَبَّاسِ" )
( clartts_1347 "لَا يُكَلِّفُ اللَّهُ نَفْسًا إلَّا وُسْعَهَا وَقَالَ" )
( clartts_1348 "وَالْحَسَدُ مَصْرُوفٌ إلَى الضَّرَرِ لِأَنَّ غَايَتَهُ" )
( clartts_1349 "سَأَلْتُك عَنْ مَسْأَلَةٍ فَأَجَبْت عَنْ مَسْأَلَتَيْنِ وَحَكَى الْأَصْمَعِيُّ رَحِمَهُ اللَّهُ تَعَالَى أَنَّ أَعْرَابِيًّا صَلَّى فَأَطَالَ" )
( clartts_1350 "أَصْلٌ لِكُلِّ ذَمٍّ وَسَبَبٌ لِكُلِّ لُؤْمٍ" )
( clartts_1351 "وَجَبَ تَرْكُ الْكِبْرِ وَالْإِعْجَابِ لِأَنَّهُمَا يَسْلُبَانِ الْفَضَائِلَ" )
( clartts_1352 "وَإِنْ لَمْ يَتَوَسَّمْهُمْ وَخَفِيَتْ عَلَيْهِ أَحْوَالُهُمْ" )
( clartts_1353 "يُحِبُّ النَّظَرَ فِي الْعِلْمِ وَيَسْتَحِي فَقَالَ لَهُ" )
( clartts_1354 "يَزْدَجِرُ بِهِ التَّقِيُّ وَمِنْهَا مَا تَكُونُ النُّفُوسُ نَافِرَةً مِنْهَا" )
( clartts_1355 "الْمِزَاحُ وَاخْتِدَاعٌ مِنْ الْهَوَى" )
( clartts_1356 "وَلَمْ يَعْدُهَا إلَى بِدْعَةٍ نهاية المقطع" )
( clartts_1357 "لِأَنَّهُمْ مِنْ غَيْرِ أَهْلِ الْكِتَابِ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1358 "حَتَّى يُقَالَ لَهُ لَا فَهُوَ أَحْمَقُ وَوَصَّى عَبْدُ اللَّهِ بْنُ الْأَهْتَمِ ابْنَهُ فَقَالَ" )
( clartts_1359 "قُصَارَاك فَخُذْ مِنْ دُنْيَاك لِأُخْرَاك وَقَالَ آخَرُ" )
( clartts_1360 "تَخُطُّ عَلَى صُحُفٍ مِنَ الْمَاءِ أَحَرُفَا" )
( clartts_1361 "فَيَزِلَّ وَلَا جَاهِلًا فَيَخُونَ وَالثَّالِثَةُ" )
( clartts_1362 "وَتَعَجُّبًا وَلَيْسَ يُنْكَرُ مِنْهُ الْمَرَّةَ النَّادِرَةَ لِطَارِئٍ" )
( clartts_1363 "فَصَارَ فَرْدًا لَا يُعَانُ بِرَأْيٍ وَلَا يُمَدُّ بِمَشُورَةٍ" )
( clartts_1364 "إذَا ضَاقَتْ بِالْمُذْنِبِ الْمَعْذِرَةُ وَقَالَ بَعْضُ الشُّعَرَاءِ" )
( clartts_1365 "وَقَدْ قِيلَ رُبَّ مَغْبُوطٍ بِمَسَرَّةٍ هِيَ دَاؤُهُ" )
( clartts_1366 "فَقَالَ لَهَا النَّبِيُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَا أَلْوَانُهَا" )
( clartts_1367 "دَهْرِك فِي تَقَلُّبِهِ وَحَالِهْ" )
( clartts_1368 "أَحَدُهَا أَنْ تَكُونَ الزِّيَادَةُ رِيَاءً لِلنَّاظِرِينَ" )
( clartts_1369 "مَانِعَةً وَرَوَى أَبُو سَلَمَةَ عَنْ أَبِي هُرَيْرَةَ أَنَّ رَسُولَ اللَّه صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ" )
( clartts_1370 "وَقَالَ بَعْضُ الْحُكَمَاءِ الطَّبِيبُ مَعْذُورٌ إذَا لَمْ يَقْدِرْ عَلَى دَفْعِ الْمَحْذُورِ" )
( clartts_1371 "جَعَلَ لَهُمْ مَعَ مَا هَدَاهُمْ إلَيْهِ مِنْ مَكَاسِبِهِمْ وَأَرْشَدَهُمْ إلَيْهِ مِنْ مَعَايِشِهِمْ" )
( clartts_1372 "تَضِيقُ بِهِمْ فَسِيحَاتُ الْبِلَادِ إذَا مَا الْمَرْءُ" )
( clartts_1373 "وَالثَّانِيَ أَنْ يُقَصِّرَ فِيهَا وَالثَّالِثَةُ" )
( clartts_1374 "وَإِنْ كَانَ شَيْءٌ مِثْلُهُ فَالْفَقْرُ" )
( clartts_1375 "وَمَنْ لَمْ يُحْسِنْ إلَى تَّائِبِ قَبُحَتْ إسَاءَتُهُ" )
( clartts_1376 "وَأَنَا مُقْبِلٌ عَلَى تَدْرِيسِ أَصْحَابِي إذْ دَخَلَ عَلَيَّ رَجُلٌ مُسِنٌّ قَدْ نَاهَزَ الثَّمَانِينَ أَوْ جَاوَزَهَا" )
( clartts_1377 "فَإِذَا فَرَغْتَ فَانْصَبْ وَإِلَى رَبِّكَ فَارْغَبْ" )
( clartts_1378 "قَصَّار وَلَيْس بباق بُؤْسُهَا وَنَعِيمُهَا" )
( clartts_1379 "وَإِمَّا أَنْ يُقْصَدَ بِهِ تَأَلُّفُ أَعْدَاءٍ مُتَسَلِّطِينَ" )
( clartts_1380 "إذْ جَعَلَ فِيكُمْ أَنْبِيَاءَ وَجَعَلَكُمْ مُلُوكًا" )
( clartts_1381 "قَدْ أَجْهَدَهُ الْحُزْنُ عَلَيْهَا أَوْ حَادِثَةٍ قَدْ كَدَّهُ الْهَمُّ بِهَا" )
( clartts_1382 "اسْتِسْرَارُ كُلِّ وَاحِدٍ بِالْمَشُورَةِ لَيُجِيلَ كُلُّ وَاحِدٍ مِنْهُمْ فِكْرَهُ فِي الرَّأْيِ" )
( clartts_1383 "وَأَحْوَالٍ كُنْت أُخْفِي عَنْهُمْ مَا يَصْحَبُنِي" )
( clartts_1384 "فَيَقُومُ الْعَافُونَ عَنْ النَّاسِ ثُمَّ تَلَا فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُ عَلَى اللَّهِ" )
( clartts_1385 "وَخَيْرُ مَا فِي اللَّئِيمِ أَنْ يَكُفَّ عَنْك شَرَّهُ وَقَالَ ابْنُ الرُّومِيِّ" )
( clartts_1386 "خُلِقَتْ لَكُمْ وَأَنْتُمْ خُلِقْتُمْ لِلْآخِرَةِ فَوَاَلَّذِي نَفْسُ مُحَمَّدٍ بِيَدِهِ" )
( clartts_1387 "وَلَا تَعْمُرُ لَهُ دَارٌ أَقْرَبُ الْأَشْيَاءِ" )
( clartts_1388 "يَعْنِي بِقَوْلِهِ خُذُوا زِينَتَكُمْ الثِّيَابَ" )
( clartts_1389 "وَيَبْعَثُهُ الْخَوْفُ مِنْهُ عَلَى الطَّاعَةِ لَهُ فَيَرْجِعُ إلَى أَدَبِهِ وَيَأْخُذُ" )
( clartts_1390 "فَلَا يَجِدُ لِنَفْسِهِ فِي التَّأْخِيرِ فُسْحَةً" )
( clartts_1391 "وَإِنْ كَانَ الْبُعْدُ عَنْهُمْ مُؤْنِسًا وَمُصْلِحًا" )
( clartts_1392 "الدُّنْيَا إمَّا مُصِيبَةٌ مُوجِعَةٌ وَإِمَّا مَنِيَّةٌ مُفْجِعَةٌ" )
( clartts_1393 "وَقِيلَ لِعَبْدِ الْمَلِكِ بْنِ مَرْوَانَ مَا أَفَدْتَ فِي مِلْكِك هَذَا" )
( clartts_1394 "فَجِسْمَاهُمَا جِسْمَانِ وَالرُّوحُ وَاحِدُ" )
( clartts_1395 "وَلَوْ أَنَّ أَهْلَ الْعِلْمِ صَانُوهُ صَانَهُمْ وَلَوْ عَظَّمُوهُ فِي النُّفُوسِ لَعُظِّمَا" )
( clartts_1396 "فَإِنَّهَا تُمِيتُ الْغَيْرَةَ وَتُحْيِي الْغُرَّةَ" )
( clartts_1397 "وَيَنْزِلُ وَيَنْزِلُ حَيْثُ يَأْمُرُهُ أَهْلُ الرَّأْيِ" )
( clartts_1398 "وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَعْدَى أَعْدَائِك نَفْسُك الَّتِي بَيْنَ جَنْبَيْك" )
( clartts_1399 "يَا عَبَّاسُ يَا عَمَّ النَّبِيِّ إنَّ الْإِمَارَةَ أَوَّلُهَا نَدَامَةٌ" )
( clartts_1400 "عَمْرَو بْنَ الْأَهْتَمِ عَنْ قَيْسِ بْنِ عَاصِمٍ فَمَدَحَهُ" )
( clartts_1401 "تُسَرُّ بِمَا يَفْنَى وَتَفْرَحُ بِالْمُنَى كَمَا سُرَّ بِاللَّذَّاتِ فِي النَّوْمِ حَالِمُ" )
( clartts_1402 "وَحَرَمَ نَفْسَهُ غَنِيمَةَ مُكْنَتِهِ وَفُرْصَةَ قُدْرَتِهِ" )
( clartts_1403 "ذِي الْقُرْبَى صِلَةُ الْأَرْحَامِ وَيَنْهَى عَنْ الْفَحْشَاءِ يَعْنِي الزِّنَا" )
( clartts_1404 "وَقَالَ الْحَسَنُ الْبَصْرِيُّ رَحْمَةُ اللَّهِ عَلَيْهِ أَمْسُ" )
( clartts_1405 "خَدَمَك بَنُوك فَقَالَ أَغْنَانِي اللَّهُ عَنْهُمْ" )
( clartts_1406 "بَعْدَ أَنْ لَمْ يَكُنْ الْعَقْلُ مُوجِبًا لَهُ الْجَمَالُ وَالزِّينَةُ مُسْتَحْسَنٌ بِالْعُرْفِ وَالْعَادَةِ" )
( clartts_1407 "فَكُلُّ قَرِينٍ بِالْمُقَارَنِ يَقْتَدِي" )
( clartts_1408 "وَالْحَمِيَّةُ تَمْنَعُ مِنْ التَّهَضُّمِ وَلَيْسَ لَهَا فِي كَرَاهَةِ الْخُمُولِ نَصِيبٌ" )
( clartts_1409 "وَآلَةُ مِهْنَةٍ وَتَقِفُ عَلَيْهَا الطِّبَاعُ الْخَاسِئَةُ" )
( clartts_1410 "وَلَا سَبِيلَ إلَى إطْرَاحِهِ وَمُتَارَكَتِهِ" )
( clartts_1411 "وَالِاسْتِكْثَارَ مِنْهُ تَخَلُّفًا وَحَاجَّنِي بَعْضُهُمْ عَلَيْهِ فَقَالَ" )
( clartts_1412 "الْفَأْلُ فِيهِ وَأَمَّا الْفَأْلُ فَفِيهِ تَقْوِيَةٌ لِلْعَزْمِ" )
( clartts_1413 "فَيَصِيرُ الْإِنْسَانُ أَسِيرَ شَهَوَاتٍ لَا تَنْقَضِي" )
( clartts_1414 "ازْهَدْ فِي الدُّنْيَا يُحِبُّك اللَّه وَازْهَدْ فِيمَا فِي أَيْدِي النَّاسِ" )
( clartts_1415 "وَإِنْ طَلَبَ بِهِ الْجَزَاءَ كَانَ تَاجِرًا مُتَرَبِّحًا لَا يَسْتَحِقُّ حَمْدًا وَلَا مَدْحًا" )
( clartts_1416 "مِنْ عَدُوٍّ فِي الدِّينِ أَوْ بَاغِي نَفْسٍ أَوْ مَالٍ" )
( clartts_1417 "لِيَسْهُلَ عَلَيْهِمْ فِعْلُهُ وَيَخِفَّ عَنْهُمْ أَدَاؤُهُ" )
( clartts_1418 "وَالرَّئِيسِ مَعَ صَحَابَتِهِ فَعَدْلُهُ فِيهِمْ يَكُونُ بِأَرْبَعَةِ أَشْيَاءَ" )
( clartts_1419 "مَبْلَغَ عِلْمِهِ وَلَا أنْ يَتَجَاوَزَ بِهَا قَدْرَ حَقِّهَا" )
( clartts_1420 "وَتَصَنُّعًا لِلْمَخْلُوقَيْنِ حَتَّى يَسْتَعْطِفَ بِهِ الْقُلُوبَ النَّافِرَةَ" )
( clartts_1421 "أَحَدُهَا دَفْعُ الْأَذَى وَالثَّانِي سَتْرُ الْعَوْرَةِ وَالثَّالِثُ الْجَمَال" )
( clartts_1422 "وَغَوِيصًا اسْتِخْرَاجُهُ فَنَاءٌ لِقُصُورِ هِمَّتِهِ عَلَى مَا أَدْرَكَ" )
( clartts_1423 "وَرُوِيَ عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ كَرَّمَ اللَّهُ وَجْهَهُ" )
( clartts_1424 "أَوْ أَسَفٌ وَقَالَ عُمَرُ الْخَطَّابِ الرَّاحَةُ" )
( clartts_1425 "فَإِنَّ مَنْ تَحَقَّقَ أَمْرًا تَوَطَّأَ لِحُلُولِهِ فَهَانَ عَلَيْهِ عِنْدَ نُزُولِهِ" )
( clartts_1426 "شَيْئَانِ الِاسْتِرْسَالُ وَحُسْنُ الظَّنِّ وَالْمَانِعُ مِنْهُمَا شَيْئَانِ" )
( clartts_1427 "وَقَالَ بَعْضُ الْأُدَبَاءِ مَنْ لَمْ يَصْلُحْ لِأَهْلِهِ" )
( clartts_1428 "حُسْنُ الْخُلُقِ وَحُسْنُ الْجُوَارِ يُعَمِّرَانِ الدِّيَارِ" )
( clartts_1429 "أَغْلَبَ عَلَيْهِ وَقَدْ نَدَبَ اللَّهُ تَعَالَى إلَيْهِ وَحُكِيَ أَنَّ إسْرَائِيلَ بْنَ مُحَمَّدٍ الْقَاضِي" )
( clartts_1430 "أَحَدُهُمَا تَرِبَتْ يَدَاك إنْ لَمْ تَظْفَرْ بِذَاتِ الدِّينِ" )
( clartts_1431 "وَكَانَتْ حُكَمَاءُ الْمُتَقَدِّمِينَ يَرَوْنَ أَنَّ أَنْجَبَ الْأَوْلَادِ" )
( clartts_1432 "لِي إلَيْهِ حَاجَةٌ وَقَالَ الشَّاعِر وَمَا ضَاعَ مَالٌ" )
( clartts_1433 "وَبَانَ لَهُ مِنْ قُوَّةِ خَاطِرِهِ فَإِذَا وَافَقَ اسْتِدْعَاءُ الْعَالِمِ شَهْوَةَ الْمُتَعَلِّمِ" )
( clartts_1434 "فَجَمَعَ بَيْنَ الدَّمِ وَالْعِرْضِ وَإِبْدَاءِ الشُّرُورِ وَإِظْهَارِ الْبَذَاءِ" )
( clartts_1435 "وَلَا يَطْلُبُ الْآخِرَ قَبْلَ الْأَوَّلِ" )
( clartts_1436 "إذَا نَطَقَ السَّفِيهُ فَلَا تُجِبْهُ فَخَيْرٌ مِنْ إجَابَتِهِ السُّكُوتُ" )
( clartts_1437 "الْكَمَالُ فِي ثَلَاثَةٍ الْعِفَّةُ فِي الدِّينِ وَالصَّبْرُ عَلَى النَّوَائِبِ" )
( clartts_1438 "الْبَعِيرِ فَتَتَعَدَّى إلَى جَمِيعِهِ فَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1439 "ثُمَّ نَبْتَهِلْ فَنَجْعَلَ لَعْنَتَ اللَّهِ عَلَى الْكَاذِبِينَ" )
( clartts_1440 "غَدًا ثُمَّ لَا يَعْمَلُ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ َأَنَّهُ قَالَ" )
( clartts_1441 "وَإِنْ كَانَ ذُو الْهِمَّةِ وَقَدْ قَالَ الشَّاعِرُ أَبِيٌّ لَهُ نَفْسَانِ نَفْسٌ زَكِيَّةُ" )
( clartts_1442 "يُقْدِمُ عَلَى ارْتِكَابِ الْمَعَاصِ وَهِيَ أَخْبَثُ أَحْوَالِ الْمُكَلَّفِينَ" )
( clartts_1443 "حَسُودٌ مَرِيضُ الْقَلْبِ يُخْفِي أَنِينَهُ" )
( clartts_1444 "فَرَضِيَ بِالْجَهْلِ أَنْ يَكُونَ مَوْسُومًا بِهِ وَآثَرَهُ عَلَى الْعِلْمِ أَنْ يَصِيرَ مُبْتَدِئًا بِهِ" )
( clartts_1445 "وَإِنْ كَانَ ذَرِيعَةً إلَى كُلِّ مَذَمَّةٍ أَرْبَعَةُ أَخْلَاقٍ" )
( clartts_1446 "وَلَكِنَّهُ الْقَاصِدُ لِدَفْعِ مَا يَرِدُ عَلَيْهِ مِنْ فَاسِدٍ أَوْ صَحِيحٍ" )
( clartts_1447 "غَدَا وَأَنْشَد لِبَعْضِ الشُّعَرَاءِ وَأَيَّام ضَرّ لَا تَدُومُ" )
( clartts_1448 "فَلَا تَبْقَى الْأَخْلَاقُ عَلَى اعْتِدَالٍ وَلَا يُقْدَرُ مَعَهَا عَلَى احْتِمَالٍ" )
( clartts_1449 "لِأَنَّهَا مَحْبُوبَةٌ تَجُورُ إدْلَالًا" )
( clartts_1450 "فِي ثَرْوَةٍ مِنْ قَوْمِهِ وَقَالَ وَهْبٌ لَقَدْ" )
( clartts_1451 "وَقَالَ جَعْفَرُ بْنُ مُحَمَّدٍ كَفَاك مِنْ اللَّهِ نَصْرًا أَنْ تَرَى عَدُوَّك يَعْصِي اللَّهَ فِيك" )
( clartts_1452 "عَلَى الْأُلْفَةِ وَالْعَرَبُ تَقُولُ مَنْ قَلَّ ذَلَّ" )
( clartts_1453 "وَمِنْ النَّاسِ مَنْ يَرَى أَنَّ الْمُسَاهَلَةَ فِي الْعُقُودِ عَجْزٌ" )
( clartts_1454 "وَوَجَبَ أَيْضًا بِالْعَقْلِ أَنْ يَمْنَعَ غَيْرَهُ مِنْهُ لِأَنَّ ذَلِكَ أَدْعَى إلَى مُجَانَبَتِهِ وَأَبْلَغُ فِي مُفَارَقَتِهِ" )
( clartts_1455 "نُصْحُ مَنْ عَلَّمُوهُ وَالرِّفْقُ بِهِمْ وَتَسْهِيلُ السَّبِيلِ عَلَيْهِمْ" )
( clartts_1456 "وَلَجَاجًا فِي الْإِكْثَارِ مِنْهُ قَبُحَ فِي الْعَقْلِ إنْكَارُهُ" )
( clartts_1457 "إنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1458 "وَعِلَّةُ هَذَا الْقَوْلِ ظَاهِرَةٌ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_1459 "وَلْيَحْذَرْ أَنْ يَطْلُبَهُ لِمِرَاءٍ أَوْ رِيَاءٍ" )
( clartts_1460 "وَأَخَفْتَنِي فَخِفْتُ وَلَوْ آمَنْتَنِي" )
( clartts_1461 "هِيَ الْبَلَاغَةُ تَعْرِيف الْبَلَاغَة عِنْد الْأُمَم الْمُخْتَلِفَة" )
( clartts_1462 "وَأَنَّهَا تُقَدَّرُ بِأَوْقَاتٍ لَا تَنْصَرِمُ قَبْلَهَا" )
( clartts_1463 "غَيْرَ أَنَّ فَسَادَ الْوَقْتِ وَتَغَيُّرَ أَهْلِهِ" )
( clartts_1464 "لِمَا فِيهِ مِنْ سَلَامَةِ الْعِرْضِ وَرَاحَةِ الْجَسَدِ وَاجْتِلَابِ الْحَمْدِ" )
( clartts_1465 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ َنَّهُ قَالَ" )
( clartts_1466 "وَقَالُوا مَنْ حَاوَلَ صَدِيقًا يَأْمَنُ زَلَّتَهُ" )
( clartts_1467 "لِي أَرَبُ وَقَدْ أَسَأْتُ فَبِالنُّعْمَى الَّتِي سَلَفَتْ" )
( clartts_1468 "وَالْعُقُولُ لَهَا مُوَافِقَةٌ فَلِذَلِكَ ضَرَبَ اللَّهُ الْأَمْثَالَ فِي كِتَابِهِ الْعَزِيزِ" )
( clartts_1469 "تُبَايِعُهْ فَلَا تَمْنَحَنَّ الرَّأْيَ مَنْ لَيْسَ أَهْلَهُ" )
( clartts_1470 "أَيُّ النَّاسِ أَشَرُّ قَالَ الْعُلَمَاءُ إذَا فَسَدُوا" )
( clartts_1471 "الْوَاحِدِ فِيهِ لَمَّا كَانَ أَقْوَى أَسْبَابِ الْأُلْفَةِ" )
( clartts_1472 "فَخَلِّدُوهَا أَجْمَلَ أَفْعَالِكُمْ وَقِيلَ فِي مَنْثُورِ الْحِكَمِ" )
( clartts_1473 "ثُمَّ يُوصِيكُمْ بِالْأَقْرَبِ فَالْأَقْرَبِ الْمَوْلُودُونَ" )
( clartts_1474 "تُرِيكَ أَعْيُنُهُمْ مَا فِي صُدُورِهِمْ إنَّ الْعُيُونَ" )
( clartts_1475 "وَمِنْهُمْ مَنْ يَفْعَلُهُ اقْتِدَاءً وَمِنْهُمْ مَنْ يَتْرُكُهُ اسْتِحْسَانًا" )
( clartts_1476 "فَيَنُمُّ حَدِيثَهُمْ وَالْمَنَّانُ هُوَ الَّذِي يَصْنَعُ الْخَيْرَ وَيَمُنُّ بِهِ" )
( clartts_1477 "وَيَكْثُرُ مَعَهُ النَّسْلُ وَيَأْمَنُ بِهِ السُّلْطَانُ" )
( clartts_1478 "مَا لَا تَطْلُبُهُ وَقَالَ أَبُو الْعَتَاهِيَةِ رَحِمَهُ اللَّهُ تَعَالَى" )
( clartts_1479 "فَارْجِعْ إلَى رَأْيِ الْعُقَلَاءِ وَافْزَعْ إلَى اسْتِشَارَةِ الْعُلَمَاءِ" )
( clartts_1480 "وَإِخْلَالَهُ بِالْمَسْنُونِ يَمْنَعُ مِنْ إكْمَالِ الثَّوَابِ" )
( clartts_1481 "أَعْذَرُ فِي تَنَقُّصِي وَثَلْبِي فَكَانَ هَذَا تَفَضُّلًا مِنْهُ وَتَأَلُّفًا" )
( clartts_1482 "لَا تَمْنَعُوا الْعِلْمَ أَهْلَهُ فَتَظْلِمُوا وَلَا تَضَعُوهُ فِي غَيْرِ أَهْلِهِ" )
( clartts_1483 "وَإِنْ جَادَ بِالْجَلِيلِ الْكَثِيرِ كَاَلَّذِي حُكِيَ عَنْ عَبْدِ اللَّهِ بْنِ جَعْفَرٍ وَقَدْ مَاكَسَ فِي دِرْهَمٍ" )
( clartts_1484 "وَأَمَّا سُوءُ الظَّنِّ فَهُوَ عَدَمُ الثِّقَةِ بِمَنْ هُوَ لَهَا أَهْلٌ" )
( clartts_1485 "خَدُّهُ وَفِيهِ مَكَانَ الْوَهْمِ مِنْ فِكْرَتِي أَثَرُ" )
( clartts_1486 "بْنَ عُلَاثَةَ قَالَ يَا رَسُولَ اللَّهِ عِظْنِي" )
( clartts_1487 "قَدَّرَ أَحْوَالَ خَلْقِهِ فَهَدَى إلَى سَبِيلِ الْخَيْرِ وَالشَّر" )
( clartts_1488 "وَمِنْ عَيْنِك الدُّمُوعَ فَإِنِّي قَرِيبٌ" )
( clartts_1489 "وَقَدْ قَالَتْ الْفُرْسُ فِي حِكَمِهَا أَضْعَفُ الْحِيلَةِ" )
( clartts_1490 "نَوْعٌ يُمْكِنُ حَصْرُ شُرُوطِهِ وَنَوْعٌ لَا يُمْكِنُ لِاخْتِلَافِ أَسْبَابِهِ" )
( clartts_1491 "وَمَا بَقِيَ مِنْهَا كَمَا قَدْ مَضَى وَقِيلَ لِزَاهِدٍ" )
( clartts_1492 "وَعَالِمًا غَيْرَ مَرْزُوقٍ فَظَنُّوا أَنَّ الْعِلْمَ وَالْعَقْلَ هُمَا السَّبَبُ فِي قِلَّةِ حَظِّهِ وَرِزْقِهِ" )
( clartts_1493 "تَكْرَهُ غِبَّهُ كَذَلِكَ فِي الدُّنْيَا تَعِيشُ الْبَهَائِمُ" )
( clartts_1494 "وَدَاعٍ إلَى التَّخْصِيصِ أَنَفَةً مِنْ خُمُولِ الضَّعَةِ" )
( clartts_1495 "اغْتَرِبُوا وَلَا تُضْوُوا وَرُوِيَ عَنْ عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ أَنَّهُ قَالَ" )
( clartts_1496 "يَا ابْنَ عِمْرَانَ تَعَلَّمْ الْعِلْمَ لِتَعْمَلَ بِهِ" )
( clartts_1497 "فَقَدْ سُلِبَ حَظَّ الدُّنْيَا وَالْآخِرَةِ فَلَمْ يَكُنْ لَهُ فِي الْحَيَاةِ حَظٌّ" )
( clartts_1498 "وَالْعَمَلَ فُرْصَةَ فَرَاغِك فَلَيْسَ كُلُّ الزَّمَانِ مُسْتَسْعَدًا وَلَا مَا فَاتَ مُسْتَدْرَكًا" )
( clartts_1499 "وَلَيْسَ لِلْحَرِيصِ غَايَةٌ مَقْصُودَةٌ يَقِفُ عِنْدَهَا" )
( clartts_1500 "يُنْقَدُ ُحِلُّهُ وَحَرَامُهُ يَوْمًا وَيَبْقَى بَعْدَ ذَالِكَ آثَامُهُ" )
( clartts_1501 "فَأَمَّا الْمَطَامِعُ الدَّنِيَّةُ فَلِأَنَّ الطَّمَعَ ذُلٌّ وَالدَّنَاءَةَ لُؤْمٌ" )
( clartts_1502 "وَمَوَاضِعَ مُسْتَحِقَّةً مُسْتَحَقَّةً مَا قَالَ الشَّاعِرُ" )
( clartts_1503 "وَلَا يَعْرِفُونَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَيَقُولُونَ" )
( clartts_1504 "فَلَا تَنْطِقْ بِسِرِّك كُلُّ سِرٍّ إذَا مَا جَاوَزَ الِاثْنَيْنِ فَاشِي" )
( clartts_1505 "أَحَدُهُمَا يَذْكُرُونَ اللَّهَ تَعَالَى وَالْآخَرُ يَتَفَقَّهُونَ" )
( clartts_1506 "قَالُوا جَلَسْتَ لِتَسْمَعَ قَالَ لَا وَلَكِنِّي أَرَدْتُ أَنْ أَتَوَاضَعَ لِلَّهِ بِالْجُلُوسِ إلَيْكُمْ" )
( clartts_1507 "قَطْعَ النِّعْمَة وَقَالَ بَعْضُ الْفُصَحَاءِ" )
( clartts_1508 "عَنْ اتِّبَاعِ الْأَوَامِرِ وَأَذْهَلَتْهَا الشَّهْوَةُ عَنْ تِذْكَارِ الزَّوَاجِرِ" )
( clartts_1509 "وَكَانَ بِالرَّدِّ خَلِيقًا وَبِالْحِرْمَانِ حَقِيقًا" )
( clartts_1510 "فَالْحَقُّ أَقْوَى مُعِينٍ وَالصِّدْقُ أَفْضَلُ قَرِينٍ" )
( clartts_1511 "فَإِنَّ الْمُمَارِيَ بِهِ مَهْجُورٌ لَا يَنْتَفِعُ" )
( clartts_1512 "كَأَنَّهُ وَلِيٌّ حَمِيمٌ قَالَ مُجَاهِدٌ مَعْنَاهُ ادْفَعْ" )
( clartts_1513 "مِنْ هَوَانِ الدُّنْيَا عَلَى اللَّهِ أَلَّا يُعْصَى إلَّا فِيهَا" )
( clartts_1514 "كُلُّ مَظْلُومٍ وَرُوِيَ عَنْهُ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1515 "وَيَزِلَّ بِهَا سَاهِيًا فَالْحَرَجُ فِيهَا مَرْفُوعٌ وَالْعَتْبُ عَنْهَا مَوْضُوعٌ" )
( clartts_1516 "رَأَيْت أَعْمَالَك أَعْمَى لَكَ وَقَدْ أَسْقَطَ حَقَّ نَفْسِهِ وَرَفَعَ أَسْبَابَ شُكْرِهِ فَصَارَ بِأَنْ لَا حَقَّ لَهُ مَذْمُومًا" )
( clartts_1517 "خَوَّفَ أَهْلَ الْبَصْرَةِ أَمْرٌ فَخَطَبَ خُطْبَةً أَوْجَزَ فِيهَا" )
( clartts_1518 "فَإِنَّ حَاجَةَ الْإِنْسَانِ لَازِمَةٌ وَالزَّمَانُ يَقْصُرُ عَنْ اسْتِيعَابِ الْمُهِمِّ" )
( clartts_1519 "وَقَالَ الشَّاعِرُ إن شِئْتَ أَنْ تَحْيَا غَنِيًّا فَلَا تَكُنْ" )
( clartts_1520 "ثُمَّ رَجَعَتْ إلَى نَفْسِهَا فَقَالَتْ لِلَّهِ دَرُّ التَّقْوَى" )
( clartts_1521 "فَإِذَا أَخَذَتْ بِعَهْدِ ذِمَّتِهَا لَعِبَ الصُّدُودُ بِذَلِكَ الْعَهْدِ" )
( clartts_1522 "وَأَجْعَلُ اللَّهَ ذُخْرًا لِوَلَدِي وَتَصَدَّقَ بِه" )
( clartts_1523 "أَهْلُ الْجَنَّةِ كُلُّ هَيِّنٍ لَيِّنٍ سَهْلٍ طَلْقٍ" )
( clartts_1524 "ضَرَبَ قَهَارِمَتِهِ وَقَالَ أَبْطَأْتُمْ بِأَرْزَاقِهِمْ" )
( clartts_1525 "وَقَالَ بَعْضُ الْحُكَمَاءِ خَيْرُ الْعُلَمَاءِ مَنْ لَا يُقِلُّ وَلَا يُمِلُّ" )
( clartts_1526 "وَقَالَ مُجَاهِدٌ أَعْطَى كُلَّ شَيْءِ صُورَتَهُ ثُمَّ هَدَاهُ لِمَعِيشَتِهِ" )
( clartts_1527 "وَإِنَّمَا اسْتَجَازَ صُهَيْبٌ فِي جَوَابِهِ" )
( clartts_1528 "ثُمَّ يَقُولُ إنَّمَا كُنْتُ أُمَازِحُك" )
( clartts_1529 "وَقَالَ بَعْضُ الْبُلَغَاءِ مِنْ شَرَائِطِ الْمُرُوءَةِ أَنْ يَتَعَفَّفَ عَنْ الْحَرَامِ" )
( clartts_1530 "لِلِّذَّةِ الَّتِي هِيَ عِنْدَهُ أَحْظَى وَإِلَى نَفْسِهِ أَشْهَى" )
( clartts_1531 "اصْطِفَاءُ الْكَمَلَةِ مِنَ الرِّجَال فَإِذَا اسْتَكْمَلَتْ هَذِهِ الْخِصَالُ فِي إنْسَانٍ" )
( clartts_1532 "وَيُحَبَّبُ مِنْهَا مَا أَتْعَبَ وَإِنْ تَقَدَّمَ قَوْلُ الْقَائِلِ" )
( clartts_1533 "وَيَسْتَنْكِفُ أَنْ يُسَاوِيَهُ الْحَدَثُ الْغَرِيرُ" )
( clartts_1534 "فَقَدْ عَلِمْتُمْ مَا قَالَ اللَّهُ فِي الْمُطَفِّفِينَ" )
( clartts_1535 "مِنْ أَخِيهِ فَأَنْشَدَ الرَّضِيُّ اُعْذُرْ أَخَاك عَلَى ذُنُوبِهِ" )
( clartts_1536 "لِعَدِيِّ بْنِ حَاتِمٍ رَفَعَ اللَّهُ عَنْ أَبِيك الْعَذَابَ الشَّدِيدَ لِسَخَائِهِ" )
( clartts_1537 "وَلَمْ أَرَ بَعْدَ الْكُفْرِ شَرًّا مِنْ الْفَقْرِ وَبِحَسَبِ الْغِنَى يَكُونُ إقْلَالُ الْبَخِيلِ وَإِعْطَاؤُهُ" )
( clartts_1538 "قَبْلَ الْفِعْلِ لِيَعْلَمَ بِهِ مَوَاقِعَ الْإِصَابَةِ" )
( clartts_1539 "طَمَعًا فِي الْحُظْوَةِ بِالصَّوَابِ فَإِنَّ الْقَرَائِحَ إذَا انْفَرَدَتْ" )
( clartts_1540 "فَإِنَّهَا مُعَالَجَةُ الْأَجْسَادِ الْخَاوِيَةِ وَمَوْعِظَةٌ بَلِيغَةٌ" )
( clartts_1541 "هِيَ أُمٌّ تَعُقُّ مِنْ نَسْلِهَا مَنْ يَبَرُّهَا" )
( clartts_1542 "وَأَرَاضِي الْحَرْثِ وَفِي ذَلِكَ مِنْ الْإِعْوَازِ وَتَعَذُّرِ الْإِمْكَانِ مَا لَا خَفَاءَ بِهِ" )
( clartts_1543 "فَلِذَلِكَ وَجَبَ تَقْدِيمُ الْقَوْلِ فِيهِمَا" )
( clartts_1544 "فِي الِانْبِسَاطِ عِنْدَهُ وَالْإِدْلَالِ عَلَيْهِ بَلْ يُعْطَى مَا يَسْتَحِقُّهُ بِسُلْطَانِهِ" )
( clartts_1545 "جُحُودَ ذَنْبٍ وَاحِدٍ رَجُلٌ جَوَارِحُهُ عَلَيْهِ شُهُودُ" )
( clartts_1546 "إنَّ الْعَدُوَّ وَإِنْ أَبْدَى مُسَالَمَةً إذَا رَأَى مِنْك يَوْمًا" )
( clartts_1547 "إذَا عَصَتْكَ نَفْسُك فِيمَا كَرِهْتَ فَلَا تُطِعْهَا فِيمَا" )
( clartts_1548 "فَمَا مَلَّ حَيَاةً وَإِنَّمَا الضَّعْفَ مَلَّا" )
( clartts_1549 "كَالْمَاءِ مُخْتَلِطًا بِالتُّرْبِ تَظْهَرُ مِنْهُ زَهْرَةُ الْعُشَبْ" )
( clartts_1550 "بَعْضُ النَّاسِ يَفِعْلُونَ الطَّاعَاتِ وَيَجْتَنِبُونَ الْمَعَاصِي" )
( clartts_1551 "وَأُمُورٍ طَارِئَةٍ تَجْعَلُ اللِّينَ خُشُونَةً" )
( clartts_1552 "وَالتَّعَرُّضِ لِاكْتِسَابِ التَّبِعَاتِ حَتَّى يَصِيرَ كَالْبَهِيمَةِ الَّتِي قَدْ انْصَرَفَ طَلَبُهَا" )
( clartts_1553 "وَغَمٍّ شَاغِلٍ عَارَضَتْ فِكْرَهُ شَوَائِبُ الْهُمُومِ لَا يَسْلَمُ لَهُ رَأْيٌ" )
( clartts_1554 "وَأعْلَمْ هُدِيتَ بِأَنَّهَا حُجَجٌ تَكُونُ عَلَيْك مِنْكَ" )
( clartts_1555 "يُصِيبُ الْمَاشِيَةَ وَالنَّاسَ وَهُوَ أَعْدَى عِنْدَهُمْ مِنْ الْجَرَبِ" )
( clartts_1556 "إلَّا بَعْدَ أَنْ يَسْتَوْفِيَهَا وَهِيَ أَرْبَعَةٌ فَالشَّرْطُ الْأَوَّلُ أَنْ يَكُونَ الْكَلَامُ لِدَاعٍ يَدْعُو إلَيْهِ" )
( clartts_1557 "مِنْ نُبْلِ الْفَقْرِ أَنَّك لَا تَجِدُ أَحَدًا يَعْصِي اللَّهَ لِيَفْتَقِرَ" )
( clartts_1558 "وَالْحِرْفَةُ فِيمَا أَحَلَّ اللَّهُ تَعَالَى وَسَأَلَ يَزِيدَ فَقَالَ هِيَ الصَّبْرُ عَلَى الْبَلْوَى" )
( clartts_1559 "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ انْتِظَارُ الْفَرْجِ مِنْ اللَّهِ بِالصَّبْرِ عِبَادَةٌ" )
( clartts_1560 "فَلَا يَضَنُّ عَلَيْهِ بِمَرْغُوبٍ وَلَا يَتَنَفَّسُ عَلَيْهِ بِمَطْلُوبٍ" )
( clartts_1561 "الْمَوْتُ بَابٌ وَكُلُّ النَّاسِ دَاخِلُهُ فَلَيْتَ شَعْرِي بَعْدَ الْبَابِ مَا الدَّارُ" )
( clartts_1562 "وَيَمْحَقُ الْأَجْرَ ثُمَّ تَلَا لَا تُبْطِلُوا صَدَقَاتِكُمْ بِالْمَنِّ وَالْأَذَى" )
( clartts_1563 "وَلِذَلِكَ زَجَرَ اللَّهُ عَنْهُ بِالْحَدِّ تَغْلِيظًا" )
( clartts_1564 "وَأَيَّامِ عُطْلَةٍ وَمَنْ صَرَفَ كُلَّ نَفْسِهِ إلَى الْكَسْبِ" )
( clartts_1565 "وَفِي الْيَمِينِ فَأَمَّا مَا عَلِمْت فَقَدْ كَفَانِي وَأَمَّا مَا جَهِلْت فَجَنِّبُونِي" )
( clartts_1566 "عَلَى مَنْزِلَتِهِ فَإِنَّ مَنْ نَفَذَ أَمْرُهُ فَهُوَ إلَى الْعِلْمِ أَحْوَجُ" )
( clartts_1567 "لِمَا أَيْقَنْت مِنْ فِرَاقِهَا وَكُنْ أَحْذَرَ مَا تَكُونُ لَهَا" )
( clartts_1568 "مُشْتَغِلًا يَزْرِي عَلَى دَهْرِهِ الدَّهْرُ مَأْمُورٌ لَهُ آمِرٌ" )
( clartts_1569 "عَدَمُ الْقَنَاعَةِ بِالْكِفَايَة وَطَلَبُ الزِّيَادَة" )
( clartts_1570 "ظِلَالًا وَجَعَلَ لَكُمْ مِنْ الْجِبَالِ أَكْنَانًا وَجَعَلَ لَكُمْ سَرَابِيلَ تَقِيكُمْ الْحَرَّ" )
( clartts_1571 "تُكْسِبُ الْعِدَاءَ وَتُفْسِدُ الْأَخْلَاقَ وَلَا خَيْرَ فِي مَوَدَّةٍ" )
( clartts_1572 "أَنَّ الْوَاثِقَ آمِنٌ وَالْآمِنُ مِنْ اللَّهِ تَعَالَى" )
( clartts_1573 "هَوِّنْ عَلَيْك فَإِنَّمَا أَنَا ابْنُ امْرَأَةٍ" )
( clartts_1574 "فَيَظُنُّونَ أَنَّهُ يَعْنِي هِدَايَةَ الطَّرِيقِ وَهُوَ إنَّمَا يُرِيدُ هِدَايَةَ سَبِيلِ الْخَيْرِ" )
( clartts_1575 "فَيَأْتِي بِالْحِمْلِ عَلَى النَّفْسِ مَا أَمْكَنَ" )
( clartts_1576 "مَا بَعَثَ اللَّهُ تَعَالَى مِنْ بَعْدِهِ إلَّا" )
( clartts_1577 "بَعْثَةُ نَبِيَّيْنِ فِي عَصْرٍ وَاحِدٍ وَلَمْ يُؤَدِّ ذَلِكَ إلَى إبْطَالِ النُّبُوَّةِ" )
( clartts_1578 "وَقَالَ ثَعْلَبٌ إنَّمَا سُمِّيَ الْخَلِيلُ خَلِيلًا" )
( clartts_1579 "أَبَى دَهْرُنَا إسْعَافَنَا فِي نُفُوسِنَا وَأَسْعَفَنَا" )
( clartts_1580 "وَمَنْ جَالَسَ السُّفَهَاءَ حُقِّرَ لَا تَخْشَى طَلَبٌ الْعِلْمِ" )
( clartts_1581 "لِرَجُلٍ سَأَلَهُ حَاجَةً أَعِدُك الْيَوْمَ" )
( clartts_1582 "وَتَطَاوُلِ مُدَّتِهِ فَيَصِيرُ ظُلْمُهُ مَعَ الْمُكْنَةِ جَلَاءً" )
( clartts_1583 "وَذَلِكَ أَضْعَفُ الْإِيمَانِ فَإِنْ أَرَادَ الْإِقْدَامَ عَلَى الْإِنْكَارِ مَعَ لُحُوقِ الْمَضَرَّةِ بِهِ نَظَرَ" )
( clartts_1584 "يَفْتَقُ مِنْهَا كُلَّ مَا ارْتَتَجَا" )
( clartts_1585 "وَقَالَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ إنَّ فِي الْمَعَارِيضِ مَا يَكْفِي أَنْ يَعِفَّ الرَّجُلَ عَنْ الْكَذِبِ" )
( clartts_1586 "لِجَمِيعِ أَهْلِهَا مُسْعِدَةً وَلَا عَنْ كَافَّةِ ذَوِيهَا مُعْرِضَةً" )
( clartts_1587 "رَضِيَ اللَّهُ عَنْهُ اُغْدُ عَالِمًا أَوْ مُتَعَلِّمًا أَوْ مُسْتَمِعًا أَوْ مُحِبًّا" )
( clartts_1588 "مُوَرِّقٌ الْعِجْلِيُّ خَيْرٌ مِنْ الْعُجْبِ بِالطَّاعَةِ" )
( clartts_1589 "كَدَّرَ مَعْرُوفًا امْتِنَانٌ وَضَيَّعَ" )
( clartts_1590 "إيَادٍ يَرْمُونَ بِالْخُطَبِ الطِّوَالِ وَتَارَةً" )
( clartts_1591 "وَبِهِمْ مِنْ الْحَاجَةِ وَالْعَجْزِ مَا وَصَفْنَا فَيَذْهَبُوا" )
( clartts_1592 "إنْ تَكَرَّمَ وَقَالَ أَبُو الْعَتَاهِيَةِ مَا النَّاسُ إلَّا" )
( clartts_1593 "خَزَنَ الْبَخِيلُ عَلَيَّ صَالِحَهُ إذْ لَمْ" )
( clartts_1594 "فَفَعَلَ فَسَاءَتْ حَالُهُمْ فَاجْتَمَعُوا إلَيْهِ فَقَالُوا" )
( clartts_1595 "وَلَا يُؤَاخَذُ الْمُسْتَشَار عَلَى عَوَاقِبِ الْمَشُورَة" )
( clartts_1596 "وَقَالَ بَعْضُ الْحُكَمَاءِ مَنْ صَاحَبَ الْعُلَمَاءِ وُقِّرَ" )
( clartts_1597 "وَهِيَ الدِّينُ وَالنَّسَبُ وَالْمُصَاهَرَةُ وَالْمَوَدَّةُ وَالْبِرُّ" )
( clartts_1598 "بِاجْتِمَاعِ الْفَرِيقَيْنِ وَالْمُظَافَرَةُ بِتَنَاصُرِ الْفِئَتَيْنِ" )
( clartts_1599 "اجْتَهَدُوا فِي الْعَمَلِ فَإِنْ بِكُمْ ضَعْفٌ فَكُفُّوا عَنْ الْمَعَاصِي" )
( clartts_1600 "لِأَنَّ الْأَنَفَةَ تَمْنَعُ مِنْ التَّهَضُّمِ وَالْخُمُولِ مَعًا" )
( clartts_1601 "فَإِنَّ الْمُرُوءَةَ لَا تُسْتَطَاعُ إذَا لَمْ يَكُنْ مَالُهَا فَاضِلَا" )
( clartts_1602 "لَا مَطْبُوعًا عَلَيْهِ لَيْسَ فِي الطَّبْعِ أَنْ يَكُونَ مَا لَيْسَ فِي التَّطَبُّعِ" )
( clartts_1603 "وَأَنَا مُنْذُ ثَلَاثِينَ سَنَةً صَائِمٌ فَقَالَ يَا أَبَا عَبْدِ اللَّه" )
( clartts_1604 "فِي وُصُولِ بِرِّهِ وَإِسْدَاءِ عُرْفِهِ وَلَا رَأْيَ لِمَنْ يُحْسِنُ بِهِ ظَنَّ شَاكِرٍ" )
( clartts_1605 "وَتَارَةً يَكُونُ بِأَسْبَابٍ حَادِثَةٍ مِنْ غَيْرِ مَقَاصِدِ الْآدَمِيِّينَ" )
( clartts_1606 "ثُمَّ يَصِيرُ ذَلِكَ لَهُ عَادَةً فَلَا يَنْجَحُ لَهُ سَعْيٌ" )
( clartts_1607 "فِي مُقَابَلَةِ الْإِشْفَاقِ فِي الْآبَاءِ وَقَدْ لَحَظَ أَبُو تَمَّامٍ الطَّائِيُّ هَذَا الْمَعْنَى فِي شَعْرِهِ فَقَالَ" )
( clartts_1608 "وَغَنَاءٌ وغناء لَوْلَا أَنَّهُ فَنَاءٌ وَجَسِيمٌ لَوْلَا أَنَّهُ ذَمِيمٌ" )
( clartts_1609 "تُسْمِعْهُ وَقْعَ تَخْوِيفِهَا سُرُور الْمَرْء مَقْرُونٌ" )
( clartts_1610 "وَقَالَ جَعْفَرُ بْنُ يَحْيَى إذَا كَانَ الْإِيجَازُ كَافِيًا" )
( clartts_1611 "أَمَرَتْهُ نَفْسٌ بِالدَّنَاءَةِ وَالْخَنَا وَنَهَتْهُ عَنْ سُبُلِ الْعُلَا فَأَطَاعَهَا" )
( clartts_1612 "سَلْنِي عَمَّا صَنَعَهُ بِي رَبِّي وَقَالَ الشَّاعِرُ" )
( clartts_1613 "عِلْمُ العَالِمِ حُجَّةٌ عَلَيْهِ لِأَنَّهُ لَمَّا كَانَ" )
( clartts_1614 "تَقَطَّعَتْ نَفْسُهُ عَلَى الدُّنْيَا حَسَرَاتِ القَناعَةِ" )
( clartts_1615 "وَإِنِّي لَعَلَى مَا كُنْت عَلَيْهِ مِنْ الْمَسَائِلِ إِلَى وَقْتِي" )
( clartts_1616 "وَالدَّاعِي إلَى هَذَا التَّأْوِيلِ شَيْئَانِ التَّغَافُلُ الْحَادِثُ عَنْ الْفَطِنَةِ" )
( clartts_1617 "وَأَوْضَحَهَا دَلِيلًا عَلَى عَجْزِهِ وَأَنْشَدَنِي بَعْضُ أَهْلِ الْأَدَبِ لِابْنِ الرُّومِيِّ رَحِمَهُ اللَّهُ" )
( clartts_1618 "وَالسَّخَاءُ وَاسِطَةٌ بَيْنَ التَّبْذِيرِ وَالتَّقْتِيرِ" )
( clartts_1619 "فَكَتَبَ إلَى بَعْضِ إخْوَانِهِ يَشْكُو لَهُ طُولَ حَبْسِهِ" )
( clartts_1620 "لَا يَرْغَبُ فِي مَالِ غَيْرِهِ وَقَالَ بَعْضُ السَّلَفِ إن وَجَدْت خَيْرَ الدُّنْيَا وَالْآخِرَةِ فِي التُّقَى وَالْغِنَى" )
( clartts_1621 "وَعِشْنَا فِيهَا غَافِلِينَ وَأُخْرِجْنَا مِنْهَا كَارِهِينَ" )
( clartts_1622 "أَنْ يَكُونَ مُسْتَوْدَعًا فِي صَنِيعٍ مَشْكُورٍ وَبِرٍّ مَذْخُورٍ" )
( clartts_1623 "وَاَللَّهِ لَأَنْ تَمُوتَ طَالِبًا لِلْعِلْمِ خَيْرٌ مِنْ أَنْ تَعِيشَ قَانِعًا بِالْجَهْلِ" )
( clartts_1624 "إنْ أَرَحْتهَا فِيهَا تَخَلَّتْ فَالْأَوْلَى بِالْإِنْسَانِ تَقْدِيرُ حَالَيْهِ" )
( clartts_1625 "وَفَطَرَهُمْ عَاجِزِينَ لِيَكُونَ بِالْغِنَى مُنْفَرِدًا وَبِالْقُدْرَةِ مُخْتَصًّا" )
( clartts_1626 "يَا لَائِمَ الدَّهْرَ يَا لَائِمَ الدَّهْرِ وَأَفْعَالِهِ" )
( clartts_1627 "عَلَى رِسْلِكُمَا إنَّهَا صَفِيَّةُ بِنْتُ" )
( clartts_1628 "أَنْ لَا لَا تَكْذِبَنَّهَا بِالتُّقَى" )
( clartts_1629 "مَنْ يَسْتَكِفُّ النَّارَ بِالْحَلْفَاءِ وَقَالَ" )
( clartts_1630 "وَإِنْ لَمْ يَصِحَّ اُمْتُهِنَ وَقَدْ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1631 "وَالْبَيَانُ فِي مَعْنَى التَّشَادُقِ كَمَا جَاءَ فِي الْحَدِيثِ الْآخَرِ" )
( clartts_1632 "وَكَلَ إلَى رَأْيِهِ وَأَسْلَمَ إلَى نَفْسِهِ" )
( clartts_1633 "وَبُشِّرَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ بِمَوْلُودٍ فَقَالَ" )
( clartts_1634 "وَلَا أَثَرٌ مَشْكُورٌ وَقَدْ رَوَى حَكِيمٌ" )
( clartts_1635 "هَذَا هُوَ السَّخِيُّ طَبْعًا وَالْجَوَادُ كَرَمًا" )
( clartts_1636 "أَعْدَلُ مِنْ الْحَسَدِ يَقْتُلُ الْحَاسِدَ يَقْتُلُ الْحَاسِدَ قَبْلَ" )
( clartts_1637 "مَنْ عَامَلَ النَّاسَ فَلَمْ يَظْلِمْهُمْ وَحَدَّثَهُمْ فَلَمْ يَكْذِبْهُمْ" )
( clartts_1638 "وَلَكِنْ لِعِلْمِي أَنَّهُ غَيْرُ نَافِعِ وَإِنِّي" )
( clartts_1639 "وَفْقَ حَاجَتِهِ مِنْ غَيْرِ أَنْ يَتَعَدَّى إلَى زِيَادَةٍ عَلَيْهَا" )
( clartts_1640 "وَهَذَا آخِرُ مَا يَتَعَلَّقُ بِالْقَاعِدَةِ الثَّانِيَةِ مِنْ أَسْبَابِ الْأُلْفَةِ الْجَامِعَةِ" )
( clartts_1641 "وَمُجَانَبَةَ الْإِدْلَالِ أَعْطَفُ وَكَفَّ الْأَذَى أَنْصَفُ" )
( clartts_1642 "بَالَيْت أَيَّهُمَا رَكِبْتُ وَقَالَ عَبْدُ اللَّهِ بْنُ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُمَا أَفْضَلُ الْعُدَّةِ" )
( clartts_1643 "قِيلَ وَمَنْ هُمْ قَالَ مُقَاتِلُ بْنُ مُسْمِعٍ" )
( clartts_1644 "وَكَفَى بِالْمَرْءِ عِلْمًا إذَا عَبَدَ اللَّهَ عَزَّ وَجَلَّ" )
( clartts_1645 "وَالنَّهْيُ عَنْ الْمُنْكَرِ تَأْيِيدًا لِزَوَاجِرِهِ" )
( clartts_1646 "رَاحِلَتِي لَا صَلَّيْتُ لَهُ صَلَاةً أَبَدًا" )
( clartts_1647 "بْنِ أَبِي الدَّرْدَاءِ قَالَ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_1648 "وَلَا يُسَوِّفُ نَفْسَهُ بِالْمَوَاعِيدِ الْكَاذِبَةِ" )
( clartts_1649 "قَدْ يَكُونُ مِنْ فَضِيلَةِ النَّفْسِ وَحُسْنِ السَّرِيرَةِ" )
( clartts_1650 "وَقَالَ سُلَيْمَانُ بْنُ دُرَيْدٍ وَأَجِبْ أَخَاكَ إذَا اسْتَشَارَكَ نَاصِحًا" )
( clartts_1651 "وَشَرًّا وَتَضُمَّ إلَى لُؤْمِهَا دَنَاءَةً وَغَدْرًا" )
( clartts_1652 "أَفْضَلُ مِنْ مُؤَاخَاةٍ عَلَى اغْتِرَارٍ وَقَالَ بَعْضُ الْأُدَبَاءِ" )
( clartts_1653 "إنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ وَإِيتَاءِ ذِي الْقُرْبَى وَيَنْهَى عَنْ الْفَحْشَاءِ وَالْمُنْكَرِ وَالْبَغْيِ فَإِنَّ الْعَدْلَ" )
( clartts_1654 "وَجَبَ عَلَى الْمُسْتَوْدَعِ لَهُ أَدَاءُ الْأَمَانَةِ فِيهِ بِالتَّحَفُّظِ وَالتَّنَاسِي لَهُ حَتَّى لَا يَخْطِرَ لَهُ بِبَالٍ وَلَا يَدُورَ" )
( clartts_1655 "حَسَرَاتٍ كُلَّمَا طَارَ طَائِرُ يَرَى طَائِرَاتِ الْجَوِّ" )
( clartts_1656 "وَقَالَ ابْنُ الْمُعْتَزِّ الْحَسَدُ دَاءُ الْجَسَدِ" )
( clartts_1657 "حَتَّى يُكْتَسَبَ بِالتَّجْرِبَةِ وَالْمُعَانَاةِ" )
( clartts_1658 "وَتَزْعُمُ أَنَّ الْعِلْمَ لَا يُكْسِبُ الْغِنَى وَيُحْسِنُ" )
( clartts_1659 "فَقَدْ يَدْعُو إلَى ذَلِكَ أَرْبَعَةُ أَسْبَابٍ أَحَدُهَاطَلَبُ الزِّيَادَةِ رَغْبَةً" )
( clartts_1660 "وَلِكُلِّ شَيْءٍ عِمَادٌ وَعِمَادُ الدِّينِ الْفِقْهُ" )
( clartts_1661 "عَلَى وَجْهِ التَّوْرِيَةِ وَالتَّأْوِيلِ دُونَ التَّصْرِيحِ بِهِ" )
( clartts_1662 "وَإِنْ كَانَ الدَّاعِي مَحْظُورًا كَرَجُلٍ دَعَاهُ إلَى طَلَبِ الْعِلْمِ شَرٌّ كَامِنٌ" )
( clartts_1663 "وَلَا يَسْتَنْقِذُهُ مِنْهَا إلَّا سَلِيمٌ" )
( clartts_1664 "لَا تَقْدِرُ أَنْ تَطْلُعَ زَهْرَتُهَا" )
( clartts_1665 "قَالَ كُلُّكُمْ خَيْرٌ مِنْهُ وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_1666 "وَطَلَبْتُ مِنْكَ مَوَدَّةً لَمْ أُعْطَهَا إنَّ الْمُعَنَّى طَالِبٌ" )
( clartts_1667 "وَقَالَ الْحَسَنُ بْنُ وَهْبٍ مِنْ حُقُوقِ الْمَوَدَّةِ أَخْذُ عَفْوِ الْإِخْوَانِ" )
( clartts_1668 "فَمَزْرَعَةٌ طَابَتْ وَأَضْعَفَ نَبْتُهَا وَمَزْرَعَةٌ" )
( clartts_1669 "أَنَّهُ قَالَ مَا أَخَذَ اللَّهُ الْعَهْدَ عَلَى أَهْلِ الْجَهْلِ" )
( clartts_1670 "وَبَلِيدٌ يَكْتَفِي بِالْقَلِيلِ فَيَضْجَرُ الذَّكِيُّ مِنْهُ" )
( clartts_1671 "قَدْ كِدْت تَقْضِي عَلَى فَوْتِ الشَّبَابِ أَسًى" )
( clartts_1672 "صَدِيقٌ مُسَاعِدٌ عَضُدٌ وَسَاعِدٌ" )
( clartts_1673 "حِلْمِي أَصَمُّ وَأُذْنِي غَيْرُ صَمَّاءُ" )
( clartts_1674 "وَقِلَّةِ الِاسْتِعْدَادِ لَهَا وَقَدْ أَفْصَحَ لَبِيدٌ" )
( clartts_1675 "فَالنَّاسُ مَا بَيْنَ مَعْمُومٍ وَمَخْصُوصِ" )
( clartts_1676 "يُرِيك النَّصِيحَةَ عِنْدَ اللِّقَاءِ وَيَبْرِيك فِي السِّرِّ" )
( clartts_1677 "الْرِفْقُ يُمْنٌ وَخَيْرُ الْقَوْلِ أَصْدَقُهُ" )
( clartts_1678 "أَحَدُهُمَا أَنْ يَكُونَا آحَادًا" )
( clartts_1679 "عَدَمُ الإنْخِدَاعِ بِالمَظْهَرِ الحَسَنْ فَلَزِمَ مِنْ هَذِهِ الْوَجْهِ" )
( clartts_1680 "اعْتَاضَ بِالْكِبَرِ تَوَاضُعًا وَبِالْعُجْبِ" )
( clartts_1681 "لَا يَأْتِي يُحِبُّ الصَّالِحِينَ وَلَا يَعْمَلُ بِعَمَلِهِمْ" )
( clartts_1682 "وَيَقْدِعُنِي مِنْهُ إذَا غِبْتُ أَسْهُمَ" )
( clartts_1683 "وَيَلْحَقُ بِأَحْوَالِ الْعَامِلِينَ لِاسْتِقْرَارِ الشَّرْعِ عَلَى سُقُوطِ مَا دَخَلَ تَحْتَ الْعَجْزِ" )
( clartts_1684 "وَقَالَ ذُو الْقَرْنَيْنِ رَضِيَ اللَّهُ عَنْهُ رَتَعْنَا فِي الدُّنْيَا جَاهِلِينَ" )
( clartts_1685 "تَنْكَسِفُ الشَّمْسُ الْمِحَن تمنح الْمَرْأَة" )
( clartts_1686 "وَتَصْحِيحُ الْأَقْسَامِ وَقِيلَ ذَلِكَ لِلرُّومِيِّ" )
( clartts_1687 "وَقَالَ بَعْضُ الْحُكَمَاءِ الْبُخْلُ جِلْبَابُ الْمَسْكَنَةِ" )
( clartts_1688 "وَهِيَ الرَّحِمُ اشْتَقَقْتُ لَهَا مِنْ اسْمِي اسْمًا فَمَنْ وَصَلَهَا وَصَلْتُهُ" )
( clartts_1689 "وَكَفَى بِهَا لِصَاحِبِهَا فِتْنَةً وَقَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ" )
( clartts_1690 "وَقَالَ الْقَاضِي التَّنُوخِيُّ إلْقَ الْعَدُوَّ بِوَجْهٍ لَا قُطُوبَ بِهِ" )
( clartts_1691 "أَوَّلُ صَلَاحِ هَذِهِ الْأُمَّةِ بِالزُّهْدِ وَالْيَقِينِ وَفَسَادُهَا" )
( clartts_1692 "وَقَالَ تَعَالَى إنَّمَا يَفْتَرِي الْكَذِبَ الَّذِينَ لَا يُؤْمِنُونَ بِآيَاتِ اللَّهِ" )
( clartts_1693 "لَأَشْكُرَنَّكَ مَعْرُوفًا هَمَمْتَ بِهِ إنَّ اهْتِمَامَك بِالْمَعْرُوفِ مَعْرُوفُ" )
( clartts_1694 "وَرُوِيَ أَنَّ عِيسَى ابْنَ مَرْيَمَ عَلَيْهِمَا السَّلَامُ قَامَ خَطِيبًا فِي بَنِي إسْرَائِيلَ فَقَالَ" )
( clartts_1695 "وَهُوَ ذُو طَبَائِعٍ أَرْبَعٍ مَعَ أَنَّ نَفْسَ الْإِنْسَانِ الَّتِي هِيَ" )
( clartts_1696 "لَمُوجَعٌ كَمَا صَبَرَ الظَّمْآنُ فِي الْبَلَدِ الْقَفْرِ" )
( clartts_1697 "فَوَجَبَ أَنْ يَكُونَ مَا يَلْزَمُ مِنْ سَتْرِهَا حُكْمًا شَرْعِيًّا" )
( clartts_1698 "لِأَنَّ النَّفْسَ رُبَّمَا جَمَحَتْ عَنْ الْأَفْضَلِ وَهِيَ بِهِ عَارِفَةٌ" )
( clartts_1699 "بِالْإِقْلَاعِ قَبْلَ الْمُخَالَطَةِ وَحُسْنُ الْمُتَارَكَةِ بَعْدَ الْوَرْطَةِ" )
( clartts_1700 "مُتْ بِدَاءِ الصَّمْتِ خَيْرٌ لَك مِنْ دَاءِ الْكَلَامِ" )
( clartts_1701 "تَجُوزُ إلَّا بِالتَّغَافُلِ وَقَالَ أَكْثَمُ بْنُ صَيْفِيٍّ" )
( clartts_1702 "مُقَابَلَةُ الْمَعْنَى بِمَا يُوَافِقُهُ وَحَقِيقَةُ هَذِهِ الْمُقَارَبَةِ" )
( clartts_1703 "وَأَنْشَدَ بَعْضُ أَهْلِ الْأَدَبِ لِعَلِيِّ بْنِ الْجَهْمِ هِيَ النَّفْسُ مَا حَمَّلْتهَا تَتَحَمَّلُ" )
( clartts_1704 "مُصَنِّفُ الْكِتَابِ رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ" )
( clartts_1705 "قَالَ اللَّهُ تَعَالَى وَلَا تَشْتَرُوا بِآيَاتِي ثَمَنًا قَلِيلًا" )
( clartts_1706 "فَإِنَّ الْمُسَامَحَةَ وَالِاسْتِصْلَاحَ إذَا اجْتَمَعَا لَمْ يَلْبَثْ مَعَهُمَا نُفُورٌ" )
( clartts_1707 "فَإِنْ تَكُ بِالْأَمْسِ اقْتَرَفَتْ إسَاءَةً" )
( clartts_1708 "وَلَا يَرَوْنَ ذَلِكَ نَقْصًا إذَا نَمَّقُوا فِي الْمَجَالِسِ كَلَامًا مَوْصُوفًا" )
( clartts_1709 "وَقَالَ عَبْدُ اللَّهِ بْنُ الْمُبَارَكِ طَلَبْنَا الْعِلْمَ لِلدُّنْيَا" )
( clartts_1710 "كَمَا قَالَ أَكْثَمُ بْنُ صَيْفِيٍّ لِكُلِّ سَاقِطَةٍ لَاقِطَةٍ" )
( clartts_1711 "وَقَالَ الْحَسَنُ بْنُ سَهْلٍ إذَا لَمْ أُعْطِ إلَّا" )
( clartts_1712 "وَإِنْ خَالَهَا تَخْفَى عَلَى النَّاسِ تُعْلَمْ" )
( clartts_1713 "وَرَجُلٌ يَدْرِي وَلَا يَدْرِي أَنَّهُ يَدْرِي فَذَلِكَ نَاسٍ فَذَكِّرُوهُ" )
( clartts_1714 "فَإِنْ ظَهَرَ نَدَمُهُ وَبَانَ خَجَلُهُ فَالنَّدَمُ تَوْبَةٌ" )
( clartts_1715 "عَمَّا قَلِيلٍ نَدِيمًا لِلنَّدَامَاتِ" )
( clartts_1716 "رَحِمَهُ اللَّهُ تَعَالَى شُكْرُ الْإِلَهِ نِعْمَةٌ مُوجِبَةٌ لِشُكْرِ" )
( clartts_1717 "كَلًّا إنَّ مَنْ تَكَلَّمَ فَأَحْسَنَ قَدَرَ عَلَى أَنْ يَسْكُتَ فَيُحْسِنَ" )
( clartts_1718 "قَالَ الزُّهْدُ فِي النَّاسِ وَكَتَبَ كِسْرَى إلَى ابْنِهِ هُرْمُزَ" )
( clartts_1719 "فَإِنَّهَا لَيْسَتْ لَك بِدَارٍ وَلَا فِيهَا مَحَلُّ قَرَارٍ" )
( clartts_1720 "فَنِمْت الْجَوْرِ يُسْرِعُ فِي خَرَابِ الْأَرْضِ" )
( clartts_1721 "فَأَوَّلُ مُقَدَّمَاتِ أَدَبِ الرِّيَاضَةِ وَالِاسْتِصْلَاحِ" )
( clartts_1722 "وَقَدْ خَاطَرَ مَنْ اسْتَغْنَى بِرَأْيِهِ وَقَالَ لُقْمَانُ الْحَكِيمُ لِابْنِهِ" )
( clartts_1723 "فَإِنَّمَا يَشْكُو رَبَّهُ وَحُكِيَ أَنَّ أَعْرَابِيَّةً دَخَلَتْ" )
( clartts_1724 "وَصَبَرَ عَلَى طَاعَتِهِ وَمَنْ جَزَعَ مِنْ عِقَابِهِ" )
( clartts_1725 "فَإِنْ قَدَّمَ مَا يَقْتَضِي التَّأْخِيرَ كَانَ عَجَلَةً" )
( clartts_1726 "أَنَّهُ أَنَّهُ الْأَهْوَاءُ الْمُخْتَلِفَةُ وَهَذَا قَوْلُ ابْنِ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُمَا" )
( clartts_1727 "قَالَ الَّذِي إذَا وَوَاسَاك وَخَيْرٌ مِنْهُ" )
( clartts_1728 "مَضَرَّةٌ مِنْ إنْكَارِهِ وَلَمْ تَلْحَقْهُ مِنْ كَفِّهِ وَإِقْرَارِهِ" )
( clartts_1729 "الْغِيبَةُ فَاكِهَةُ النِّسَاءِ وَقَالَ رَجُلٌ لِابْنِ سِيرِينَ رَحِمَهُ اللَّهُ" )
( clartts_1730 "وَاسْتَوْفَى حَقَّهُ بِالتَّصَرُّفِ وَالْيَقِظَةِ خَلَصَ بِالِاسْتِرَاحَةِ مِنْ عَجْزِهَا وَكَلَالِهَا" )
( clartts_1731 "اُطْلُبُوا الْحَوَائِجَ مِنْ حِسَانِ الْوُجُوهِ فَقَالَ مَعْنَاهُ" )
( clartts_1732 "رَثَّ الْهَيْئَةِ فَقَالَ مَا مَالُك قَالَ مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللَّهُ" )
( clartts_1733 "وَالرَّهْبَةُ مِنْهُ وَمَنْ لَمْ يَكُنْ مِنْهُمْ بِمَوْضِعِ رَهْبَةٍ وَلَا رَغْبَة" )
( clartts_1734 "لِأَنَّ الْإِكْثَارَ مِنْهُ وَإِنْ كَانَ صَوَابًا يُمِلُّ السَّامِعَ وَيُكِلُّ الْخَاطِرَ" )
( clartts_1735 "وَأَمَّا حَيَاؤُهُ مِنْ النَّاسِ فَيَكُونُ بِكَفِّ الْأَذَى" )
( clartts_1736 "لِرِقَّةٍ أَوْ مَحَبَّةٍ كَانَ مَوْتُهُنَّ أَحَبَّ إلَيْهِ" )
( clartts_1737 "أَنَّ مَا يَطْلُبُهُ مِنْ الزِّيَادَةِ غَيْرُ" )
( clartts_1738 "وَلَمْ يَسْأَلْ اللَّهَ الْغِنَى لَحَسُودُ وَأَمَّا الْإِخْوَانُ" )
( clartts_1739 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1740 "وَمِنْ عَقْلٍ مُجَالَسَةُ الْحَكِيمِ فَإِنَّك وَالْقَرِينُ مَعًا سَوَاءٌ" )
( clartts_1741 "وَلَيْسَ لِلْمُقَابَلَةِ إلَّا أَحَدُ هَذَيْنِ الْوَجْهَيْنِ" )
( clartts_1742 "وَوُقُوفِك عَلَى غَامِضِ الْحُكْمِ فَقَالَ" )
( clartts_1743 "ليبريبوكس نُقْطَة أَرِج الْفَصْلُ الثَّانِي" )
( clartts_1744 "وَأَنَّ السُّرُورَ بِهَا إذَا أَقْبَلَتْ مَشُوبٌ" )
( clartts_1745 "نْ يَكُونَ مَا أَخَلَّ بِهِ مِنْ مَفْرُوضِ عِبَادَتِهِ" )
( clartts_1746 "وَقَالَ بَعْضُ الْحُكَمَاءِ بِحُسْنِ التَّأَنِّي تَسْهُلُ الْمَطَالِبُ" )
( clartts_1747 "فَمِنْهَا اتِّبَاعُ الدِّينِ فِي اجْتِنَابِهِ وَالرُّجُوعِ إلَى اللَّهِ عَزَّ وَجَلَّ فِي آدَابِهِ" )
( clartts_1748 "وَأَمَّا الْمُهْلِكَاتُ فَشُحٌّ مُطَاعٌ وَهَوًى مُتَّبَعٌ" )
( clartts_1749 "مِنْ تَبَعِ الْفُؤَادِ يَحْسِمُ الرُّخْصَةَ فِي الْكَلَامِ وَيَقُولُ" )
( clartts_1750 "لَا تَكُونُ صَنِيعَةً حَتَّى يُصَابَ بِهَا طَرِيقُ الْمَصْنَعِ" )
( clartts_1751 "إذَا بُلِيتَ فَثِقْ بِاَللَّهِ وَارْضَ بِهِ إنَّ الَّذِي يَكْشِفُ الْبَلْوَى هُوَ اللَّهُ" )
( clartts_1752 "فَقُلْ يَا رَبِّ فَلَمْ يَلْبَثْ إلَّا أَيَّامًا حَتَّى قُتِلَ شَرَّ قِتْلَةٍ" )
( clartts_1753 "يَئُولُ إلَى أَوْ جَلَاءٍ فَأَمَّا الْفِتْنَةُ" )
( clartts_1754 "وَقَالَ بَعْضُ الْحُكَمَاءِ الْخَطَأُ فِي إعْطَاءِ مَا لَا يَنْبَغِي" )
( clartts_1755 "وَأَنْشَدَ الرِّيَاشِيُّ قَوْلَ بَشَّارٍ قَدْ تَخَلَّلْتَ" )
( clartts_1756 "مِنْ صَدِيقٍ قَدْ تَمَيَّزَ بِذَاتِهِ وَانْفَصَلَ" )
( clartts_1757 "غَايَةَ مَا يَكْرَهُ وَقَالَ بَعْضُ الْحُكَمَاءِ مَنْ عَلِمَ أَنَّ كُلَّ نَائِبَةٍ إلَى انْقِضَاءٍ" )
( clartts_1758 "وَحَسْبُك نَقْصًا فِي رَجُلٍ يَكُونُ الصَّغِيرُ الْمُسَاوِي لَهُ فِي الْجَهْلِ أَفْضَلَ مِنْهُ" )
( clartts_1759 "بِمَا فَارَقَ وَتَرْكِ مَا اسْتَوْحَشَ مِنْهُ إلَى مَا أَنِسَ بِهِ" )
( clartts_1760 "فِي ارْتِيَادِ مَوَادِّهِمْ وَوَكَلَهُمْ إلَى نَظَرِهِمْ فِي طَلَبِ مَكَاسِبِهِمْ" )
( clartts_1761 "تُدْرِكُ مَا يُغْنِيك وَلَا يَنْبَغِي أَنْ يَدْعُوهُ ذَلِكَ إلَى تَرْكِ" )
( clartts_1762 "إنَّهُ لَمْ يَنْتَشِرْ عَنْ ذَلِكَ الْمَكَانِ الْمُنْقَطِعِ" )
( clartts_1763 "فَلَا تُسِئْ بِي وَمَعَك عَقْلُك وَقَالَ أَبُو نُوَاسٍ" )
( clartts_1764 "حِفْظًا وَلَا عَهْدًا كَمَا قَالَ أَشْجَعُ بْنُ عُمَرَ" )
( clartts_1765 "تَرِبَتْ يَدَاك الزَّوَاجُ رَغْبَةٌ فِي الْمَالِ" )
( clartts_1766 "فَإِذَا حَسُنَتْ أَخْلَاقُ الْإِنْسَانِ كَثُرَ مُصَافُوهُ وَقَلَّ" )
( clartts_1767 "لِتَكُونَ أَبْلَغَ تَأْثِيرًا وَأَحْسَنَ مَوْقِعًا فَإِذَا اجْتَمَعَتْ فِي الْأَمْثَالِ الْمَضْرُوبَةِ هَذِهِ الشُّرُوطُ الْأَرْبَعَةُ" )
( clartts_1768 "كَادَ الْحَسَدُ أَنْ يَغْلِبَ الْقَدَرَ وَكَادَ الْفَقْرُ" )
( clartts_1769 "حُيَيٍّ فَقَالَا سُبْحَانَ اللَّهِ أَوَفِيكَ شَكٌّ يَا رَسُولَ اللَّهِ" )
( clartts_1770 "فَيَكُونَ أَسْوَأَ حَالًا مِنْ الْبَخِيلِ بِمَالِهِ الَّذِي قَدْ يُعِدُّهُ لِنَوَائِبِهِ" )
( clartts_1771 "أنْهَاهَا عَنْ بَعْضِ مَا لَا يَشِينُهَا مَخَافَةَ أَقْوَالِ الْعِدَا فِيمَ أَوْ لِمَا" )
( clartts_1772 "فَلَوْ نِلْتهَا بِحَذَافِيرِهَا لَمِتَّ وَلَمْ" )
( clartts_1773 "وَحَذْفَ الْمَعْسُورِ أَسْلَمُ وَتَرْكَ التَّسَلُّطِ أَعَطْفُ" )
( clartts_1774 "أَصَبْتُمْ وَلَا دِينَكُمْ أَبْقَيْتُمْ وَقَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ" )
( clartts_1775 "وَقَالَ لِرَجُلٍ يُمَاشِيهِ لِمِثْلِ هَذَا" )
( clartts_1776 "لِأَنَّهُ لَمْ يَكُنْ عَالِمًا وَهَذَا صَحِيحٌ" )
( clartts_1777 "فَقَالَتْ طَائِفَةٌ وَجَبَ سَتْرُهَا بِالْعَقْلِ لِمَا فِي ظُهُورِهَا مِنْ الْقُبْحِ" )
( clartts_1778 "وَمَنْ سَامَحَ نَفْسَهُ فِي الْكَلَامِ إذَا عَنَّ وَلَمْ يُرَاعِ صِحَّةَ دَوَاعِيهِ" )
( clartts_1779 "بِئْسَ الزَّادُ إلَى الْمَعَادِ الْعُدْوَانُ عَلَى الْعِبَادِ" )
( clartts_1780 "وَكِلَاهُمَا مَذْمُومٌ وَهُوَ فِيهِمَا مَلُومٌ" )
( clartts_1781 "بِنَدْبِهِ فَعِنْدَ ذَلِكَ يَزُولُ الْغَضَبُ قَالَ اللَّهُ تَعَالَى" )
( clartts_1782 "وَيُنْفِقَ أَمْوَالَهُ فِيمَا لَا يَحْصُلُ لَهُ ثَوَابُهُ وَأَجْرُهُ" )
( clartts_1783 "وَلَا فِي الرَّأْيِ مُفَوِّضًا فَإِنَّهُ يَسْتَفِيدُ بِذَلِكَ مَعَ ارْتِيَاضِهِ بِالِاجْتِهَادِ" )
( clartts_1784 "وَهِيَ سِتَّةُ فُصُولٍ مُتَفَرِّعَةٍ الْفَصْلُ الْأَوَّلُ" )
( clartts_1785 "وَهُوَ حَسْبُنَا وَعَلَيْهِ تَوَكُّلُنَا الْفَصْلُ السَّابِعُ" )
( clartts_1786 "تِلْكَ زُرُوعٌ قَدْ دَنَا حَصَادُهَا الْمَوْتُ بَابٌ يَدْخُلُهُ كُلُّ النَّاسِ" )
( clartts_1787 "فَانْظُرْ إلَى هَذَا الرِّيَاءِ إلَى هَذَا الرِّيَاءِ" )
( clartts_1788 "فِي دَارِ الْحَيَاةِ وَالْمُحْسِنُ حَيٌّ وَإِنْ كَانَ فِي دَارِ الْأَمْوَاتِ" )
( clartts_1789 "عَزَّ وَجَلَّ أَهْوَنَ وَأَنْشَدْت لِبَعْضِ الْفُصَحَاءِ فِي ذَلِكَ" )
( clartts_1790 "أَحَدُ حُسَّادِ عَقْلِهِ وَلَيْسَ إلَى مَا يُكْسِبُهُ الْكِبْرُ مِنْ الْمَقْتِ حَدٌّ" )
( clartts_1791 "قَدْرُ اللَّهِ كَائِنٌ حِينَ يَقْضِي وُرُودُهُ" )
( clartts_1792 "وَقَالَ حَسَّانُ بْنُ ثَابِتٍ رَضِيَ اللَّهُ عَنْهُ إنَّ الصَّنِيعَةَ" )
( clartts_1793 "فَقُلْت فَكَيْفَ يَكُونُ عِلْمُ حَافِظِ الْمَذْهَبِ مَسْتُورًا" )
( clartts_1794 "لَا قَدْرَ لَهُ وَالْأَدَبُ مَالٌ لَا خَوْفَ عَلَيْهِ" )
( clartts_1795 "أَصْبَحْتَ مُحْتَاجًا إلَى الْوَعْظِ أَيُّ أَفْضَلْ" )
( clartts_1796 "وَإِنْ جَزِعْتَ جَرَى عَلَيْك الْقَلَمُ وَأَنْتَ مَأْزُورٌ" )
( clartts_1797 "مِنْهُ عَلَيْهِ وَهَلْ يَكُونُ مَنْ أَنْعَمَ عَلَيْهِ بِنِعْمَةٍ فَأَهْمَلَهَا" )
( clartts_1798 "وَاسْتِنْبَاطُ الْعُلَمَاءِ إيضَاحًا وَكَشْفًا وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1799 "وَقَدْ حُكِيَ أَنَّ هِشَامَ بْنَ عَبْدِ الْمَلِكِ لَمَّا ثَقُلَ" )
( clartts_1800 "وَلِلزُّهْدِ فِيهِ تَرْكٌ وَالتَّرْكُ لَهُ جَهْلٌ" )
( clartts_1801 "اللَّهُمَّ اُرْزُقْنِي حَمْدًا وَمَجْدًا فَإِنَّهُ لَا حَمْدَ إلَّا بِفِعَلٍ" )
( clartts_1802 "فِي الْخَيْرِ وَالشَّرِّ فَانْظُرْ كَيْفَ تَرْتَادُ" )
( clartts_1803 "بِهِ رَبِّي وَقَالَ أَبُو بِشْرٍ الضَّرِيرُ" )
( clartts_1804 "أُخُوَّةٌ مُكْتَسَبَةٌ بِالِاتِّفَاقِ الْجَارِي مَجْرَى الِاضْطِرَارِ" )
( clartts_1805 "لِلْمَزِيدِ مٍنَ الْمًعْلُومًاتِ أًوْ لٍلْمُشَارَكَةِ زُوُرُوا الْمَوْقِعْ لِيبْرِي بٌوكْسْ" )
( clartts_1806 "فَلَا يَخُونُ غُضُّوا أَبْصَارَكُمْ وَاحْفَظُوا فُرُوجَكُمْ وَكُفُّوا أَيْدِيَكُمْ" )
( clartts_1807 "لِسُخْفِ الْفَقْرِ وَبَطْرِ الْغِنَيِ وَالْأَمْرُ الثَّانِي" )
( clartts_1808 "يُوشِكُ أَنْ يَكُونَ لِهَذَا الْفِعْلِ مِنْهُ تَأْوِيلٌ سَائِغٌ" )
( clartts_1809 "ابْنُك رَيْحَانُك سَبْعًا وَخَادِمُك سَبْعًا" )
( clartts_1810 "وَقَالَ الشَّاعِرُ تَجَاوَزْتُ بِنْتَ الْعَمِّ وَهِيَ حَبِيبَةٌ" )
( clartts_1811 "وَأَشَرٌ يُرْدِي لِأَنَّ شَهَوَاتِهَا غَيْرُ مُتَنَاهِيَةٍ" )
( clartts_1812 "بِقَوْلِ مَنْ لَمْ يَلْتَزِمْ الطَّلَاقَ فَمَا ظَنُّك بِقَوْلٍ" )
( clartts_1813 "وَأَعْوَزَ نَيْلُهُ مِنْ مَسَرَّةٍ مَأْمُولَةٍ" )
( clartts_1814 "لُحُومُهُمْ لَحْمِي وَهُمْ يَأْكُلُونَهَا وَمَا دَاهِيَةُ الْمَرْءِ إلَّا" )
( clartts_1815 "وَعَدَاوَةُ مَنْ كَانَ صَدِيقًا أَعْظَمُ مِنْ عَدَاوَةِ" )
( clartts_1816 "بِكَفَّيْك فِي إدْبَارِهِ مُتَعَالِّقَا" )
( clartts_1817 "فَمِنْهُمْ مَنْ يَرَى أَنَّ الِاسْتِكْثَارَ مِنْهُمْ أَوْلَى لِيَكُونُوا أَقْوَى مَنَعَةً وَيَدًا" )
( clartts_1818 "الْأَبُ رَبٌ وَالْوَلَدُ كَمَدٌ" )
( clartts_1819 "لَا سِيَّمَا مَنْ كَانَ بِالْعِلْمِ مَوْسُومًا وَإِلَيْهِ مَنْسُوبًا" )
( clartts_1820 "اُفْشُوَا السَّلَامَ بَيْنَكُمْ فَأَخْبَرَ بِحَالِ الْحَسَدِ" )
( clartts_1821 "وَلَعَمْرِي لَقَدْ فَحَصَ الْأَحْنَفُ عَنْ الْمَعْنَى وَنَبَّهَ عَنْ الْعِلَّةِ" )
( clartts_1822 "ذِكْرُ الْمَوْتِ وَالْقَبْرُ يُزِيلُ الْغَضَبِ اطَّلِعْ فِي الْقُبُورِ وَاعْتَبِرْ بِالنُّشُورِ" )
( clartts_1823 "وَاسْتِقْبَاحِ الرَّذَائِلِ أَنْ يَنْفِيَ عَنْ نَفْسِهِ رَذَائِلَ الْجَهْلِ بِفَضَائِلِ الْعِلْمِ" )
( clartts_1824 "أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ أَيُّهَا النَّاسُ" )
( clartts_1825 "أَحَدُهُمَا صِيَانَةُ النَّفْسِ بِالْتِمَاسِ كِفَايَتِهَا وَتَقْدِيرِ مَادَّتِهَا" )
( clartts_1826 "فَقَالَ يَا بُنَيَّ نَفْسِي مَطِيَّتِي وَأَكْرَهُ أَنْ أُتْعِبَهَا فَلَا تَقُومَ بِي" )
( clartts_1827 "وَهَذَا مِمَّنْ رَضِيَ بِخِدَاعِ نَفْسِهِ وَقَنَعَ بِمُدَاهَنَةِ حِسِّهِ" )
( clartts_1828 "مِنَ المُرُوءَةِ تَعْجِيلُ العَطاءِ بَعْد سُؤَال" )
( clartts_1829 "فَهَذِهِ أَرْبَعَةُ شُرُوطٍ مَتَى أَخَلَّ الْمُتَكَلِّمُ بِشَرْطٍ مِنْهَا فَقَدْ أَوْهَنَ فَضِيلَةَ" )
( clartts_1830 "فَإِذَا عَزَمَ عَلَى اصْطِفَاءِالْإِخْوَانِ سَبَرَ أَحْوَالَهُمْقَبْلَ" )
( clartts_1831 "وَأَمَّا الْحِرْصُ فَيَسْلُبُ فَضَائِلَ النَّفْسِ" )
( clartts_1832 "لِيَكُونَ اخْتِلَافُ جِهَاتِ التَّكْلِيفِ أَبْعَثَ عَلَى قَبُولِهِ وَأَعْوَنَ عَلَى فِعْلِهِ" )
( clartts_1833 "وَمَا رَأَيْت مِثْلَ النَّارِ نَامَ هَارِبُهَا وَقَالَ عِيسَى ابْنُ مَرْيَمَ عَلَيْهِمَا السَّلَامُ" )
( clartts_1834 "وَذَلِكَ أَنَّهُمْ قَدْ الْتَمَسُوا مِنْ الْأَلْفَاظِ" )
( clartts_1835 "فَالصِّدْقُ هُوَ الْإِخْبَارُ عَنْ الشَّيْءِ عَلَى مَا هُوَ عَلَيْهِ" )
( clartts_1836 "وَلَمْ يَتَجَرَّعُوا غُصَصَ الْمَعَاصِي" )
( clartts_1837 "وَقَالَ الشَّعْبِيُّ مَا أَدْرَكْت أُمِّي فَأَبَرُّهَا" )
( clartts_1838 "وَأَوْفَرُ فِي اجْتِهَادِهَا لِأَنَّ لِلنَّفْسِ" )
( clartts_1839 "وَأَرْجُو لِذِي الْهَفَوَاتِ اُلْمُسِي" )
( clartts_1840 "وَيَنْتَظِرُ مِنْ نِعْمَةٍ يَأْمُلُهَا فَإِنَّهُ إنْ أَدْهَشَهُ التَّوَقُّعُ لَهَا" )
( clartts_1841 "قِيلَ فَمَا بَالُنَا نَرَى الْعُلَمَاءَ عَلَى أَبْوَابِ الْأَغْنِيَاءِ" )
( clartts_1842 "قَالَ يَكْسِبُهُ مِنْ غَيْرِ حِلِّهِ" )
( clartts_1843 "شَتَّى أُمُورُهُ الصَّبْرُ عَلَى الْمَصَائِبِ يَجْعَل الْفَرْج قَرِيبٌ" )
( clartts_1844 "وَقَالَ ابْنُ الْمُقَفَّعِ الِاسْتِطَالَةُ لِسَانُ الْجُهَّالِ" )
( clartts_1845 "وَالسَّبَبُ الثَّانِي أَنْ يَطْلُبَ الزِّيَادَة وَيَلْتَمِسَ الْكَثْرَة" )
( clartts_1846 "وَذَلِكَ قَبِيحٌ فِي الْعَقْلِ أَنْ يَتَعَرَّضَ لَهُ فَهَذَا مَا أَكَّدَ اللَّهُ تَعَالَى بِهِ أَوَامِرَهُ" )
( clartts_1847 "وَقَدَّمَهُ عَلَى زَكَاةِ الْأَمْوَالِ لِتَعَلُّقِ الصِّيَامِ بِالْأَبْدَانِ" )
( clartts_1848 "فَقَالَ قَيْسٌ وَاَللَّهِ يَا رَسُولَ اللَّهِ لَقَدْ عَلِمَ أَنِّي خَيْرٌ مِمَّا وَصَفَ" )
( clartts_1849 "وَلَكِنَّ ذَا الْهَوَى إلَى حَيْثُ يَهْوَى الْقَلْبُ" )
( clartts_1850 "فَهَذِهِ آثَارُ السُّلْطَانِ فِي أَحْوَال ِالدُّنْيَا وَمَا يَنْتَظِمُ بِهِ أُمُورُهَا" )
( clartts_1851 "مُقَدَّرَةً أَنْ تَكُونَ عَلَى يَدِهِ جَارِيَةٌ" )
( clartts_1852 "نَفْسِي بِفُرْقَتِهِ تَطِيبُ غَادَرْته فِي بَعْضِهِنَّ" )
( clartts_1853 "مَلِكٍ فَقَالَ بَابٌ جَدِيدٌ وَمَوْتٌ عَتِيدٌ وَ نَزَعٌ شَدِيدٍ وَسَفَرٌ بَعِيدٌ" )
( clartts_1854 "الْفَقْرُ مَخْذَلَةٌ وَالْغِنَى مَجْدَلَةٌ وَالْبُؤْسُ مَرْذَلَةٌ وَالسُّؤَالُ مَبْذَلَةٌ" )
( clartts_1855 "يُسْتَدَلُّ عَلَيْهَا بِكَرْمِهِ فَلَا يَدَعْهُ الْكَرْمُ أَنْ يَغْفُلَ" )
( clartts_1856 "وَلْيَكُنْ سَائِلَ كَرَمِ نَفْسِهِ عَنْهُمْ فَإِنَّهُمْ عِيَالُ كَرَمِهِ" )
( clartts_1857 "وَأَمَّا طَالِبُ الدُّنْيَا فَإِنَّهُ يَزْدَادُ طُغْيَانًا ثُمَّ قَرَأَ" )
( clartts_1858 "تَعَلَّمُوا الْعِلْمَ قَبْلَ أَنْ يُرْفَعَ وَرَفْعُهُ ذَهَابُ أَهْلِهِ" )
( clartts_1859 "كَانَ الْمَنْعُ لِغَيْرِ سَبَبٍ لِأَنَّ الْمَالَ يَقِلُّ عَنْ الْحُقُوقِ" )
( clartts_1860 "وَأُمَّهُ إلَهَيْنِ مِنْ دُونِهِ فَقَالَ مَا الْمَسِيحُ ابْنُ مَرْيَمَ" )
( clartts_1861 "وَقَالَ بَعْضُ أَهْلِ التَّأْوِيلِ فِي قَوْله تَعَالَى لَا تُؤَاخِذْنِي بِمَا نَسِيتُ" )
( clartts_1862 "كَيْفَ تَعْدِلُونَ مَعَ الْأَقَارِبِ وَقَالَ رَجُلٌ لِلْحَسَنِ الْبَصْرِيِّ رَحِمَهُ اللَّهُ" )
( clartts_1863 "إلَيَّ آلَ الزُّبَيْرِ حَتَّى تَزَوَّجْت مِنْهُمْ أَرْمَلَةً فَصَارُوا أَحَبَّ خَلْقِ اللَّهِ عَزَّ وَجَلَّ إلَيَّ" )
( clartts_1864 "هِيَ الدَّارُ دَارُ الْأَذَى وَالْقَذَى وَدَارُ الْفَنَاءِ وَدَارُ الْغِيَر" )
( clartts_1865 "وَكَانَ النُّجْحُ عِنْدَهُ مَأْمُولًا فَإِنَّ ذَوِي الْمُكْنَةِ كَثِيرٌ وَالْمُعِينُ مِنْهُمْ قَلِيلٌ" )
( clartts_1866 "لِأَنَّ طَالِبَ الدِّينِ مُتَّبِعٌ لَهُ وَمَنْ" )
( clartts_1867 "وَالْعَرَبُ تَقُولُ فِي أَمْثَالِهَا الْمَطْلُ أَحَدُ الْمَنْعَيْن" )
( clartts_1868 "وَقَدْ قَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ كَرَّمَ اللَّهُ وَجْهَهُ أَوَّلُ عِوَضِ الْحَلِيمِ عَنْ حِلْمِهِ" )
( clartts_1869 "غُلٌّ لِحَامِلِهِ وَيَحْسَبُهُ الَّذِي" )
( clartts_1870 "زُورُوا الْمَوْقِعْ لِيبْرِي بُوكْسْ نُقْطَةٌ أُورْجْ" )
( clartts_1871 "وَوُضُوحُ صِحَّتِهِ بِالدَّلِيلِ مُرْتَبِطٌ" )
( clartts_1872 "تَقَدُّمِهِ مَعَ مَا يَجِدُهُ فِي نَفْسِهِ مِنْ الْعِزِّ" )
( clartts_1873 "فَتَنْدَمَ إذْ لَا تَنْفَعَنَّكَ نَدَامَةٌ" )
( clartts_1874 "وَقَالَ ابْنُ الرُّومِيِّ رَحِمَهُ اللَّهُ وَاعْلَمْ بِأَنَّ النَّاسَ مِنْ طِينَةٍ" )
( clartts_1875 "غَيْرَ أَنَّ مَنْ فَضَّلَ الزَّرْعَ فَلِقُرْبِ مَدَاهُ" )
( clartts_1876 "كَمَا مَلَّ الْإِخَاءَ وَإِنْ كَانَ لِزَلَلٍ لُوحِظَتْ أَسْبَابُهُ فَإِنْ كَانَ لَهَا مَدْخَلٌ فِي التَّأْوِيلِ" )
( clartts_1877 "لِيَسْلُبُوهُ فَضِيلَةَ التَّقَدُّمِ وَيَمْنَعُوهُ مُبَايِنَةَ التَّخْصِيصِ" )
( clartts_1878 "لِلْأَشْعَثِ بْنِ قَيْسٍ إنَّك إنْ صَبَرْت جَرَى عَلَيْك الْقَلَمُ وَأَنْتَ مَأْجُورٌ" )
( clartts_1879 "وَيَعْجِزُ الْبَلِيدُ عَنْهُ وَمَنْ يُرَدِّدُ" )
( clartts_1880 "تَسَلَّطَ عَلَيْهِ مَنْ كَانَ يَدْفَعُ عَنْهُ وَاضْطُرَّ" )
( clartts_1881 "أَأَخِي مَنْ لَك مِنْ بَنِي الدُّنْيَا َبِكُلِّ أَخِيك" )
( clartts_1882 "وَقَدْ عَلِمَ أَنَّ نَفْسَهُ قَدْ تَطْغَى عَلَيْهِ فَتُرْدِيهِ" )
( clartts_1883 "أَخْبَرَنِي بَعْضُ أَهْلِ الْأَدَبِ أَنَّ أَبَا أَيُّوبَ الْكَاتِبَ حُبِسَ فِي السِّجْنِ" )
( clartts_1884 "ذِي الْمَالِ الْكَثِيرِ يَرَوْنَهُ وَإِنْ كَانَ عَبْدًا سَيِّدَ الْأَمْرِ جَحْفَلَا" )
( clartts_1885 "فَنَفْسَكَ أَكْرِمْهَا وَإِنْ ضَاقَ مَسْكَنٌ عَلَيْك لَهَا" )
( clartts_1886 "عَلَى اللَّئِيمِ دَلِيلَا وَاعْلَمْ بِأَنَّك عَنْ قَلِيلٍ" )
( clartts_1887 "وَقَالَ بَعْضُ الْبُلَغَاءِ مِنْ فَضْلِ عِلْمِك اسْتِقْلَالُك لِعِلْمِك" )
( clartts_1888 "إِنَّ النِّسَاءَ رَيَاحِينُ خُلِقْنَ لَكُمْ" )
( clartts_1889 "وَرُبَّمَا تَحَسَّرَ بِحُدُوثِ الْعَجْزِ بَعْدَ تَقْدُمْ الْقُدْرَةِ" )
( clartts_1890 "أَنَا أَعْلَمُ لَكُمْ ذَلِكَ فَقَالَ يَا رَسُولَ اللَّهِ" )
( clartts_1891 "جَوْعَتَكوَيَسْتُرُ عَوْرَتَك فَإِنْ كَانَ" )
( clartts_1892 "فَهَذِّبْ أَيُّهَا الْإِنْسَانُ نَفْسَك بِأَفْكَارِ عُيُوبِك" )
( clartts_1893 "لَا تُكْرِهَنَّ عَلَى الْهَوَى أَحَدَا قَدْ أَكْثَرَتْ" )
( clartts_1894 "عِطَاشُهَا بالعَطَاءِ تَكُونُ اليَدُ العُليا ثُمَّ إذَا أَنْجَزَ وَعْدَهُ وَأَوْفَى عَهْدَهُ" )
( clartts_1895 "الِاسْتِحْيَاءُ مِنْ جَزَاءِ الْجَوَابِ وَهَذَا" )
( clartts_1896 "فَأَبْدَى صَفْحَةَ عُقُوقِهِ وَاطَّرَحَ لَازِمَ حُقُوقِهِ" )
( clartts_1897 "مَنْ لَكَ فَاسْتَبْقِ بَعْضَك لَا يَمْلِكُ" )
( clartts_1898 "وَرَوَى هِشَامٌ عَنْ الْحَسَنِ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ" )
( clartts_1899 "أَنْ يَكُونَ فِعْلُ الْمُنْكَرِ مِنْ جَمَاعَةٍ قَدْ تَضَافَرُوا عَلَيْهِ" )
( clartts_1900 "أَخْبَارُهْ فَهَذِهِ حَالُ الْمُيَاسَرَةِ وَأَمَّا الْإِفْضَالُ فَنَوْعَانِ" )
( clartts_1901 "يَقُولُونَ وَقَالَ سَعِيدُ بْنُ الْمُسَيِّبِ مَرَّ بِي" )
( clartts_1902 "فَقَالَ قَلْبٌ عَرَفَ اللَّهَ عَزَّ وَجَلَّ ثُمَّ عَصَاهُ" )
( clartts_1903 "أَحَدُهُمَا فِي السَّائِلِ وَالثَّانِي فِي الْمَسْئُولِ فَأَمَّا مَا كَانَ مُعْتَبَرًا فِي السَّائِلِ فَثَلَاثَةُ شُرُوطٍ" )
( clartts_1904 "أَنْ يَسْتَكْثِرَ مِنْهَا اسْتِكْثَارَ مَنْ لَا يَنْهَضُ بِدَوَامِهَا" )
( clartts_1905 "وَلَا رَوِيَّةٌ سَلِيمَةٌ وَرُبَّمَا شَحَّ فِي الرَّأْيِ" )
( clartts_1906 "مُطَاعٌ فِي أَمْرِهِ وَفِي الدَّارِ مَحْجُوبٌ إلَّا" )
( clartts_1907 "مِنْ قِلَّةِ الْإِنْصَافِ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_1908 "وَلَوْ كَانَتْ فِيهِ فَضِيلَةٌ لَخَصَّ اللَّهُ بِهِ مَنْ اصْطَفَاهُ لِرِسَالَتِهِ" )
( clartts_1909 "وَلِذَلِكَ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْخَيْرُ كَثِيرٌ" )
( clartts_1910 "وَرَدِّ فَإِنَّ النَّفْسَ وَإِنْ كَانَ لَهَا مَكْرٌ يُرْدِي" )
( clartts_1911 "عَلَى شُرُوطٍ تَضَمَّنَتْ أَرْبَعَ مَسَائِلِ" )
( clartts_1912 "فَأَمَّا الْغِيبَةُ فَإِنَّهَا خِيَانَةٌ وَهَتْكُ سِتْرٍ" )
( clartts_1913 "إحْسَانِي إلَيْهِمْ لِيُحِبُّونِي فَإِنَّهُمْ لَا يُحِبُّونَ إلَّا مَنْ أَحْسَنَ إلَيْهِمْ" )
( clartts_1914 "لَا لِأَعْرَاضِهِ وَعَلَى مَنْ أُسْعِدَ بِجَاهِهِ" )
( clartts_1915 "أَنَّ شَرَفَهُ يُثْمِرُ عَلَى صَاحِبِهِ وَفَضْلَهُ" )
( clartts_1916 "الْمُوَاصَلَةُ بَيْنَ الْمُتَجَانِسَيْنِ ثُمَّ يَحْدُثُ بَيْنَ" )
( clartts_1917 "فَالْحِلْمُ مِنْ أَشْرَفِ الْأَخْلَاقِ وَأَحَقِّهَا بِذَوِي الْأَلْبَابِ" )
( clartts_1918 "مَيِّتًا لَا تَحِلُّ غِيبَتُهُ حَيًّا وَرُوِيَ أَنَّ امْرَأَتَيْنِ" )
( clartts_1919 "وَقَالَ حَسَّانُ بْنُ أَبِي سِنَانٍ مَا وَجَدْت شَيْئًا هُوَ أَهْوَنُ مِنْ الْوَرَعِ" )
( clartts_1920 "فَإِذَا تَضَاعَفَ صَارَ غَيْرَ مُطَاقِ فَإِذَا سَاعَدَهُ جَزَعُهُ بِالْأَسْبَابِ الْبَاعِثَةِ عَلَيْهِ" )
( clartts_1921 "فَلَا عَارٌ أَنْ يَجْهَلَ بَعْضَهُ وَإِذَا لَمْ يَكُنْ" )
( clartts_1922 "فَصَمْتُكَ عَنْ غَيْرِ السَّدَادِ سَدَادُ وَقِيلَ لِإِيَاسِ بْنِ مُعَاوِيَةَ" )
( clartts_1923 "فَيَسْتَقْبِحُ مِنْهُ فَيُسْتَقْبَحُ مِنْهُ وَإِنَّمَا ذَكَرَهُ تَعْظِيمًا لِلْعِلْمِ" )
( clartts_1924 "وَقَالَ بَعْضُ الشُّعَرَاءِ وَمِنْ عَادَةِ الْأَيَّامِ" )
( clartts_1925 "فِي وَصِيَّتِهِ فِي الْبَلَاغَةِ إذَا لَمْ تَجِدْ اللَّفْظَةَ وَاقِعَةً مَوْقِعَهَا" )
( clartts_1926 "وَمِنْ الْوَحْشَةِ مَا لَا يَضُرُّهُ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_1927 "فَكَمْ مِنْ لُقْمَةٍ مَنَعَتْ أَخَاهَا" )
( clartts_1928 "وَلَا يَكْتَفِ بِالْمُرْضِي مِنْهَا عَنْ التَّهْذِيبِ" )
( clartts_1929 "أَيْنَ عَمْرُو بْنُ جُرْمُزٍ وَهُوَ الَّذِي قَتَلَ أَبَاهُ الزُّبَيْرُ" )
( clartts_1930 "عَلَيْهِما السَّلَامُ لا تُنَازِعُوا أَهْلَ الدُّنْيَا فِي دُنْيَاهُمْ" )
( clartts_1931 "وَخَافَ عَلَيْهَا بَوَائِقَ الْهَوَى وَالْقُدْرَةِ فَآثَرَ الْفَقْرَ عَلَى الْغِنَى" )
( clartts_1932 "إنَّ الصَّغِيرَةَ الضَّحِكُ وَالْكَبِيرَة الْقَهْقَهَة" )
( clartts_1933 "وَقَدْ جَهِلُوا مِنْ الْمَذَاهِبِ مَا يَعْلَمُ الْمُبْتَدِئُ" )
( clartts_1934 "وَصِدْقٌ مُسْتَمَعٌ وَإِمَّا لِتَلَذُّذِهِ بِسَمَاعِ الثَّنَاءِ" )
( clartts_1935 "وَقَهْرَهَا عَنْ اتِّبَاعِ شَهَوَاتِهَا أَحْرَى لِيَذِلَّ لَهُ قِيَادُهَا وَيَهُونَ عَلَيْهِ عِنَادُهَا" )
( clartts_1936 "يَجُوزَ الِاسْتِغْنَاءِ عَمَّا يُرَادُ إلَّا لَهَا" )
( clartts_1937 "لَا يَنْبَغِي لِلشَّرِيفِ أَنْ يَرَى شَيْئًا مِنْ الدُّنْيَا لِنَفْسِهِ خَطِيرًا" )
( clartts_1938 "مَنْ عَرَفَ أَنَّ مَا يَعْلَمُ فِيمَا لَا يَعْلَمُ قَلِيلٌ" )
( clartts_1939 "فَيَصِيرُ الْأَمَلُ خَيْبَةً وَالرَّجَاءُ إيَاسًا" )
( clartts_1940 "يَصِحُّ وَلَا رَأْيٌ يَتَّضِحُ مَعَ مَا يُغَيِّرُهُاللَّيْلُ وَالنَّهَارُ" )
( clartts_1941 "أوْ عَلَى طَلَبِهَا مُكِبٌّ وَقَدْ قَالَ الشَّاعِرُ حُبُّ الرِّئَاسَةِ" )
( clartts_1942 "مِنْهَا بِمَا يُنَبِّئُ عَنْ لُزُومِهِ يَجِبُ أَنْ يَكُونَ الْكَلَامُ لِدَاعٍ" )
( clartts_1943 "بَاعَ دَارًا بِثَمَانِينَ أَلْفَ دِرْهَم" )
( clartts_1944 "أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَخَلَ الْمَسْجِدَ فَإِذَا هُوَ بِمَجْلِسَيْنِ" )
( clartts_1945 "فَيَذِلَّ بِالضَّرَعِ وَيُحْرَمَ بِالْأُبَّهَةِ" )
( clartts_1946 "وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1947 "فَدَعْ الْحَاجَةَ تَخْتَمِرُ بِالْوَعْدِ لِيَكُونَ لَهَا" )
( clartts_1948 "وَأَمَّا اللَّهْبَرَةُ فَالطَّوِيلَةُ الْمَهْزُولَةُ وَأَمَّا النَّهْبَرَةُ" )
( clartts_1949 "وَلَا تَعْمَلُونَ لِلْآخِرَةِ وَأَنْتُمْ لَا تُرْزَقُونَ فِيهَا إلَّا بِعَمَلٍ" )
( clartts_1950 "وَأَوَاسِطْ فَالْفُقَرَاءُ مَوْتَى إلَّا مَنْ أَغْنَاهُ اللَّهُ" )
( clartts_1951 "لِأَنَّ أَدَاءَ الْوَاجِبِ يُسْقِطُ عَنْهُ الْعِقَابَ" )
( clartts_1952 "فِي الْأُدَبَاءِ فَضْلًا عَنْ أَنْ يَكُونَ فِي عِدَادِ الْبُلَغَاءُ" )
( clartts_1953 "لَا تَيْأَسَنَّ وَإِنْ طَالَتْ مُطَالَبَةٌ إذَا اسْتَعَنْتَ بِصَبْرٍ أَنْ تَرَى فَرَجَا" )
( clartts_1954 "وَقَدْ انْصَرَفَتْ عُيُونُهُمْ عَنْ حِرْمَانِ أَكْثَرِ النَّوْكَى" )
( clartts_1955 "تِبَاعَةً عَلَى أَهْلِهَا وَالْمُقْتِرُونَ" )
( clartts_1956 "وَأَمَّا الْمُسَامَحَةُ فِي الْأَحوَالِ مُسَامَحَةُ إسْقَاطٍ" )
( clartts_1957 "فَيَغْفُلُ عَنْ قَدْرِ النِّعْمَةِ بِالْأَمْنِ فِيمَا سِوَاهُ" )
( clartts_1958 "وَكُلُّ مَنْ أَخْطَأَتْهُ فِي مَوْلِدِهِ" )
( clartts_1959 "الْخَفِيُّ وَقَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ كَرَّمَ اللَّهُ وَجْهَهُ" )
( clartts_1960 "فلَا تَعُدُّوهُ فَجَعَلَ الْإِسْلَامَ شرَّةً" )
( clartts_1961 "وَتَرَى اللَّئِيمَ مُجَانِبَ الْإِنْصَافِ وَالْعَاشِرُ مِنْ أَسْبَابِهِ" )
( clartts_1962 "أَنْ لَا تُضَيِّعَ صِحَّةَ جِسْمِك وَفَرَاغَ وَقْتِك بِالتَّقْصِيرِ فِي طَاعَةِ رَبِّك" )
( clartts_1963 "لَا سِيَّمَا إذَا لَمْ يَجْلِبْ نَفْعًا وَلَمْ يَدْفَعْ ضَرَرًا" )
( clartts_1964 "الاسْتِكْثَارِ بِلَا دَوامٍ تَقْصِيرٍ وَهِيَ الْحَالَةُ الثَّانِيَةِ" )
( clartts_1965 "كِتْمَان السِّرّ اعْلَمْ أَنَّ كِتْمَانَ الْأَسْرَارِ مِنْ أَقْوَى أَسْبَابِ" )
( clartts_1966 "الْأَدَبُ أَدَبَانِ وَقَالَ بَعْضُ الْحُكَمَاءِ" )
( clartts_1967 "أَدَبُ الْعَالِمِ مَعَ السُّلْطَان وَرُبَّمَا كَانَ لِبَعْضِ السَّلَاطِينِ رَغْبَةٌ فِي الْعِلْمِ" )
( clartts_1968 "حَيْثُ نَزَلَتْ بِهِ أَحْوَالُهُ إلَيْهِ وَاسْتَقَرَّتْ خِصَالُهُ" )
( clartts_1969 "كَانَ صَاحِبَ سُمْعَةٍ وَرِيَاءٍ وَفِي هَذَيْنِ مِنْ الذَّمِّ مَا يُنَافِي السَّخَاءَ" )
( clartts_1970 "فِيمَا لَيْسَ يَعْلَمُ وَرُوِيَ أَنَّ رَجُلًا قَالَ يَا رَسُولَ اللَّهِ" )
( clartts_1971 "وَمَا جَعَلْنَاهُمْ جَسَدًا لَا يَأْكُلُونَ الطَّعَامَ" )
( clartts_1972 "مَا وَصَفْنَا مِنْ اخْتِبَارِهِ وَاخْتِبَارِ الْخِصَالِ الْأَرْبَعِ فِيهِ" )
( clartts_1973 "مَسْلُوبَ الْعَزَاءِ قَلِيلَ الْحِيلَةِ مَعَ مَا يَنَالُهُ مِنْ أَثَرِ ذَلِكَ فِي نَفْسِهِ وَجَسَدِهِ حَتَّى يَصِيرَ" )
( clartts_1974 "كَذَاك يُعَادِي الْعِلْمَ مَنْ هُوَ جَاهِلُهْ" )
( clartts_1975 "لَوْ تَكَاشَفْتُمْ مَا تَدَافَنْتُمْ وَكَتَبَ رَجُلٌ إلَى أَبِي الْعَتَاهِيَةِ رَحِمَهُ اللَّه" )
( clartts_1976 "وَمِنَحُهُ عَلَيْهِ أَظْهَرَ وَهَذَا النَّوْعُ مِنْ الْحَسَدِ" )
( clartts_1977 "لَا يَجِبُ إنْكَارُهُ وَالْأَوْلَى بِالْإِنْسَانِ أَنْ يَكُونَ كَافًّا مُمْسِكًا وَمُلَازِمًا لِبَيْتِهِ" )
( clartts_1978 "وَكُلُّ سَفِيهٍ طَائِشٍ ُإنْ فَقَدْته وَجَدْتَ لَهُ فِي كُلِّ نَاحِيَةٍ" )
( clartts_1979 "غَيْرَ مُقَلِّ وَلَا مُكْثِر فَإِنَّ تَقْلِيلَ الزِّيَارَةِ" )
( clartts_1980 "ذَا وَجْهَيْنِ وَذَا لِسَانَيْنِ وَذَا قَوْلَيْنِ مُخْتَلِفَيْنِ" )
( clartts_1981 "فِيمَا أَمَرَنَا بِهِ فَهَلْ يَجِدُ الْعَاقِلُ فِي رَوِيَّتِهِ مَسَاغً" )
( clartts_1982 "كَاصْطِلَاحِهِمْ عَلَى مُوَاضَعَاتِ الْخِطَابِ وَاتِّفَاقِهِمْ عَلَى هَيْئَاتِ اللِّبَاسِ" )
( clartts_1983 "تَقَبَّلُوا إلَيَّ بِسِتٍّ أَتَقَبَّلُ إلَيْكُمْ بِالْجَنَّةِ" )
( clartts_1984 "لَنَا كُلَّ يَوْمٍ نَوْبَةٌ نَوْبَةٌ قَدْ نَنُوبُهَا" )
( clartts_1985 "مِنْ الرَّشَادِ حَقِيقًا بِالضَّلَالِ وَقَدْ قَالَ الْحَسَنُ الْبَصْرِيُّ رَحِمَهُ اللَّهُ تَعَالَى" )
( clartts_1986 "شِيرَوَيْهِ إنَّ كَلِمَةً مِنْك تَسْفِكُ دَمًا" )
( clartts_1987 "مَنْ اتَّقَى اللَّهَ اتَّقَى النَّاسَ أَتَى الْجُمُعَةَ" )
( clartts_1988 "فَلْيُوقِدْ نَارَيْنِ وَلْيَنْظُرْ هَلْ تُطْفِئُ إحْدَاهُمَا الْأُخْرَى" )
( clartts_1989 "لِمَا عَلِمَهُ مِنْ نَوَازِعِ الشَّهْوَةِ وَتَرْكِيبِ الْفِطْرَةِ" )
( clartts_1990 "وَضَعْفِ دِيَانَاتِهِمْ وَقَدْ وُجِدَ ذَلِكَ فِي مَشَاهِدِ الْحَالِ تَجْرِبَةً وَعُرْفًا" )
( clartts_1991 "وَأُمُورُهَا مُلْتَئِمَةً سِتَّةُ أَشْيَاءَ هِيَ قَوَاعِدُهَا" )
( clartts_1992 "فَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_1993 "وَمِنْهُ قَوْلُهُمْ فِي الْقُنُوتِ وَإِلَيْك نَسْعَى وَنَحْفِدُ" )
( clartts_1994 "فَإِنَّ اطِّرَاحَ مُرَاعَاتِهَا وَتَرْكَ تَفَقُّدِهَا مَهَانَةٌ" )
( clartts_1995 "فَإِنَّهُ قَلَّ مَا اجْتَمَعَتْ هَاتَانِ النِّعْمَتَانِ" )
( clartts_1996 "فَقَدْ تَعْرِضُ لَهُ عَوَارِضُ تَمْنَعُ مِنْهَا" )
( clartts_1997 "مُمْضٍ إنْ أَمْسَكَ عَنْهُ أَحْزَنَ قَلْبَهُ وَإِنْ قَابَلَ عَلَيْهِ جَانَبَ أَدَبَهُ" )
( clartts_1998 "وَلَا تَجْعَلْ سَعْيَك لَهَا فَتَمْنَعَك حَظَّك مِنْهَا" )
( clartts_1999 "يَعْنِي الْمَالَ فَكَاتِبُوهُمْ إنْ عَلِمْتُمْ فِيهِمْ خَيْرًا" )
( clartts_2000 "وَإِنْ تَوَسَّطَ وَاقْتَصَدَ فِيهِ كَانَ مَعْرُوفًا" )
( clartts_2001 "وَأَعْطِفُ عَلَيْهِمْ وَأَحَثُّ عَلَى الرَّغْبَةِ فِيمَا لَدَيْهِمْ" )
( clartts_2002 "لِأَنَّهُمْ الطُّرُقُ إلَيْهِ إنَّمَا زَالَ عَنْهُ التَّلْبِيسُ" )
( clartts_2003 "مَنْ لَا يَجْزِيهِ مِنْ الْعَيْشِ مَا يَكْفِيهِ لَمْ يَجِدْ مَا عَاشَ مَا يُغْنِيهِ" )
( clartts_2004 "لِابْنِهِ يَا بُنَيَّ كُنْ جَوَادًا بِالْمَالِ" )
( clartts_2005 "هُوَ نِتَاجُ الْحَيَوَانِ فَهُوَ مَادَّةُ أَهْلِ الْفَلَوَاتِ" )
( clartts_2006 "فَاذْهَبْ فَأَنْتَ طَلِيقُ عِرْضِكَ إنَّهُ عِرْضٌ" )
( clartts_2007 "فَلَمْ يَجِدُوهَا فَقَالَ وَاَللَّهِ إنْ لَمْ يَرُدَّ إلَيَّ" )
( clartts_2008 "وَالْمُرَائِيَ بِهِ مَحْقُورٌ لَا يَرْتَفِعُ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_2009 "نَفْعٌ عَلَى فَاعِلِهَا فِي اكْتِسَابِ الْأَجْرِ وَجَمِيلِ الذِّكْرِ" )
( clartts_2010 "حَتَّى يَرَاهُ بَعْدَ طُولِ سُرُورِهِ بِمَكَانِهِ" )
( clartts_2011 "فَحُسْنُ الظَّنِّ بِهَا ذَرِيعَةٌ إلَى تَحْكِيمِهَا" )
( clartts_2012 "وَقَدْ خَفَّفَ صَلَاتَهُ مَرَّةً فَقَالَ بَعْضُ أَهْلِ الْمَسْجِدِ" )
( clartts_2013 "إذَا أَحْسَنْت الْقَوْلَ فَأَحْسِنْ الْفِعْلَ لِيَجْتَمِعَ لَك" )
( clartts_2014 "وَلَمْ أَحْقِدْ عَلَى أَحَدٍ أَرَحْتُ نَفْسِي مِنْ هَمِّ الْعَدَاوَاتِ" )
( clartts_2015 "فَلِأَنَّهُ يَصْرِفُ النُّفُوسَ عَنْ شَهَوَاتِهَا وَيَعْطِفُ الْقُلُوبَ عَنْ إرَادَتِهَا" )
( clartts_2016 "وَخِيَارُ عُلَمَائِهَا فُقَهَاؤُهَا وَرَوَى مُعَاذُ بْنُ رِفَاعَةَ" )
( clartts_2017 "وَيُكْسِبَانِ الرَّذَائِلَ وَلَيْسَ لِمَنْ اسْتَوْلَيَا عَلَيْهِ" )
( clartts_2018 "الْمُؤَمَّلُ بْنُ أُمَيْلٍ لَا تَحْسَبُونِي غَنِيًّا" )
( clartts_2019 "بِإِبَانَةِ مَا يُكْسِبَانِهِ مِنْ ذَمٍّ" )
( clartts_2020 "لَمْ يَقْلُ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_2021 "وَأَخُو الْحَوَائِجِ وَجْهُهُ مَمْلُولُ" )
( clartts_2022 "هَلْ وَجَبَ عَلَيْهِمْ بِالْعَقْلِ أَوْ بِالشَّرْعِ الْأَمْرُ بِالْمَعْرُوفِ وَاجِبٌ عَقْلاً" )
( clartts_2023 "دَانِي النُّزُوعِ مَعَاذَ اللَّهِ أَنْ نَلْقَى غِضَابًا" )
( clartts_2024 "وَذَكَرَ خَالِدُ بْنُ صَفْوَانَ الْمِزَاحَ فَقَالَ" )
( clartts_2025 "وَيُعْذَلُ فِي الْإِحْسَانِ وَهُوَ مُصِيبُ فَإِذَا" )
( clartts_2026 "وَلَا الْمَجْدُ فِي كَفِّ امْرِئٍ وَالدَّرَاهِمُ" )
( clartts_2027 "وَنَبْرَأَ مِنْ عُيُوبِ التَّقْصِيرِ وَإِنْ كَانَ الْيَسِيرُ مَغْفُورًا" )
( clartts_2028 "جَارِيًا عَلَى عَادَةِ عَصْرِك مُنْقَادًا لِمَنْ قَدَّمَهُ النَّاسُ عَلَيْك" )
( clartts_2029 "اعْلَمْ أَنَّ مَا بِهِ تَصْلُحُ الدُّنْيَا حَتَّى تَصِيرَ أَحْوَالُهَا مُنْتَظِمَةً" )
( clartts_2030 "حُسْنُ بِزَّتِهِ وَهَلْ يَرُوقُ دَفِينًا" )
( clartts_2031 "لَا تَعَلَّمُوا الْعِلْمَ لِتُمَارُوا بِهِ السُّفَهَاءَ" )
( clartts_2032 "حَتَّى اُبْتُلِيتُ فَكُنْتُ الْوَاثِقَ الْخَجِلَ" )
( clartts_2033 "وَهُوَ السَّبَبُ الرَّابِعُ أَنْ يَجْمَعَ الْمَالَ وَيَطْلُبَهُ" )
( clartts_2034 "فَقَالَ مَنْ تَعَلَّمَ الْقُرْآنَ عَظُمَتْ" )
( clartts_2035 "فَصَارَ الظَّاهِرُ مِنْ مَدْحِهِ كَذِبًا وَالْبَاطِنُ مِنْ ذَمِّهِ" )
( clartts_2036 "وَقَالَ بَعْضُ الْحُكَمَاءِ مَنْ ذَكَرَ الْمَنِيَّةَ نَسِيَ الْأُمْنِيَّةَ" )
( clartts_2037 "وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_2038 "يَعْنِي أَنَّهُ عَامِلٌ بِمَا عَلِمَ وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_2039 "أَوْ سُدًى يَعْتَمِدُونَ عَلَى آرَائِهِمْ الْمُخْتَلِفَةِ" )
( clartts_2040 "فِي وُجُوهِ الْمَصَالِحِ السُّلْطَان الْقَوِيّ يَمْنَع ذَوِي الْأَهْوَاءِ" )
( clartts_2041 "فَإِنْ ضَاقَتْ بِهِ الْحَالُ عَنْ الِاصْطِنَاعِ بِمَالِهِ" )
( clartts_2042 "وَقَالَ بَعْضُ الْحُكَمَاءِ مَنْ حَسُنَ ظَنُّهُ" )
( clartts_2043 "الْآمِرُ بِصَوَابِ التَّدْبِيرِ فَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_2044 "إلَّا غَرَائِزَا وَقَالَ أَبُو مَسْعُودٍ كَاتِبُ الرَّضِيِّ" )
( clartts_2045 "قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَلِيلُ الْعِلْمِ خَيْرٌ مِنْ كَثِيرِ الْعِبَادَةِ" )
( clartts_2046 "يَعْنِي مَالًا وَقَالَ شُعَيْبٌ إنِّي أَرَاكُمْ بِخَيْرٍ" )
( clartts_2047 "وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_2048 "فَيُسَدِّدُهَا بِرَأْيِهِ وَرَجُلٌ يُشَاوِرُ فِيمَا أَشْكَلَ عَلَيْهِ" )
( clartts_2049 "اعْلَمْ أَنَّ الْعِلْمَ أَشْرَفُ مَا رَغَّبَ فِيهِ الرَّاغِبُ" )
( clartts_2050 "فَلَا تَقْتَنِ مَا بِهِ تَهْتَمُّ" )
( clartts_2051 "لَكِنَّ سَيِّدَ قَوْمِهِ الْمُتَغَابِي وَقَالَ أَبُو الْعَتَاهِيَةِ" )
( clartts_2052 "نِهَايَةٌ الْمُقْطَع" )
( clartts_2053 "وَذُلِّ السُّؤَالِ وَلَوْ اسْتَقْبَحَ الْعَارَ وَأَنِفَ مِنْ الذُّلِّ لَوَجَدَ غَيْرَ السُّؤَالِ مُكْتَسِبًا" )
( clartts_2054 "فَإِذَا تَوَاتَرَ الْفَضْلُ عَلَيْهِ صَارَ النَّقْصُ فِيمَا سِوَاهُ" )
( clartts_2055 "أَنَفَةً مِنْ اسْتِعْلَاءِ الْأَبَعَادِ عَلَى الْأَقَارِبِ وَقَدْ رُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_2056 "دَنَاءَةٌ وَنَقْصٌ وَرُبَّمَا تَوَهَّمَ بَعْضُ مَنْ" )
( clartts_2057 "وَقَالَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ اتَّقُوا الْمِزَاحَ" )
( clartts_2058 "وَقَالَ شَيْخٌ مِنْ بَنِي سُلَيْمٍ لِابْنِهِ يَا بُنَيَّ إيَّاكَ وَالرَّقُوبَ الْغَضُوبَ الْقَطُوبَ" )
( clartts_2059 "فَهِيَ الْمَادَّةُ الْكَافِيَةُ لِأَنَّ حَاجَةَ الْإِنْسَانِ لَازِمَةٌ" )
( clartts_2060 "فَصَارَ مَا احْتَجْنَاهُ وِزْرًا عَلَيْهِمَا وَعِقَابًا لَهُمَا" )
( clartts_2061 "فَهُوَ يَعْلَمُ مِنْ بُعْدِ غَايَتِهِ وَالْعَجْزِ عَنْ إدْرَاكِ نِهَايَتِهِ" )
( clartts_2062 "وَمِثْلُ هَذَا الْقَوْلِ الْمَرْوِيِّ عَنْ أَبِي بَكْرٍ رَضِيَ اللَّهُ عَنْهُ" )
( clartts_2063 "وَكَفَاك مَكْرُوهَ السُّؤَالِ البَذْلِ يَكُونُ لِأَسْبَاب" )
( clartts_2064 "الْعَمَلُ أَوَّى بِكِ مِنَ الأمَلِ وَقَالَ بَعْضُ الْبُلَغَاءِ" )
( clartts_2065 "مَنْ كَثُرَ إِخِوَانُهُ كَثُرَ غُرَمَاؤُهُ" )
( clartts_2066 "قِيلَ تَأْوِيلُهُ قِلَّةُ الِاسْتِرْسَالِ إلَيْهِمْ" )
( clartts_2067 "وَهَذَا أَعْلَى مَرَاتِبِ الْأُلْفَةِ وَلِذَلِكَ آخَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَصْحَابِهِ" )
( clartts_2068 "وَاعْلَمْ أَنَّك لَنْ تَسْتَطِيعَ أَنْ تَسَعَ جَمِيعَ النَّاسِ" )
( clartts_2069 "إمَّا أَنَفَةً مِنْ ذُلِّ الِاسْتِكَانَةِ" )
( clartts_2070 "رُدُّوا أَبْصَارَكُمْ عَلَيْكُمْ فَإِنَّ لَكُمْ فِيهَا شُغْلًا" )
( clartts_2071 "وَعَنْ شَتْمِ ذِي الْقُرْبَى خَلَائِقُ أَرْبَعُ حَيَاءٌ وَإِسْلَامٌ وَتَقْوَى وَطَاعَةٌ" )
( clartts_2072 "مَا عَمَرْت فِي السَّاعَةِ الَّتِي أَنْتَ فِيهَا قَنِعَ النَّفْسَ بِالْكَفَافِ وَإِلَّا طَلَبَتْ مِنْك فَوْقَ مَا يَكْفِيهَا" )
( clartts_2073 "وَأَنْشَدَ وَلَئِنْ تُصِبْكَ مُصِيبَةٌ" )
( clartts_2074 "إنْ تَرَكْتَ قَضَاءَ حَقِّي إلَى وَقْتِ التَّفَرُّغِ وَالتَّخَلِّي" )
( clartts_2075 "أَنْ تَكُونَ عَلَانِيَتُهُ أَحْسَنَ مِنْ سَرِيرَتِهِ" )
( clartts_2076 "عَادَاتٌ فِي اللِّبَاسِ وَإِنَّمَا اخْتَلَفَتْ عَادَاتُ النَّاسِ فِي اللِّبَاسِ مِنْ هَذَيْنِ الْوَجْهَيْنِ" )
( clartts_2077 "مَا عَالَ مَنْ اقْتَصَدَ وَقَدْ قَالَ الْمَأْمُونُ" )
( clartts_2078 "إذَا جَالَسْت الْجُهَّالَ فَأَنْصِتْ لَهُمْ وَإِذَا جَالَسْت الْعُلَمَاءَ فَأَنْصِتْ لَهُمْ" )
( clartts_2079 "يَا صَيَّادُ احْذَرْ أَنْ تُصَادَ وَقَالَ سُلَيْمَانُ بْنُ دَاوُد عَلَيْهِمَا السَّلَامُ لِابْنِهِ" )
( clartts_2080 "وَمَعْنَى قَوْلِهِ قَوْلِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ" )
( clartts_2081 "حَتَّى إنَّ الْإِنْسَانَ الْآنَ إذَا تَجَاوَزَ مَا اتَّفَقُوا عَلَيْهِ مِنْهَا" )
( clartts_2082 "مُوجِبٌ لِأُصُولِهِ وَالثَّانِي مَا تَكُونُ الْمُوَاضَعَةُ" )
( clartts_2083 "خَلَّتَيْنِ نَاقِصَتَيْنِ وَأَفْعَالُ الْخَيْرِ تَتَوَسَّطُ بَيْنَ رَذِيلَتَيْنِ" )
( clartts_2084 "بِلَذَّةِ سَاعَةٍ أَكَلَاتِ دَهْرِ" )
( clartts_2085 "قَالُوا بَلَى يَا رَسُولَ اللَّهِ قَالَ مَنْ أَكَلَ وَحْدَهُ" )
( clartts_2086 "وَاللَّئِيمَ مُعَانِدٌ الْمَخْذُولُ مَنْ كَانَتْ لَهُ إلَى اللِّئَامِ حَاجَةٌ" )
( clartts_2087 "إِعْجَابِ الْعُلَمَاءِ بِأَنْفُسِهِمْ وَعِلَّةُ إعْجَابِهِمْ انْصِرَافُ نَظَرِهِمْ إلَى كَثْرَةِ مَنْ دُونَهُمْ مِنْ الْجُهَّالِ" )
( clartts_2088 "وَهِيَ ثَلَاثٌ إحْدَاهُنَّ كَرَمُ الطَّبْعِ فَإِنَّ الْكَرِيمَ مُسَاعِدٌ" )
( clartts_2089 "وَرُوِيَ عَنْ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ" )
( clartts_2090 "وَكَسْبْ فَأَمَّا الْمَادَّةُ فَهِيَ حَادِثَةٌ عَنْ اقْتِنَاءِ أُصُولٍ نَامِيَةٍ بِذَوَاتِهَا" )
( clartts_2091 "وَشَيْئًا هو لِغَيْرِي وَذَلِكَ مِمَّا لَمْ أَنَلْهُ" )
( clartts_2092 "وَقَدْ قَالَ بَعْضُ الْأُدَبَاءِ بِالْإِحْسَانِ يَرْتَبِطُ الْإِنْسَانُ" )
( clartts_2093 "عَجِبْت لِمَنْ قِيلَ فِيهِ الْخَيْرُ وَلَيْسَ فِيهِ" )
( clartts_2094 "وَهَذَا لَعَمْرِي أَشْبَهُ الْمَوَاهِبِ بِالسَّلَامِة" )
( clartts_2095 "وَنَصِيبٌ مِنْ الْحَزَنِ وَقَدْ يَخْتَلِفُ بِاخْتِلَافِ أَسْبَابِهِ" )
( clartts_2096 "كَانَ أَوَّلُ مَا يُهْلِكُهُ رَأْيَهُ وَقَالَ عَلِيُّ بْنُ أَبِي طَالِبٍ" )
( clartts_2097 "فَانْتَهَوْا إلَى رَاهِبٍ فَقَالُوا قَدْ ضَلَلْنَا فَكَيْفَ الطَّرِيقُ" )
( clartts_2098 "وَلْيَكُنْ مِنْ التَّجَمُّلِ عَلَى مَا يَقْتَضِيهِ حَالُ مِثْلِهِ مِنْ ذَوِي الْحَاجَاتِ" )
( clartts_2099 "فَإِذَا كَانَ سُوءُ الْخُلُقِ حَادِثًا بِسَبَبٍ كَانَ زَوَالُهُ مَقْرُونًا بِزَوَالِ ذَلِكَ السَّبَبِ" )
